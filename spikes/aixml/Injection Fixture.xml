<VI _name="Injection Fixture.vi" description="Input-injection spike fixture. A plain interactive panel - Switch (switch when pressed)\2C Slide (0..10)\2C Number\2C Text and a latched Stop button - kept alive by a 20 ms While Loop until Stop is pressed. Spike Input Injection.vi drives it with posted Win32 window messages and reads the control values back through VI Server.">
  <Control _name="Switch" type="bool" uid="sw" uid_parent="loop" value="false" outputs="value:" description="Toggled by a posted click." />
  <Control _name="Slide" type="double" uid="sl" uid_parent="loop" value="5" outputs="value:" description="Dragged by posted down/move/up messages." />
  <Control _name="Number" type="double" uid="nu" uid_parent="loop" value="0" outputs="value:" description="Edited by a posted click plus WM_KEYDOWN/WM_CHAR." />
  <Control _name="Text" type="string" uid="tx" uid_parent="loop" value="" outputs="value:" description="Edited by a posted click plus WM_CHAR." />
  <Structure _name="While Loop" count="" uid="loop" uid_parent="root" label="Run until Stop">
    <Control _name="Stop" type="bool" style="latched" uid="stop" uid_parent="loop" value="false" outputs="value:stop.value" description="Latched button that ends the loop." />
    <Constant _name="loop period ms" type="uint32" uid="ms" uid_parent="loop" value="20" outputs="value:ms.value" />
    <Node _name="Wait (ms)" uid="wait" uid_parent="loop" inputs="milliseconds to wait:ms.value" outputs="millisecond timer value:" />
    <Condition uid="cond" uid_parent="loop" value="stop" inputs="value:stop.value" />
  </Structure>
  <FreeLabel comment="Panel stays interactive until Stop" uid="c1" uid_parent="root" />
</VI>
