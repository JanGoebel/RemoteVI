<VI _name="Spike Click.vi" description="Posts a left click at panel-image pixel (Panel X\2C Panel Y) of VI: WM_MOUSEMOVE\2C WM_LBUTTONDOWN (MK_LBUTTON)\2C WM_LBUTTONUP\2C each followed by Delay ms. An error skips the remaining messages.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The VI whose front panel is clicked." />
  <Control _name="Panel X" type="int32" uid="px" uid_parent="root" value="0" conIdx="5" connection="required" outputs="value:px.value" description="X in panel-image pixels." />
  <Control _name="Panel Y" type="int32" uid="py" uid_parent="root" value="0" conIdx="7" connection="required" outputs="value:py.value" description="Y in panel-image pixels." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="50" conIdx="9" connection="recommended" outputs="value:dl.value" description="Wait after each message." />
  <Control _name="Screen lParam For Up" type="bool" uid="scr" uid_parent="root" value="false" conIdx="1" connection="optional" outputs="value:scr.value" description="Diagnostic: the button-up carries the SCREEN point in lParam." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:up.error out" description="Standard error out." />
  <Constant _name="WM_MOUSEMOVE" type="uint32" uid="mm" uid_parent="root" value="512" outputs="value:mm.value" />
  <Constant _name="WM_LBUTTONDOWN" type="uint32" uid="md" uid_parent="root" value="513" outputs="value:md.value" />
  <Constant _name="WM_LBUTTONUP" type="uint32" uid="mu" uid_parent="root" value="514" outputs="value:mu.value" />
  <Constant _name="no buttons" type="uint64" uid="w0" uid_parent="root" value="0" outputs="value:w0.value" />
  <Constant _name="MK_LBUTTON" type="uint64" uid="w1" uid_parent="root" value="1" outputs="value:w1.value" />
  <Call uid="mv" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:px.value,Panel Y:py.value,Msg:mm.value,wParam:w0.value,Delay ms:dl.value,error in:ei.value" outputs="lParam:,return value:,error out:mv.error out" />
  <Call uid="dn" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:px.value,Panel Y:py.value,Msg:md.value,wParam:w1.value,Delay ms:dl.value,error in:mv.error out" outputs="lParam:,return value:,error out:dn.error out" />
  <Call uid="up" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:px.value,Panel Y:py.value,Msg:mu.value,wParam:w0.value,Delay ms:dl.value,Screen lParam:scr.value,error in:dn.error out" outputs="lParam:,return value:,error out:up.error out" />
  <FreeLabel comment="Move\2C press and release at one point" uid="c1" uid_parent="root" />
</VI>
