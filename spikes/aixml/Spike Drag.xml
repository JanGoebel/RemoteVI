<VI _name="Spike Drag.vi" description="Posts a left-button drag on the front panel of VI from panel-image pixel (From X\2C From Y) to (To X\2C To Y): WM_MOUSEMOVE and WM_LBUTTONDOWN at the start\2C Steps evenly spaced WM_MOUSEMOVE with MK_LBUTTON\2C then WM_LBUTTONUP at the end\2C each followed by Delay ms. An error skips the remaining messages.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The VI whose front panel is dragged on." />
  <Control _name="From X" type="int32" uid="fx" uid_parent="root" value="0" conIdx="5" connection="required" outputs="value:fx.value" description="Start X in panel-image pixels." />
  <Control _name="From Y" type="int32" uid="fy" uid_parent="root" value="0" conIdx="7" connection="required" outputs="value:fy.value" description="Start Y in panel-image pixels." />
  <Control _name="To X" type="int32" uid="tx" uid_parent="root" value="0" conIdx="9" connection="required" outputs="value:tx.value" description="End X in panel-image pixels." />
  <Control _name="To Y" type="int32" uid="ty" uid_parent="root" value="0" conIdx="1" connection="required" outputs="value:ty.value" description="End Y in panel-image pixels." />
  <Control _name="Steps" type="int32" uid="n" uid_parent="root" value="5" conIdx="2" connection="recommended" outputs="value:n.value" description="Number of intermediate WM_MOUSEMOVE messages." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="50" conIdx="3" connection="recommended" outputs="value:dl.value" description="Wait after each message." />
  <Control _name="Screen lParam For Moves" type="bool" uid="scr" uid_parent="root" value="false" conIdx="12" connection="optional" outputs="value:scr.value" description="Diagnostic: the moves and the button-up carry the SCREEN point in lParam." />
  <Control _name="Screen lParam For Down" type="bool" uid="scd" uid_parent="root" value="false" conIdx="13" connection="optional" outputs="value:scd.value" description="Diagnostic: the first move and the button-down carry the SCREEN point in lParam." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:up.error out" description="Standard error out." />
  <Constant _name="WM_MOUSEMOVE" type="uint32" uid="mm" uid_parent="root" value="512" outputs="value:mm.value" />
  <Constant _name="WM_LBUTTONDOWN" type="uint32" uid="md" uid_parent="root" value="513" outputs="value:md.value" />
  <Constant _name="WM_LBUTTONUP" type="uint32" uid="mu" uid_parent="root" value="514" outputs="value:mu.value" />
  <Constant _name="no buttons" type="uint64" uid="w0" uid_parent="root" value="0" outputs="value:w0.value" />
  <Constant _name="MK_LBUTTON" type="uint64" uid="w1" uid_parent="root" value="1" outputs="value:w1.value" />
  <Node _name="Subtract" uid="ddx" uid_parent="root" inputs="x:tx.value,y:fx.value" outputs="x-y:ddx.x-y" />
  <Node _name="Subtract" uid="ddy" uid_parent="root" inputs="x:ty.value,y:fy.value" outputs="x-y:ddy.x-y" />
  <Call uid="mv" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:fx.value,Panel Y:fy.value,Msg:mm.value,wParam:w0.value,Delay ms:dl.value,Screen lParam:scd.value,error in:ei.value" outputs="lParam:,return value:,error out:mv.error out" />
  <Call uid="dn" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:fx.value,Panel Y:fy.value,Msg:md.value,wParam:w1.value,Delay ms:dl.value,Screen lParam:scd.value,error in:mv.error out" outputs="lParam:,return value:,error out:dn.error out" />
  <Structure _name="For Loop" uid="fl" uid_parent="root" count="fl.value" maxin="n.value" maxout="" label="Intermediate moves with the button held">
    <Tunnel _id="In1" uid="tvi" uid_parent="fl" inputs="value:vi.value" outputs="value:tvi.value" />
    <Tunnel _id="In2" uid="tdx" uid_parent="fl" inputs="value:ddx.x-y" outputs="value:tdx.value" />
    <Tunnel _id="In3" uid="tdy" uid_parent="fl" inputs="value:ddy.x-y" outputs="value:tdy.value" />
    <Tunnel _id="In4" uid="tfx" uid_parent="fl" inputs="value:fx.value" outputs="value:tfx.value" />
    <Tunnel _id="In5" uid="tfy" uid_parent="fl" inputs="value:fy.value" outputs="value:tfy.value" />
    <Tunnel _id="In6" uid="tn" uid_parent="fl" inputs="value:n.value" outputs="value:tn.value" />
    <Tunnel _id="In7" uid="tmm" uid_parent="fl" inputs="value:mm.value" outputs="value:tmm.value" />
    <Tunnel _id="In8" uid="tw1" uid_parent="fl" inputs="value:w1.value" outputs="value:tw1.value" />
    <Tunnel _id="In9" uid="tdl" uid_parent="fl" inputs="value:dl.value" outputs="value:tdl.value" />
    <Tunnel _id="In10" uid="tsc" uid_parent="fl" inputs="value:scr.value" outputs="value:tsc.value" />
    <Node _name="Increment" uid="inc" uid_parent="fl" inputs="x:fl.value" outputs="x+1:inc.x+1" />
    <Node _name="Multiply" uid="mx" uid_parent="fl" inputs="x:tdx.value,y:inc.x+1" outputs="x*y:mx.x*y" />
    <Node _name="Multiply" uid="my" uid_parent="fl" inputs="x:tdy.value,y:inc.x+1" outputs="x*y:my.x*y" />
    <Node _name="Quotient &amp; Remainder" uid="qx" uid_parent="fl" inputs="x:mx.x*y,y:tn.value" outputs="x-y*floor(x/y):,floor(x/y):qx.floor(x/y)" />
    <Node _name="Quotient &amp; Remainder" uid="qy" uid_parent="fl" inputs="x:my.x*y,y:tn.value" outputs="x-y*floor(x/y):,floor(x/y):qy.floor(x/y)" />
    <Node _name="Add" uid="ax" uid_parent="fl" inputs="x:tfx.value,y:qx.floor(x/y)" outputs="x+y:ax.x+y" />
    <Node _name="Add" uid="ay" uid_parent="fl" inputs="x:tfy.value,y:qy.floor(x/y)" outputs="x+y:ay.x+y" />
    <Call uid="mi" uid_parent="fl" target="Spike Post Input.vi" inputs="VI:tvi.value,Panel X:ax.x+y,Panel Y:ay.x+y,Msg:tmm.value,wParam:tw1.value,Delay ms:tdl.value,Screen lParam:tsc.value,error in:sl.value" outputs="lParam:,return value:,error out:mi.error out" />
    <ShiftReg uid="sh" uid_parent="fl">
      <Left uid="sl" uid_parent="sh" inputs="value:dn.error out" outputs="value:sl.value" />
      <Right uid="sr" uid_parent="sh" inputs="value:mi.error out" outputs="value:sr.value" />
    </ShiftReg>
  </Structure>
  <Call uid="up" uid_parent="root" target="Spike Post Input.vi" inputs="VI:vi.value,Panel X:tx.value,Panel Y:ty.value,Msg:mu.value,wParam:w0.value,Delay ms:dl.value,Screen lParam:scr.value,error in:sr.value" outputs="lParam:,return value:,error out:up.error out" />
  <FreeLabel comment="Press\2C move in steps\2C release" uid="c1" uid_parent="root" />
</VI>
