<VI _name="Spike Find Control.vi" description="Finds the front-panel control of VI whose label is Label and returns its reference and its body rectangle in PANEL-IMAGE pixels: Position (pane coordinates) minus Front Panel Window\3AOrigin\2C plus Bounds width and height. The raw pane position and the origin are returned too\2C to check the mapping. Found is false when no control carries the label.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The VI whose panel is searched." />
  <Control _name="Label" type="string" uid="lb" uid_parent="root" value="" conIdx="5" connection="required" outputs="value:lb.value" description="Label text of the control." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="Control" type="ref{LV.Control}" uid="co" uid_parent="root" value="" conIdx="4" connection="recommended" inputs="value:ix.element" description="Reference to the control found." />
  <Indicator _name="Found" type="bool" uid="fo" uid_parent="root" value="false" conIdx="6" connection="recommended" inputs="value:gt.x &gt; y?" description="True when a control with that label exists." />
  <Indicator _name="Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="ro" uid_parent="root" value="[0,0,0,0]" conIdx="8" connection="recommended" inputs="value:bun.output cluster" description="Body rectangle in panel-image pixels." />
  <Indicator _name="Pane Left" type="int32" uid="pl" uid_parent="root" value="0" connection="optional" inputs="value:ubp.Left" description="Raw Position.Left in pane coordinates." />
  <Indicator _name="Pane Top" type="int32" uid="pt" uid_parent="root" value="0" connection="optional" inputs="value:ubp.Top" description="Raw Position.Top in pane coordinates." />
  <Indicator _name="Origin H" type="int32" uid="oh" uid_parent="root" value="0" connection="optional" inputs="value:oh32.32bit integer" description="Front Panel Window\3AOrigin.Horizontal." />
  <Indicator _name="Origin V" type="int32" uid="ov" uid_parent="root" value="0" connection="optional" inputs="value:ov32.32bit integer" description="Front Panel Window\3AOrigin.Vertical." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:cp.error out" description="Standard error out." />
  <Node _name="Property Node" uid="vp" uid_parent="root" fields="read+Front Panel,read+Front Panel Window\3AOrigin" type="{LV.VI}" inputs="reference:vi.value,error in (no error):ei.value" outputs="error out:vp.error out,Front Panel:vp.Front Panel,Front Panel Window\3AOrigin:vp.Front Panel Window\3AOrigin" />
  <Node _name="Property Node" uid="ctls" uid_parent="root" fields="read+Controls[]" type="{LV.Panel}" inputs="reference:vp.Front Panel,error in (no error):vp.error out" outputs="error out:ctls.error out,Controls[]:ctls.Controls[]" />
  <Structure _name="For Loop" uid="lbl" uid_parent="root" count="" maxin="" maxout="" label="Collect every label">
    <Tunnel _id="In1" uid="lin" uid_parent="lbl" mode="index" inputs="value:ctls.Controls[]" outputs="value:lin.value" />
    <Node _name="Property Node" uid="lt" uid_parent="lbl" fields="read+Label.Text" type="{LV.Control}" inputs="reference:lin.value" outputs="Label.Text:lt.Label.Text" />
    <Tunnel _id="Out1" uid="lout" uid_parent="lbl" mode="index" inputs="value:lt.Label.Text" outputs="value:lout.value" />
  </Structure>
  <Node _name="Search 1D Array" uid="ss" uid_parent="root" inputs="1D array:lout.value,element:lb.value" outputs="index of element:ss.index of element" />
  <Constant _name="not found" type="int32" uid="m1" uid_parent="root" value="-1" outputs="value:m1.value" />
  <Node _name="Greater?" uid="gt" uid_parent="root" inputs="x:ss.index of element,y:m1.value" outputs="x &gt; y?:gt.x &gt; y?" />
  <Node _name="Index Array" uid="ix" uid_parent="root" inputs="array:ctls.Controls[],index:ss.index of element" outputs="element:ix.element" />
  <Node _name="Property Node" uid="cp" uid_parent="root" fields="read+Position,read+Bounds" type="{LV.Control}" inputs="reference:ix.element,error in (no error):ctls.error out" outputs="error out:cp.error out,Position:cp.Position,Bounds:cp.Bounds" />
  <Node _name="Unbundle By Name" uid="ubp" uid_parent="root" fields="Left,Top" inputs="input cluster:cp.Position" outputs="Left:ubp.Left,Top:ubp.Top" />
  <Node _name="Unbundle By Name" uid="ubb" uid_parent="root" fields="Width,Height" inputs="input cluster:cp.Bounds" outputs="Width:ubb.Width,Height:ubb.Height" />
  <Node _name="Unbundle By Name" uid="ubo" uid_parent="root" fields="Horizontal,Vertical" inputs="input cluster:vp.Front Panel Window\3AOrigin" outputs="Horizontal:ubo.Horizontal,Vertical:ubo.Vertical" />
  <Node _name="To Long Integer" uid="oh32" uid_parent="root" inputs="number:ubo.Horizontal" outputs="32bit integer:oh32.32bit integer" />
  <Node _name="To Long Integer" uid="ov32" uid_parent="root" inputs="number:ubo.Vertical" outputs="32bit integer:ov32.32bit integer" />
  <Node _name="To Long Integer" uid="w32" uid_parent="root" inputs="number:ubb.Width" outputs="32bit integer:w32.32bit integer" />
  <Node _name="To Long Integer" uid="h32" uid_parent="root" inputs="number:ubb.Height" outputs="32bit integer:h32.32bit integer" />
  <Node _name="Subtract" uid="rx" uid_parent="root" inputs="x:ubp.Left,y:oh32.32bit integer" outputs="x-y:rx.x-y" />
  <Node _name="Subtract" uid="ry" uid_parent="root" inputs="x:ubp.Top,y:ov32.32bit integer" outputs="x-y:ry.x-y" />
  <Constant _name="rect type" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rc" uid_parent="root" value="[0,0,0,0]" outputs="value:rc.value" />
  <Node _name="Bundle By Name" uid="bun" uid_parent="root" fields="Left,Top,Width,Height" inputs="input cluster:rc.value,Left:rx.x-y,Top:ry.x-y,Width:w32.32bit integer,Height:h32.32bit integer" outputs="output cluster:bun.output cluster" />
  <FreeLabel comment="Panel-image pixel = pane position - window origin" uid="c1" uid_parent="root" />
</VI>
