<VI _name="Spike Post Key.vi" description="Posts one Win32 KEYBOARD message (WM_KEYDOWN 256\2C WM_KEYUP 257\2C WM_CHAR 258) with the given wParam and lParam to the front panel window of VI\2C then waits Delay ms so the UI thread can process it. An incoming error skips the post.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The VI whose front panel window receives the message." />
  <Control _name="Msg" type="uint32" uid="msg" uid_parent="root" value="258" conIdx="5" connection="required" outputs="value:msg.value" description="256 WM_KEYDOWN\2C 257 WM_KEYUP\2C 258 WM_CHAR." />
  <Control _name="wParam" type="uint64" uid="wp" uid_parent="root" value="0" conIdx="7" connection="required" outputs="value:wp.value" description="Virtual key (KEYDOWN/UP) or character code (CHAR)." />
  <Control _name="lParam" type="int64" uid="lp" uid_parent="root" value="1" conIdx="9" connection="recommended" outputs="value:lp.value" description="1 for down/char\2C 3221225473 (0xC0000001) for key up." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="50" conIdx="1" connection="recommended" outputs="value:dl.value" description="Wait after posting." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="return value" type="int32" uid="rv" uid_parent="root" value="0" conIdx="4" connection="recommended" inputs="value:pm.return value" description="PostMessageW result\2C nonzero on success." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:wo.value" description="Standard error out." />
  <Node _name="Property Node" uid="pn" uid_parent="root" fields="read+Front Panel Window\3AOS Window" type="{LV.VI}" inputs="reference:vi.value,error in (no error):ei.value" outputs="error out:pn.error out,Front Panel Window\3AOS Window:pn.Front Panel Window\3AOS Window" />
  <Node _name="To Quad Integer" uid="q1" uid_parent="root" inputs="number:pn.Front Panel Window\3AOS Window" outputs="64bit integer:q1.64bit integer" />
  <Node _name="To Unsigned Quad Integer" uid="hw" uid_parent="root" inputs="number:q1.64bit integer" outputs="unsigned 64bit integer:hw.unsigned 64bit integer" />
  <Call uid="pm" uid_parent="root" target="user32 PostMessageW.vi" inputs="hWnd:hw.unsigned 64bit integer,Msg:msg.value,wParam:wp.value,lParam:lp.value,error in (no error):pn.error out" outputs="return value:pm.return value,error out:pm.error out" />
  <Structure _name="Flat Sequence Frame" uid="seq" uid_parent="root">
    <Node _name="Wait (ms)" uid="w" uid_parent="seq" inputs="milliseconds to wait:wi.value" outputs="millisecond timer value:" />
    <Tunnel _id="In1" uid="wi" uid_parent="seq" inputs="value:dl.value" outputs="value:wi.value" />
    <Tunnel _id="In2" uid="ein" uid_parent="seq" inputs="value:pm.error out" outputs="value:ein.value" />
    <Tunnel _id="Out1" uid="wo" uid_parent="seq" inputs="value:ein.value" outputs="value:wo.value" />
  </Structure>
  <FreeLabel comment="Post to the panel HWND\2C then let the UI settle" uid="c1" uid_parent="root" />
</VI>
