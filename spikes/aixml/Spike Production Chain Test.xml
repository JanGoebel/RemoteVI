<VI _name="Spike Production Chain Test.vi" description="Test harness for Spike Production Input Chain.vi: launches Injection Fixture.vi (Spike Launch Fixture.vi)\2C reports the panel-image rectangles of Switch\2C Slide\2C Number\2C Text and Stop (Spike Find Control.vi)\2C drives the panel with Messages through the production chain\2C waits Settle ms\2C reads the four values and Execution\3AState back through VI Server and cleans up (Spike Close Fixture.vi\2C which aborts the fixture if it is still running).">
  <FreeLabel comment="Launch\2C locate\2C drive\2C read back\2C close" uid="lbl" uid_parent="root"/>
  <Control _name="Fixture Path" conIdx="0" connection="required" description="Path of Injection Fixture.vi." outputs="value:fp.value" type="path" uid="fp" uid_parent="root" value=""/>
  <Control _name="Messages" conIdx="5" connection="recommended" description="Client message texts\2C empty to only read the rectangles." outputs="value:m.value" type="array{string}" uid="m" uid_parent="root" value="[]"/>
  <Control _name="Delay ms" conIdx="7" connection="recommended" description="Wait after each message." outputs="value:dl.value" type="uint32" uid="dl" uid_parent="root" value="50"/>
  <Control _name="Settle ms" conIdx="9" connection="recommended" description="Wait before reading back." outputs="value:sm.value" type="uint32" uid="sm" uid_parent="root" value="300"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Call inputs="Fixture Path:fp.value,error in:ei.value" outputs="VI:ln.VI,Is Frontmost:,error out:ln.error out" target="Spike Launch Fixture.vi" uid="ln" uid_parent="root"/>
  <Constant _name="Switch label" outputs="value:kSwitch.value" type="string" uid="kSwitch" uid_parent="root" value="Switch"/>
  <Call inputs="VI:ln.VI,Label:kSwitch.value,error in:ln.error out" outputs="Control:fSwitch.Control,Found:,Rect:fSwitch.Rect,error out:fSwitch.error out" target="Spike Find Control.vi" uid="fSwitch" uid_parent="root"/>
  <Indicator _name="Switch Rect" connection="optional" description="Switch body in panel-image pixels." inputs="value:fSwitch.Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rSwitch" uid_parent="root" value="[0,0,0,0]"/>
  <Constant _name="Slide label" outputs="value:kSlide.value" type="string" uid="kSlide" uid_parent="root" value="Slide"/>
  <Call inputs="VI:ln.VI,Label:kSlide.value,error in:ln.error out" outputs="Control:fSlide.Control,Found:,Rect:fSlide.Rect,error out:fSlide.error out" target="Spike Find Control.vi" uid="fSlide" uid_parent="root"/>
  <Indicator _name="Slide Rect" connection="optional" description="Slide body in panel-image pixels." inputs="value:fSlide.Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rSlide" uid_parent="root" value="[0,0,0,0]"/>
  <Constant _name="Number label" outputs="value:kNumber.value" type="string" uid="kNumber" uid_parent="root" value="Number"/>
  <Call inputs="VI:ln.VI,Label:kNumber.value,error in:ln.error out" outputs="Control:fNumber.Control,Found:,Rect:fNumber.Rect,error out:fNumber.error out" target="Spike Find Control.vi" uid="fNumber" uid_parent="root"/>
  <Indicator _name="Number Rect" connection="optional" description="Number body in panel-image pixels." inputs="value:fNumber.Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rNumber" uid_parent="root" value="[0,0,0,0]"/>
  <Constant _name="Text label" outputs="value:kText.value" type="string" uid="kText" uid_parent="root" value="Text"/>
  <Call inputs="VI:ln.VI,Label:kText.value,error in:ln.error out" outputs="Control:fText.Control,Found:,Rect:fText.Rect,error out:fText.error out" target="Spike Find Control.vi" uid="fText" uid_parent="root"/>
  <Indicator _name="Text Rect" connection="optional" description="Text body in panel-image pixels." inputs="value:fText.Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rText" uid_parent="root" value="[0,0,0,0]"/>
  <Constant _name="Stop label" outputs="value:kStop.value" type="string" uid="kStop" uid_parent="root" value="Stop"/>
  <Call inputs="VI:ln.VI,Label:kStop.value,error in:ln.error out" outputs="Control:fStop.Control,Found:,Rect:fStop.Rect,error out:fStop.error out" target="Spike Find Control.vi" uid="fStop" uid_parent="root"/>
  <Indicator _name="Stop Rect" connection="optional" description="Stop body in panel-image pixels." inputs="value:fStop.Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="rStop" uid_parent="root" value="[0,0,0,0]"/>
  <Call inputs="VI:ln.VI,Messages:m.value,Delay ms:dl.value,error in:ln.error out" outputs="Tracking Out:ch.Tracking Out,Posts Per Message:ch.Posts Per Message,error out:ch.error out" target="Spike Production Input Chain.vi" uid="ch" uid_parent="root"/>
  <Structure _name="Flat Sequence Frame" label="Settle" uid="seq" uid_parent="root">
    <Node _name="Wait (ms)" inputs="milliseconds to wait:wi.value" outputs="millisecond timer value:" uid="w" uid_parent="seq"/>
    <Tunnel _id="In1" inputs="value:sm.value" outputs="value:wi.value" uid="wi" uid_parent="seq"/>
    <Tunnel _id="In2" inputs="value:ch.error out" outputs="value:ein.value" uid="ein" uid_parent="seq"/>
    <Tunnel _id="Out1" inputs="value:ein.value" outputs="value:wo.value" uid="wo" uid_parent="seq"/>
  </Structure>
  <Node _name="Property Node" fields="read+Value" inputs="reference:fSwitch.Control,error in (no error):wo.value" outputs="error out:pSwitch.error out,Value:pSwitch.Value" type="{LV.Control}" uid="pSwitch" uid_parent="root"/>
  <Constant _name="Switch type" outputs="value:tSwitch.value" type="bool" uid="tSwitch" uid_parent="root" value="false"/>
  <Node _name="Variant To Data" inputs="variant:pSwitch.Value,type:tSwitch.value,error in:pSwitch.error out" outputs="data:vSwitch.data,error out:vSwitch.error out" uid="vSwitch" uid_parent="root"/>
  <Indicator _name="Switch" connection="optional" description="Switch value after the messages." inputs="value:vSwitch.data" type="bool" uid="oSwitch" uid_parent="root" value="false"/>
  <Node _name="Property Node" fields="read+Value" inputs="reference:fSlide.Control,error in (no error):wo.value" outputs="error out:pSlide.error out,Value:pSlide.Value" type="{LV.Control}" uid="pSlide" uid_parent="root"/>
  <Constant _name="Slide type" outputs="value:tSlide.value" type="double" uid="tSlide" uid_parent="root" value="0"/>
  <Node _name="Variant To Data" inputs="variant:pSlide.Value,type:tSlide.value,error in:pSlide.error out" outputs="data:vSlide.data,error out:vSlide.error out" uid="vSlide" uid_parent="root"/>
  <Indicator _name="Slide" connection="optional" description="Slide value after the messages." inputs="value:vSlide.data" type="double" uid="oSlide" uid_parent="root" value="0"/>
  <Node _name="Property Node" fields="read+Value" inputs="reference:fNumber.Control,error in (no error):wo.value" outputs="error out:pNumber.error out,Value:pNumber.Value" type="{LV.Control}" uid="pNumber" uid_parent="root"/>
  <Constant _name="Number type" outputs="value:tNumber.value" type="double" uid="tNumber" uid_parent="root" value="0"/>
  <Node _name="Variant To Data" inputs="variant:pNumber.Value,type:tNumber.value,error in:pNumber.error out" outputs="data:vNumber.data,error out:vNumber.error out" uid="vNumber" uid_parent="root"/>
  <Indicator _name="Number" connection="optional" description="Number value after the messages." inputs="value:vNumber.data" type="double" uid="oNumber" uid_parent="root" value="0"/>
  <Node _name="Property Node" fields="read+Value" inputs="reference:fText.Control,error in (no error):wo.value" outputs="error out:pText.error out,Value:pText.Value" type="{LV.Control}" uid="pText" uid_parent="root"/>
  <Constant _name="Text type" outputs="value:tText.value" type="string" uid="tText" uid_parent="root" value=""/>
  <Node _name="Variant To Data" inputs="variant:pText.Value,type:tText.value,error in:pText.error out" outputs="data:vText.data,error out:vText.error out" uid="vText" uid_parent="root"/>
  <Indicator _name="Text" connection="optional" description="Text value after the messages." inputs="value:vText.data" type="string" uid="oText" uid_parent="root" value=""/>
  <Node _name="Property Node" fields="read+Execution\3AState" inputs="reference:ln.VI,error in (no error):wo.value" outputs="error out:st.error out,Execution\3AState:st.Execution\3AState" type="{LV.VI}" uid="st" uid_parent="root"/>
  <Node _name="To Long Integer" inputs="number:st.Execution\3AState" outputs="32bit integer:s32.32bit integer" uid="s32" uid_parent="root"/>
  <Indicator _name="State" connection="optional" description="Fixture Execution\3AState after the messages (1 = Idle\2C 2 = running top level)." inputs="value:s32.32bit integer" type="int32" uid="oSt" uid_parent="root" value="0"/>
  <Node _name="Merge Errors" inputs="error in:fSwitch.error out,error in:fSlide.error out" outputs="error out:me0.error out" uid="me0" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me0.error out,error in:fNumber.error out" outputs="error out:me1.error out" uid="me1" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me1.error out,error in:fText.error out" outputs="error out:me2.error out" uid="me2" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me2.error out,error in:fStop.error out" outputs="error out:me3.error out" uid="me3" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me3.error out,error in:vSwitch.error out" outputs="error out:me4.error out" uid="me4" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me4.error out,error in:vSlide.error out" outputs="error out:me5.error out" uid="me5" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me5.error out,error in:vNumber.error out" outputs="error out:me6.error out" uid="me6" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me6.error out,error in:vText.error out" outputs="error out:me7.error out" uid="me7" uid_parent="root"/>
  <Node _name="Merge Errors" inputs="error in:me7.error out,error in:st.error out" outputs="error out:me8.error out" uid="me8" uid_parent="root"/>
  <Call inputs="VI:ln.VI,error in:me8.error out" outputs="Was Running:cl.Was Running,error out:cl.error out" target="Spike Close Fixture.vi" uid="cl" uid_parent="root"/>
  <Indicator _name="Tracking Out" connection="optional" description="Tracking state after the last message." inputs="value:ch.Tracking Out" type="bool" uid="oT" uid_parent="root" value="false"/>
  <Indicator _name="Posts Per Message" connection="optional" description="Win32 messages posted per client message." inputs="value:ch.Posts Per Message" type="array{int32}" uid="oP" uid_parent="root" value="[]"/>
  <Indicator _name="Was Running" connection="optional" description="The fixture had to be aborted at cleanup." inputs="value:cl.Was Running" type="bool" uid="oW" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:cl.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
