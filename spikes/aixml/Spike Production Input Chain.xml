<VI _name="Spike Production Input Chain.vi" description="Drives the front panel of VI ONLY through the production input chain\2C as the server will: each client message text (e.g. m 513 x y 1) goes through RemoteVI Parse Input.vi\2C RemoteVI Get Panel Geometry.vi\2C RemoteVI Translate Input.vi (tracking carried from message to message) and RemoteVI Post Input.vi\2C then Delay ms is waited. Returns the final tracking state and the number of Win32 messages posted per client message. An error skips the remaining posts.">
  <FreeLabel comment="Parse\2C geometry\2C translate\2C post\2C wait" uid="lbl" uid_parent="root"/>
  <Control _name="VI" conIdx="0" connection="required" description="The running VI whose panel is driven." outputs="value:vi.value" type="ref{LV.VI}" uid="vi" uid_parent="root" value=""/>
  <Control _name="Messages" conIdx="5" connection="required" description="Client message texts in order\2C as the browser sends them." outputs="value:m.value" type="array{string}" uid="m" uid_parent="root" value="[]"/>
  <Control _name="Delay ms" conIdx="7" connection="recommended" description="Wait after each message." outputs="value:dl.value" type="uint32" uid="dl" uid_parent="root" value="50"/>
  <Control _name="Tracking In" conIdx="9" connection="optional" description="Initial tracking state." outputs="value:ti.value" type="bool" uid="ti" uid_parent="root" value="false"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Structure _name="For Loop" count="" label="One client message per iteration" maxin="" maxout="" uid="loop" uid_parent="root">
    <Tunnel _id="In1" inputs="value:m.value" mode="index" outputs="value:mi.value" uid="mi" uid_parent="loop"/>
    <Tunnel _id="In2" inputs="value:vi.value" outputs="value:vin.value" uid="vin" uid_parent="loop"/>
    <Tunnel _id="In3" inputs="value:dl.value" outputs="value:dli.value" uid="dli" uid_parent="loop"/>
    <ShiftReg uid="sre" uid_parent="loop">
      <Left inputs="value:ei.value" outputs="value:el.value" uid="el" uid_parent="sre"/>
      <Right inputs="value:wo.value" outputs="value:er.value" uid="er" uid_parent="sre"/>
    </ShiftReg>
    <ShiftReg uid="srt" uid_parent="loop">
      <Left inputs="value:ti.value" outputs="value:tl.value" uid="tl" uid_parent="srt"/>
      <Right inputs="value:tr.tracking out" outputs="value:trr.value" uid="trr" uid_parent="srt"/>
    </ShiftReg>
    <Call inputs="text:mi.value" outputs="kind:pi.kind,msg:pi.msg,x:pi.x,y:pi.y,wParam:pi.wParam,lParam:pi.lParam,seq:" target="RemoteVI Parse Input.vi" uid="pi" uid_parent="loop"/>
    <Call inputs="VI:vin.value,error in:el.value" outputs="geo:gg.geo,hWnd:,error out:gg.error out" target="RemoteVI Get Panel Geometry.vi" uid="gg" uid_parent="loop"/>
    <Call inputs="kind:pi.kind,msg:pi.msg,x:pi.x,y:pi.y,wParam:pi.wParam,lParam:pi.lParam,geo:gg.geo,tracking in:tl.value" outputs="posts:tr.posts,tracking out:tr.tracking out" target="RemoteVI Translate Input.vi" uid="tr" uid_parent="loop"/>
    <Call inputs="VI:vin.value,posts:tr.posts,error in:gg.error out" outputs="error out:po.error out" target="RemoteVI Post Input.vi" uid="po" uid_parent="loop"/>
    <Node _name="Array Size" inputs="array:tr.posts" outputs="size(s):sz.size(s)" uid="sz" uid_parent="loop"/>
    <Structure _name="Flat Sequence Frame" label="Let the UI thread process" uid="seq" uid_parent="loop">
      <Node _name="Wait (ms)" inputs="milliseconds to wait:wi.value" outputs="millisecond timer value:" uid="w" uid_parent="seq"/>
      <Tunnel _id="In1" inputs="value:dli.value" outputs="value:wi.value" uid="wi" uid_parent="seq"/>
      <Tunnel _id="In2" inputs="value:po.error out" outputs="value:ein.value" uid="ein" uid_parent="seq"/>
      <Tunnel _id="Out1" inputs="value:ein.value" outputs="value:wo.value" uid="wo" uid_parent="seq"/>
    </Structure>
    <Tunnel _id="Out1" inputs="value:sz.size(s)" mode="index" outputs="value:ca.value" uid="ca" uid_parent="loop"/>
  </Structure>
  <Indicator _name="Tracking Out" conIdx="4" connection="recommended" description="Tracking state after the last message." inputs="value:trr.value" type="bool" uid="o_t" uid_parent="root" value="false"/>
  <Indicator _name="Posts Per Message" conIdx="6" connection="recommended" description="Number of Win32 messages posted for each client message." inputs="value:ca.value" type="array{int32}" uid="o_c" uid_parent="root" value="[]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:er.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
