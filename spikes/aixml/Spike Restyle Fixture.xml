<VI _name="Spike Restyle Fixture.vi" description="One-off scripting helper for the input-injection spike. Opens the VI at Fixture Path\2C replaces its controls labelled Slide and Stop with the controls stored in Slide Ctl Path and Stop Ctl Path ({LV.Control} Replace keeps label\2C position and wiring) and saves the VI. AIXML cannot express a control style\2C which is why this exists. Any error skips the rest and is returned in error out.">
  <Control _name="Fixture Path" type="path" uid="fp" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:fp.value" description="The fixture VI to restyle. It is saved in place." />
  <Control _name="Slide Ctl Path" type="path" uid="sp" uid_parent="root" value="" conIdx="5" connection="required" outputs="value:sp.value" description="A .ctl holding the slide to use, e.g. Horizontal Pointer Slide NI_Silver.ctl." />
  <Control _name="Stop Ctl Path" type="path" uid="tp" uid_parent="root" value="" conIdx="7" connection="required" outputs="value:tp.value" description="A .ctl holding the stop button to use, e.g. OK Button NI_Silver.ctl." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:close.error out" description="Standard error out." />
  <Node _name="Open VI Reference" uid="open" uid_parent="root" inputs="vi path:fp.value,error in (no error):ei.value" outputs="vi reference:open.vi reference,error out:open.error out" />
  <Node _name="Property Node" uid="fpn" uid_parent="root" fields="read+Front Panel" type="{LV.VI}" inputs="reference:open.vi reference,error in (no error):open.error out" outputs="error out:fpn.error out,Front Panel:fpn.Front Panel" />
  <Node _name="Property Node" uid="ctls" uid_parent="root" fields="read+Controls[]" type="{LV.Panel}" inputs="reference:fpn.Front Panel,error in (no error):fpn.error out" outputs="error out:ctls.error out,Controls[]:ctls.Controls[]" />
  <Structure _name="For Loop" uid="lbl" uid_parent="root" count="" maxin="" maxout="">
    <Tunnel _id="In1" uid="lin" uid_parent="lbl" mode="index" inputs="value:ctls.Controls[]" outputs="value:lin.value" />
    <Node _name="Property Node" uid="lt" uid_parent="lbl" fields="read+Label.Text" type="{LV.Control}" inputs="reference:lin.value" outputs="Label.Text:lt.Label.Text" />
    <Tunnel _id="Out1" uid="lout" uid_parent="lbl" mode="index" inputs="value:lt.Label.Text" outputs="value:lout.value" />
  </Structure>
  <Constant _name="slide label" type="string" uid="sll" uid_parent="root" value="Slide" outputs="value:sll.value" />
  <Constant _name="stop label" type="string" uid="stl" uid_parent="root" value="Stop" outputs="value:stl.value" />
  <Node _name="Search 1D Array" uid="ss" uid_parent="root" inputs="1D array:lout.value,element:sll.value" outputs="index of element:ss.index of element" />
  <Node _name="Search 1D Array" uid="st" uid_parent="root" inputs="1D array:lout.value,element:stl.value" outputs="index of element:st.index of element" />
  <Node _name="Index Array" uid="is" uid_parent="root" inputs="array:ctls.Controls[],index:ss.index of element" outputs="element:is.element" />
  <Node _name="Index Array" uid="it" uid_parent="root" inputs="array:ctls.Controls[],index:st.index of element" outputs="element:it.element" />
  <Node _name="Invoke Node" uid="rs" uid_parent="root" target="Replace" type="{LV.Control}" inputs="reference:is.element,error in (no error):ctls.error out,Path:sp.value" outputs="error out:rs.error out" />
  <Node _name="Invoke Node" uid="rt" uid_parent="root" target="Replace" type="{LV.Control}" inputs="reference:it.element,error in (no error):rs.error out,Path:tp.value" outputs="error out:rt.error out" />
  <Node _name="Invoke Node" uid="save" uid_parent="root" target="Save.Instrument" type="{LV.VI}" inputs="reference:open.vi reference,error in (no error):rt.error out" outputs="reference out:save.reference out,error out:save.error out" />
  <Node _name="Close Reference" uid="close" uid_parent="root" inputs="reference:open.vi reference,error in (no error):save.error out" outputs="error out:close.error out" />
  <FreeLabel comment="Swap two controls for styled ones, then save" uid="c1" uid_parent="root" />
</VI>
