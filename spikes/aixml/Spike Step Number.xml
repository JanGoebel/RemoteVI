  <Control _name="Label" type="string" uid="lb" uid_parent="root" value="Number" conIdx="5" connection="recommended" outputs="value:lb.value" description="Label of the numeric." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="60" conIdx="7" connection="recommended" outputs="value:dl.value" description="Wait after each posted message." />
