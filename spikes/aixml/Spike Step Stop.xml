<VI _name="Spike Step Stop.vi" description="Spike step e: posts a click on the centre of the latched button labelled Label (default Stop)\2C then polls the VI's Execution\3AState every 10 ms until it is Idle (1) or Timeout ms have passed since the click started. Pass when the VI went idle. Any error skips the rest.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The running fixture." />
  <Control _name="Label" type="string" uid="lb" uid_parent="root" value="Stop" conIdx="5" connection="recommended" outputs="value:lb.value" description="Label of the stop button." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="60" conIdx="7" connection="recommended" outputs="value:dl.value" description="Wait after each posted message." />
  <Control _name="Timeout ms" type="uint32" uid="tm" uid_parent="root" value="1500" conIdx="9" connection="recommended" outputs="value:tm.value" description="Give up waiting for Idle after this long." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="Pass" type="bool" uid="po" uid_parent="root" value="false" conIdx="4" connection="recommended" inputs="value:idt.value" description="True when the VI went idle in time." />
  <Indicator _name="Final State" type="int32" uid="fs" uid_parent="root" value="0" conIdx="6" connection="recommended" inputs="value:stt.value" description="Last Execution\3AState read: 0 Bad\2C 1 Idle\2C 2 Run top level\2C 3 Running." />
  <Indicator _name="Elapsed ms" type="uint32" uid="el" uid_parent="root" value="0" conIdx="8" connection="recommended" inputs="value:elt.value" description="Milliseconds from just before the click to the last poll." />
  <Indicator _name="Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="ro" uid_parent="root" value="[0,0,0,0]" conIdx="10" connection="recommended" inputs="value:fc.Rect" description="Control in panel-image pixels." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:ert.value" description="Standard error out." />
  <Call uid="fc" uid_parent="root" target="Spike Find Control.vi" inputs="VI:vi.value,Label:lb.value,error in:ei.value" outputs="Control:,Found:,Rect:fc.Rect,error out:fc.error out" />
  <Node _name="Unbundle By Name" uid="ub" uid_parent="root" fields="Left,Top,Width,Height" inputs="input cluster:fc.Rect" outputs="Left:ub.Left,Top:ub.Top,Width:ub.Width,Height:ub.Height" />
  <Constant _name="two" type="int32" uid="k2" uid_parent="root" value="2" outputs="value:k2.value" />
  <Node _name="Quotient &amp; Remainder" uid="hw" uid_parent="root" inputs="x:ub.Width,y:k2.value" outputs="x-y*floor(x/y):,floor(x/y):hw.floor(x/y)" />
  <Node _name="Quotient &amp; Remainder" uid="hh" uid_parent="root" inputs="x:ub.Height,y:k2.value" outputs="x-y*floor(x/y):,floor(x/y):hh.floor(x/y)" />
  <Node _name="Add" uid="cx" uid_parent="root" inputs="x:ub.Left,y:hw.floor(x/y)" outputs="x+y:cx.x+y" />
  <Node _name="Add" uid="cy" uid_parent="root" inputs="x:ub.Top,y:hh.floor(x/y)" outputs="x+y:cy.x+y" />
  <Structure _name="Flat Sequence Frame" uid="seq" uid_parent="root" label="Start time">
    <Node _name="Tick Count (ms)" uid="t0" uid_parent="seq" outputs="millisecond timer value:t0.millisecond timer value" />
    <Tunnel _id="In1" uid="sin" uid_parent="seq" inputs="value:fc.error out" outputs="value:sin.value" />
    <Tunnel _id="Out1" uid="sout" uid_parent="seq" inputs="value:sin.value" outputs="value:sout.value" />
    <Tunnel _id="Out2" uid="tout" uid_parent="seq" inputs="value:t0.millisecond timer value" outputs="value:tout.value" />
  </Structure>
  <Call uid="ck" uid_parent="root" target="Spike Click.vi" inputs="VI:vi.value,Panel X:cx.x+y,Panel Y:cy.x+y,Delay ms:dl.value,error in:sout.value" outputs="error out:ck.error out" />
  <Structure _name="While Loop" count="" uid="wl" uid_parent="root" label="Poll until Idle or timeout">
    <Tunnel _id="In1" uid="wvi" uid_parent="wl" inputs="value:vi.value" outputs="value:wvi.value" />
    <Tunnel _id="In2" uid="wer" uid_parent="wl" inputs="value:ck.error out" outputs="value:wer.value" />
    <Tunnel _id="In3" uid="wt0" uid_parent="wl" inputs="value:tout.value" outputs="value:wt0.value" />
    <Tunnel _id="In4" uid="wtm" uid_parent="wl" inputs="value:tm.value" outputs="value:wtm.value" />
    <Constant _name="poll ms" type="uint32" uid="pms" uid_parent="wl" value="10" outputs="value:pms.value" />
    <Node _name="Wait (ms)" uid="pw" uid_parent="wl" inputs="milliseconds to wait:pms.value" outputs="millisecond timer value:" />
    <Node _name="Property Node" uid="ps" uid_parent="wl" fields="read+Execution\3AState" type="{LV.VI}" inputs="reference:wvi.value,error in (no error):wer.value" outputs="error out:ps.error out,Execution\3AState:ps.Execution\3AState" />
    <Node _name="To Long Integer" uid="s32" uid_parent="wl" inputs="number:ps.Execution\3AState" outputs="32bit integer:s32.32bit integer" />
    <Constant _name="Idle" type="int32" uid="k1" uid_parent="wl" value="1" outputs="value:k1.value" />
    <Node _name="Equal?" uid="isid" uid_parent="wl" inputs="x:s32.32bit integer,y:k1.value" outputs="x = y?:isid.x = y?" />
    <Node _name="Tick Count (ms)" uid="t1" uid_parent="wl" outputs="millisecond timer value:t1.millisecond timer value" />
    <Node _name="Subtract" uid="dt" uid_parent="wl" inputs="x:t1.millisecond timer value,y:wt0.value" outputs="x-y:dt.x-y" />
    <Node _name="Greater Or Equal?" uid="to" uid_parent="wl" inputs="x:dt.x-y,y:wtm.value" outputs="x &gt;= y?:to.x &gt;= y?" />
    <Node _name="Or" uid="or" uid_parent="wl" inputs="x:isid.x = y?,y:to.x &gt;= y?" outputs="x .or. y?:or.x .or. y?" />
    <Condition uid="cond" uid_parent="wl" value="stop" inputs="value:or.x .or. y?" />
    <Tunnel _id="Out1" uid="idt" uid_parent="wl" inputs="value:isid.x = y?" outputs="value:idt.value" />
    <Tunnel _id="Out2" uid="stt" uid_parent="wl" inputs="value:s32.32bit integer" outputs="value:stt.value" />
    <Tunnel _id="Out3" uid="elt" uid_parent="wl" inputs="value:dt.x-y" outputs="value:elt.value" />
    <Tunnel _id="Out4" uid="ert" uid_parent="wl" inputs="value:ps.error out" outputs="value:ert.value" />
  </Structure>
  <FreeLabel comment="Click Stop\2C time how long until Idle" uid="c1" uid_parent="root" />
</VI>
