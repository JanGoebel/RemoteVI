<VI _name="Spike Step Text.vi" description="Spike step d: edits the string control labelled Label (default Text) with posted input only - a click on its centre\2C one WM_CHAR per character of Text\2C then a click on the empty panel at (Empty X\2C Empty Y) to commit. Waits Settle ms and reads the value back. Pass when the value contains Text. Any error skips the rest.">
  <Control _name="VI" type="ref{LV.VI}" uid="vi" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:vi.value" description="The running fixture." />
  <Control _name="Label" type="string" uid="lb" uid_parent="root" value="Text" conIdx="5" connection="recommended" outputs="value:lb.value" description="Label of the string control." />
  <Control _name="Delay ms" type="uint32" uid="dl" uid_parent="root" value="60" conIdx="7" connection="recommended" outputs="value:dl.value" description="Wait after each posted message." />
  <Control _name="Settle ms" type="uint32" uid="sm" uid_parent="root" value="200" conIdx="9" connection="recommended" outputs="value:sm.value" description="Wait before the value is read back." />
  <Control _name="Text" type="string" uid="tx" uid_parent="root" value="hello" conIdx="1" connection="recommended" outputs="value:tx.value" description="Characters to type." />
  <Control _name="Empty X" type="int32" uid="exx" uid_parent="root" value="400" conIdx="2" connection="recommended" outputs="value:exx.value" description="X of an empty panel spot\2C clicked to commit." />
  <Control _name="Empty Y" type="int32" uid="eyy" uid_parent="root" value="300" conIdx="3" connection="recommended" outputs="value:eyy.value" description="Y of an empty panel spot\2C clicked to commit." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in." />
  <Indicator _name="Pass" type="bool" uid="po" uid_parent="root" value="false" conIdx="4" connection="recommended" inputs="value:gt.x &gt; y?" description="True when the value contains Text." />
  <Indicator _name="Before" type="string" uid="bo" uid_parent="root" value="" conIdx="6" connection="recommended" inputs="value:v1.data" description="Value before the edit." />
  <Indicator _name="After" type="string" uid="ao" uid_parent="root" value="" conIdx="8" connection="recommended" inputs="value:v2.data" description="Value after the edit." />
  <Indicator _name="Rect" type="cluster{int32.Left,int32.Top,int32.Width,int32.Height}" uid="ro" uid_parent="root" value="[0,0,0,0]" conIdx="10" connection="recommended" inputs="value:fc.Rect" description="Control in panel-image pixels." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:v2.error out" description="Standard error out." />
  <Call uid="fc" uid_parent="root" target="Spike Find Control.vi" inputs="VI:vi.value,Label:lb.value,error in:ei.value" outputs="Control:fc.Control,Found:,Rect:fc.Rect,error out:fc.error out" />
  <Node _name="Property Node" uid="r1" uid_parent="root" fields="read+Value" type="{LV.Control}" inputs="reference:fc.Control,error in (no error):fc.error out" outputs="error out:r1.error out,Value:r1.Value" />
  <Constant _name="string type" type="string" uid="bt" uid_parent="root" value="" outputs="value:bt.value" />
  <Node _name="Variant To Data" uid="v1" uid_parent="root" inputs="variant:r1.Value,type:bt.value,error in:r1.error out" outputs="data:v1.data,error out:v1.error out" />
  <Node _name="Unbundle By Name" uid="ub" uid_parent="root" fields="Left,Top,Width,Height" inputs="input cluster:fc.Rect" outputs="Left:ub.Left,Top:ub.Top,Width:ub.Width,Height:ub.Height" />
  <Constant _name="two" type="int32" uid="k2" uid_parent="root" value="2" outputs="value:k2.value" />
  <Node _name="Quotient &amp; Remainder" uid="hw" uid_parent="root" inputs="x:ub.Width,y:k2.value" outputs="x-y*floor(x/y):,floor(x/y):hw.floor(x/y)" />
  <Node _name="Quotient &amp; Remainder" uid="hh" uid_parent="root" inputs="x:ub.Height,y:k2.value" outputs="x-y*floor(x/y):,floor(x/y):hh.floor(x/y)" />
  <Node _name="Add" uid="cx" uid_parent="root" inputs="x:ub.Left,y:hw.floor(x/y)" outputs="x+y:cx.x+y" />
  <Node _name="Add" uid="cy" uid_parent="root" inputs="x:ub.Top,y:hh.floor(x/y)" outputs="x+y:cy.x+y" />
  <Call uid="ck" uid_parent="root" target="Spike Click.vi" inputs="VI:vi.value,Panel X:cx.x+y,Panel Y:cy.x+y,Delay ms:dl.value,error in:v1.error out" outputs="error out:ck.error out" />
  <Call uid="ch" uid_parent="root" target="Spike Post Char String.vi" inputs="VI:vi.value,String:tx.value,Delay ms:dl.value,error in:ck.error out" outputs="error out:ch.error out" />
  <Call uid="ce" uid_parent="root" target="Spike Click.vi" inputs="VI:vi.value,Panel X:exx.value,Panel Y:eyy.value,Delay ms:dl.value,error in:ch.error out" outputs="error out:ce.error out" />
  <Structure _name="Flat Sequence Frame" uid="seq" uid_parent="root" label="Let the UI thread settle">
    <Node _name="Wait (ms)" uid="w" uid_parent="seq" inputs="milliseconds to wait:wi.value" outputs="millisecond timer value:" />
    <Tunnel _id="In1" uid="wi" uid_parent="seq" inputs="value:sm.value" outputs="value:wi.value" />
    <Tunnel _id="In2" uid="ein" uid_parent="seq" inputs="value:ce.error out" outputs="value:ein.value" />
    <Tunnel _id="Out1" uid="wo" uid_parent="seq" inputs="value:ein.value" outputs="value:wo.value" />
  </Structure>
  <Node _name="Property Node" uid="r2" uid_parent="root" fields="read+Value" type="{LV.Control}" inputs="reference:fc.Control,error in (no error):wo.value" outputs="error out:r2.error out,Value:r2.Value" />
  <Node _name="Variant To Data" uid="v2" uid_parent="root" inputs="variant:r2.Value,type:bt.value,error in:r2.error out" outputs="data:v2.data,error out:v2.error out" />
  <Node _name="Match Pattern" uid="mp" uid_parent="root" inputs="string:v2.data,regular expression:tx.value" outputs="before substring:,match substring:,after substring:,offset past match:mp.offset past match" />
  <Constant _name="no match" type="int32" uid="m1" uid_parent="root" value="-1" outputs="value:m1.value" />
  <Node _name="Greater?" uid="gt" uid_parent="root" inputs="x:mp.offset past match,y:m1.value" outputs="x &gt; y?:gt.x &gt; y?" />
  <FreeLabel comment="Click\2C type\2C click away to commit" uid="c1" uid_parent="root" />
</VI>
