<VI _name="Spike Uncover Window.vi" description="Undoes Spike Cover Window.vi: closes the blocker's front panel when Use Blocker is TRUE\2C then closes its reference. Runs even when error in carries an error\2C which is merged into error out.">
  <Control _name="Blocker VI" type="ref{LV.VI}" uid="bv" uid_parent="root" value="" conIdx="0" connection="required" outputs="value:bv.value" description="Reference from Spike Cover Window.vi." />
  <Control _name="Use Blocker" type="bool" uid="ub" uid_parent="root" value="true" conIdx="5" connection="recommended" outputs="value:ub.value" description="Same value as given to Spike Cover Window.vi." />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" outputs="value:ei.value" description="Standard error in - does not stop the cleanup." />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" inputs="value:me.error out" description="error in merged with the cleanup's own errors." />
  <Structure _name="Case Structure" uid="cs" uid_parent="root" selectin="ub.value">
    <Tunnel _id="In1" uid="c1i" uid_parent="cs" inputs="value:bv.value" />
    <CaseFrame selector="True" uid="ft" uid_parent="cs" selectout="">
      <Tunnel _id="In1" uid="c1t" uid_parent="ft" outputs="value:c1t.value" />
      <Node _name="Invoke Node" uid="fpc" uid_parent="ft" target="FP.Close" type="{LV.VI}" inputs="reference:c1t.value" outputs="error out:fpc.error out" />
      <Tunnel _id="Out1" uid="o1t" uid_parent="ft" inputs="value:fpc.error out" />
    </CaseFrame>
    <CaseFrame selector="False" uid="ff" uid_parent="cs" selectout="">
      <Tunnel _id="In1" uid="c1f" uid_parent="ff" outputs="value:" />
      <Constant _name="no error" type="cluster{bool.status,int32.code,string.source}" uid="ne" uid_parent="ff" value="[false,0,]" outputs="value:ne.value" />
      <Tunnel _id="Out1" uid="o1f" uid_parent="ff" inputs="value:ne.value" />
    </CaseFrame>
    <Tunnel _id="Out1" uid="o1" uid_parent="cs" outputs="value:o1.value" />
  </Structure>
  <Node _name="Close Reference" uid="cr" uid_parent="root" inputs="reference:bv.value,error in (no error):o1.value" outputs="error out:cr.error out" />
  <Node _name="Merge Errors" uid="me" uid_parent="root" inputs="error in:ei.value,error in:cr.error out" outputs="error out:me.error out" />
  <FreeLabel comment="Close the blocker panel and reference" uid="cm" uid_parent="root" />
</VI>
