<VI _name="RemoteVI Check Overlay Encode.vi" description="Test support, generated by tests/caraya/build.py from tests/vectors/frame.json - do not edit. Calls RemoteVI Overlay Encode.vi once per vector: the png fields are hex in the vector and decoded to bytes before the call; the message is compared as lowercase hex. Outputs, one element per vector: labels (the vector's name), expected (rendered from the vector), actual (the VI's result rendered the same way), and failures, the number of vectors whose expected and actual differ.">
  <Constant _name="vectors" outputs="value:cases.v" type="array{cluster{string.name,array{cluster{int16.x,int16.y,string.png}}.popups,string.message}}" uid="cases" uid_parent="root" value="[[two\20popups\2C\20one\20partly\20outside\20the\20panel,[[30,140,89504e470d0a1a0a],[790,-12,0102030405]],52020002001e008c0000000889504e470d0a1a0a0316fff4000000050102030405],[clear,[],52020000]]"/>
  <Structure _name="For Loop" count="" label="One vector" maxin="" maxout="" uid="L" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cases.v" mode="index" outputs="value:tc.v" uid="tc" uid_parent="L"/>
    <Node _name="Unbundle By Name" inputs="input cluster:tc.v" outputs="name:ub.name,popups:ub.popups,message:ub.message" uid="ub" uid_parent="L" fields="name,popups,message"/>
    <Structure _name="For Loop" count="" label="Decode png hex" maxin="" maxout="" uid="R" uid_parent="L">
      <Tunnel _id="In1" inputs="value:ub.popups" mode="index" outputs="value:tr.v" uid="tr" uid_parent="R"/>
      <Node _name="Unbundle By Name" inputs="input cluster:tr.v" outputs="png:ubr.png" uid="ubr" uid_parent="R" fields="png"/>
      <Call target="RemoteVI Test Hex To Bytes.vi" inputs="hex:ubr.png" outputs="bytes:uh.v" uid="uh" uid_parent="R"/>
      <Node _name="Bundle By Name" inputs="input cluster:tr.v,png:uh.v" outputs="output cluster:bn.v" uid="bn" uid_parent="R" fields="png"/>
      <Tunnel _id="Out1" inputs="value:bn.v" mode="index" outputs="value:rr.v" uid="rr" uid_parent="R"/>
    </Structure>
    <Call target="RemoteVI Overlay Encode.vi" inputs="popups:rr.v" outputs="message:sut.v" uid="sut" uid_parent="L"/>
    <Call target="RemoteVI Test Bytes To Hex.vi" inputs="bytes:sut.v" outputs="hex:hx.v" uid="hx" uid_parent="L"/>
    <Tunnel _id="Out1" inputs="value:ub.name" mode="index" outputs="value:lab.v" uid="lab" uid_parent="L"/>
    <Tunnel _id="Out2" inputs="value:ub.message" mode="index" outputs="value:exp.v" uid="exp" uid_parent="L"/>
    <Tunnel _id="Out3" inputs="value:hx.v" mode="index" outputs="value:act.v" uid="act" uid_parent="L"/>
  </Structure>
  <Node _name="Not Equal?" inputs="x:exp.v,y:act.v" outputs="x != y?:neq.v" uid="neq" uid_parent="root"/>
  <Node _name="Boolean To (0\2C1)" inputs="Boolean:neq.v" outputs="0\2C 1:n01.v" uid="n01" uid_parent="root"/>
  <Node _name="Add Array Elements" inputs="numeric array:n01.v" outputs="sum:nsum.v" uid="nsum" uid_parent="root"/>
  <Indicator _name="labels" conIdx="4" connection="recommended" description="Vector names, one per vector." inputs="value:lab.v" type="array{string}" uid="o_lab" uid_parent="root" value="[]"/>
  <Indicator _name="expected" conIdx="6" connection="recommended" description="Expected result per vector, rendered as text." inputs="value:exp.v" type="array{string}" uid="o_exp" uid_parent="root" value="[]"/>
  <Indicator _name="actual" conIdx="8" connection="recommended" description="Actual result per vector, rendered the same way." inputs="value:act.v" type="array{string}" uid="o_act" uid_parent="root" value="[]"/>
  <Indicator _name="failures" conIdx="10" connection="recommended" description="Number of vectors whose expected and actual differ." inputs="value:nsum.v" type="int32" uid="o_fail" uid_parent="root" value="0"/>
</VI>
