<VI _name="RemoteVI Check Token Check.vi" description="Test support, generated by tests/caraya/build.py from tests/vectors/http.json (tokens) - do not edit. Calls RemoteVI Token Check.vi once per vector: query and token as in the vector (the vector's token, or empty for emptyToken); ok? is rendered T or F. Outputs, one element per vector: labels (the vector's name), expected (rendered from the vector), actual (the VI's result rendered the same way), and failures, the number of vectors whose expected and actual differ.">
  <Constant _name="vectors" outputs="value:cases.v" type="array{cluster{string.name,string.query,string.token,string.expect}}" uid="cases" uid_parent="root" value="[[only\20the\20token,t\3D3f9a0c1d2e4b5a6978879695a4b3c2d1,3f9a0c1d2e4b5a6978879695a4b3c2d1,T],[with\20a\20leading\20\3F,\3Ft\3D3f9a0c1d2e4b5a6978879695a4b3c2d1,3f9a0c1d2e4b5a6978879695a4b3c2d1,T],[among\20other\20parameters,x\3D1\26t\3D3f9a0c1d2e4b5a6978879695a4b3c2d1\26y\3D2,3f9a0c1d2e4b5a6978879695a4b3c2d1,T],[first\20t\20wins,t\3D3f9a0c1d2e4b5a6978879695a4b3c2d1\26t\3Dwrong,3f9a0c1d2e4b5a6978879695a4b3c2d1,T],[missing,x\3D1,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[empty\20query,,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[wrong\20token,t\3D3f9a0c1d2e4b5a6978879695a4b3c2d2,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[prefix\20only,t\3D3f9a0c1d,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[longer,t\3D3f9a0c1d2e4b5a6978879695a4b3c2d100,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[empty\20value,t\3D,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[other\20key\20ending\20in\20t,at\3D3f9a0c1d2e4b5a6978879695a4b3c2d1,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[uppercase\20key,T\3D3f9a0c1d2e4b5a6978879695a4b3c2d1,3f9a0c1d2e4b5a6978879695a4b3c2d1,F],[empty\20token\20never\20matches,t\3D,,F]]"/>
  <Structure _name="For Loop" count="" label="One vector" maxin="" maxout="" uid="L" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cases.v" mode="index" outputs="value:tc.v" uid="tc" uid_parent="L"/>
    <Node _name="Unbundle By Name" inputs="input cluster:tc.v" outputs="name:ub.name,query:ub.query,token:ub.token,expect:ub.expect" uid="ub" uid_parent="L" fields="name,query,token,expect"/>
