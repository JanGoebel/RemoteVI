<VI _name="RemoteVI Check Track Modifiers.vi" description="Test support, generated by tests/caraya/build.py from tests/vectors/translate.json (modifiers) - do not edit. Calls RemoteVI Track Modifiers.vi once per vector: the vector's input text goes through RemoteVI Parse Input.vi first, mods in is modsBefore, mods out is compared with modsAfter. Outputs, one element per vector: labels (the vector's name), expected (rendered from the vector), actual (the VI's result rendered the same way), and failures, the number of vectors whose expected and actual differ.">
  <Constant _name="vectors" outputs="value:cases.v" type="array{cluster{string.name,string.input,uint8.modsBefore,string.expect}}" uid="cases" uid_parent="root" value="[[Shift\20key\20down,k\20256\2016\201,0,1],[Shift\20key\20up,k\20257\2016\203221225473,1,0],[left\20Shift\20\28VK\5FLSHIFT\29\20down\20keeps\20Ctrl,k\20256\20160\201,2,3],[right\20Ctrl\20up,k\20257\20163\203238002689,3,1],[Alt\20down,k\20256\2018\201,0,4],[other\20key\20leaves\20mods,k\20256\2013\201,5,5],[char\20leaves\20mods,k\20258\201\201,2,2],[mouse\20with\20MK\5FSHIFT,m\20513\2010\2020\205,0,1],[mouse\20with\20MK\5FCONTROL\20keeps\20Alt\2C\20drops\20Shift,m\20512\2010\2020\208,5,6],[mouse\20without\20flags\20clears\20Shift\20and\20Ctrl,m\20514\2010\2020\200,3,0],[not\20allowed\20mouse\20message\20leaves\20mods,m\2016\201\201\200,3,3],[ack\20leaves\20mods,a\205,1,1]]"/>
  <Structure _name="For Loop" count="" label="One vector" maxin="" maxout="" uid="L" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cases.v" mode="index" outputs="value:tc.v" uid="tc" uid_parent="L"/>
    <Node _name="Unbundle By Name" inputs="input cluster:tc.v" outputs="name:ub.name,input:ub.input,modsBefore:ub.modsBefore,expect:ub.expect" uid="ub" uid_parent="L" fields="name,input,modsBefore,expect"/>
    <Call target="RemoteVI Parse Input.vi" inputs="text:ub.input" outputs="kind:pi.kind,msg:pi.msg,x:pi.x,y:pi.y,wParam:pi.wParam,lParam:pi.lParam,seq:pi.seq" uid="pi" uid_parent="L"/>
    <Call target="RemoteVI Track Modifiers.vi" inputs="kind:pi.kind,msg:pi.msg,wParam:pi.wParam,mods in:ub.modsBefore" outputs="mods out:sut.v" uid="sut" uid_parent="L"/>
    <Node _name="Number To Decimal String" inputs="number:sut.v" outputs="decimal integer string:dm.v" uid="dm" uid_parent="L"/>
    <Tunnel _id="Out1" inputs="value:ub.name" mode="index" outputs="value:lab.v" uid="lab" uid_parent="L"/>
    <Tunnel _id="Out2" inputs="value:ub.expect" mode="index" outputs="value:exp.v" uid="exp" uid_parent="L"/>
    <Tunnel _id="Out3" inputs="value:dm.v" mode="index" outputs="value:act.v" uid="act" uid_parent="L"/>
  </Structure>
  <Node _name="Not Equal?" inputs="x:exp.v,y:act.v" outputs="x != y?:neq.v" uid="neq" uid_parent="root"/>
  <Node _name="Boolean To (0\2C1)" inputs="Boolean:neq.v" outputs="0\2C 1:n01.v" uid="n01" uid_parent="root"/>
  <Node _name="Add Array Elements" inputs="numeric array:n01.v" outputs="sum:nsum.v" uid="nsum" uid_parent="root"/>
  <Indicator _name="labels" conIdx="4" connection="recommended" description="Vector names, one per vector." inputs="value:lab.v" type="array{string}" uid="o_lab" uid_parent="root" value="[]"/>
  <Indicator _name="expected" conIdx="6" connection="recommended" description="Expected result per vector, rendered as text." inputs="value:exp.v" type="array{string}" uid="o_exp" uid_parent="root" value="[]"/>
  <Indicator _name="actual" conIdx="8" connection="recommended" description="Actual result per vector, rendered the same way." inputs="value:act.v" type="array{string}" uid="o_act" uid_parent="root" value="[]"/>
  <Indicator _name="failures" conIdx="10" connection="recommended" description="Number of vectors whose expected and actual differ." inputs="value:nsum.v" type="int32" uid="o_fail" uid_parent="root" value="0"/>
</VI>
