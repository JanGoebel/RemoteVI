<VI _name="RemoteVI Check WS Encode Server Frame.vi" description="Test support, generated by tests/caraya/build.py from tests/vectors/websocket.json (serverFrames) - do not edit. Calls RemoteVI WS Encode Server Frame.vi once per vector: payload is the vector's hex, or payloadLength zero bytes where the vector gives only the header; the frame is compared as lowercase hex, only its first bytes where the vector gives a header. Outputs, one element per vector: labels (the vector's name), expected (rendered from the vector), actual (the VI's result rendered the same way), and failures, the number of vectors whose expected and actual differ.">
  <Constant _name="vectors" outputs="value:cases.v" type="array{cluster{string.name,uint8.opcode,string.payload,int32.zeros,string.expect,int32.cmp}}" uid="cases" uid_parent="root" value="[[text\20Hello\20\28RFC\206455\205\2E7\29,1,48656c6c6f,-1,810548656c6c6f,-1],[binary\20256\20bytes\20\28RFC\206455\205\2E7\29,2,,-1,,-1],[binary\2065536\20bytes\20header,2,,65536,827f0000000000010000,20],[close\201000,8,03e8,-1,880203e8,-1]]"/>
  <Structure _name="For Loop" count="" label="One vector" maxin="" maxout="" uid="L" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cases.v" mode="index" outputs="value:tc.v" uid="tc" uid_parent="L"/>
    <Node _name="Unbundle By Name" inputs="input cluster:tc.v" outputs="name:ub.name,opcode:ub.opcode,payload:ub.payload,zeros:ub.zeros,expect:ub.expect,cmp:ub.cmp" uid="ub" uid_parent="L" fields="name,opcode,payload,zeros,expect,cmp"/>
    <Call target="RemoteVI Test Hex To Bytes.vi" inputs="hex:ub.payload" outputs="bytes:uh.v" uid="uh" uid_parent="L"/>
    <Constant outputs="value:z8.v" type="uint8" uid="z8" uid_parent="L" value="0"/>
    <Node _name="Initialize Array" inputs="element:z8.v,dimension size:ub.zeros" outputs="initialized array:ia.v" uid="ia" uid_parent="L"/>
    <Node _name="Byte Array To String" inputs="unsigned byte array:ia.v" outputs="string:zs.v" uid="zs" uid_parent="L"/>
    <Constant outputs="value:z0.v" type="int32" uid="z0" uid_parent="L" value="0"/>
    <Node _name="Less?" inputs="x:ub.zeros,y:z0.v" outputs="x &lt; y?:hz.v" uid="hz" uid_parent="L"/>
    <Node _name="Select" inputs="t:uh.v,s:hz.v,f:zs.v" outputs="s? t\3Af:sp.v" uid="sp" uid_parent="L"/>
    <Call target="RemoteVI WS Encode Server Frame.vi" inputs="opcode:ub.opcode,payload:sp.v" outputs="frame:sut.v" uid="sut" uid_parent="L"/>
    <Call target="RemoteVI Test Bytes To Hex.vi" inputs="bytes:sut.v" outputs="hex:hx.v" uid="hx" uid_parent="L"/>
    <Node _name="String Length" inputs="string:hx.v" outputs="length:sl.v" uid="sl" uid_parent="L"/>
    <Node _name="Less?" inputs="x:ub.cmp,y:z0.v" outputs="x &lt; y?:hc.v" uid="hc" uid_parent="L"/>
    <Node _name="Select" inputs="t:sl.v,s:hc.v,f:ub.cmp" outputs="s? t\3Af:ln.v" uid="ln" uid_parent="L"/>
    <Node _name="String Subset" inputs="string:hx.v,offset (0):z0.v,length (rest):ln.v" outputs="substring:ss.v" uid="ss" uid_parent="L"/>
    <Tunnel _id="Out1" inputs="value:ub.name" mode="index" outputs="value:lab.v" uid="lab" uid_parent="L"/>
    <Tunnel _id="Out2" inputs="value:ub.expect" mode="index" outputs="value:exp.v" uid="exp" uid_parent="L"/>
    <Tunnel _id="Out3" inputs="value:ss.v" mode="index" outputs="value:act.v" uid="act" uid_parent="L"/>
  </Structure>
  <Node _name="Not Equal?" inputs="x:exp.v,y:act.v" outputs="x != y?:neq.v" uid="neq" uid_parent="root"/>
  <Node _name="Boolean To (0\2C1)" inputs="Boolean:neq.v" outputs="0\2C 1:n01.v" uid="n01" uid_parent="root"/>
  <Node _name="Add Array Elements" inputs="numeric array:n01.v" outputs="sum:nsum.v" uid="nsum" uid_parent="root"/>
  <Indicator _name="labels" conIdx="4" connection="recommended" description="Vector names, one per vector." inputs="value:lab.v" type="array{string}" uid="o_lab" uid_parent="root" value="[]"/>
  <Indicator _name="expected" conIdx="6" connection="recommended" description="Expected result per vector, rendered as text." inputs="value:exp.v" type="array{string}" uid="o_exp" uid_parent="root" value="[]"/>
  <Indicator _name="actual" conIdx="8" connection="recommended" description="Actual result per vector, rendered the same way." inputs="value:act.v" type="array{string}" uid="o_act" uid_parent="root" value="[]"/>
  <Indicator _name="failures" conIdx="10" connection="recommended" description="Number of vectors whose expected and actual differ." inputs="value:nsum.v" type="int32" uid="o_fail" uid_parent="root" value="0"/>
</VI>
