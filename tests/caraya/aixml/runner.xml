<VI _name="RemoteVI Caraya Runner.vi" description="Runs every RemoteVI Caraya unit test (generated by tests/caraya/build.py) with Caraya's Run Tests (Array Path), non-interactive, and writes a JUnit report. Test paths are relative to this VI, so the folder can move. Report Path empty: RemoteVI Caraya Report.xml beside this VI. Caraya answers 7002 in error out when a test failed - read the report for which one.">
  <Control _name="Report Path" conIdx="0" connection="recommended" description="JUnit report file, must end in .xml. Empty: RemoteVI Caraya Report.xml beside this VI." outputs="value:rp.v" type="path" uid="rp" uid_parent="root" value=""/>
  <Node _name="Current VI's Path" inputs="" outputs="path:cp.v" uid="cp" uid_parent="root"/>
  <Node _name="Strip Path" inputs="path:cp.v" outputs="stripped path:sp.v,name:" uid="sp" uid_parent="root"/>
  <Constant outputs="value:p0.v" type="path" uid="p0" uid_parent="root" value="unit\5CProtocol\5CTest\20Frame\20Encode\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p0.v" outputs="appended path:bp0.v" uid="bp0" uid_parent="root"/>
  <Constant outputs="value:p1.v" type="path" uid="p1" uid_parent="root" value="unit\5CProtocol\5CTest\20Overlay\20Encode\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p1.v" outputs="appended path:bp1.v" uid="bp1" uid_parent="root"/>
  <Constant outputs="value:p2.v" type="path" uid="p2" uid_parent="root" value="unit\5CProtocol\5CTest\20Window\20Frame\20Encode\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p2.v" outputs="appended path:bp2.v" uid="bp2" uid_parent="root"/>
  <Constant outputs="value:p3.v" type="path" uid="p3" uid_parent="root" value="unit\5CProtocol\5CTest\20Parse\20Input\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p3.v" outputs="appended path:bp3.v" uid="bp3" uid_parent="root"/>
  <Constant outputs="value:p4.v" type="path" uid="p4" uid_parent="root" value="unit\5CProtocol\5CTest\20WS\20Encode\20Server\20Frame\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p4.v" outputs="appended path:bp4.v" uid="bp4" uid_parent="root"/>
  <Constant outputs="value:p5.v" type="path" uid="p5" uid_parent="root" value="unit\5CProtocol\5CTest\20WS\20Decode\20Client\20Frame\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p5.v" outputs="appended path:bp5.v" uid="bp5" uid_parent="root"/>
  <Constant outputs="value:p6.v" type="path" uid="p6" uid_parent="root" value="unit\5CCapture\5CTest\20Dirty\20Rects\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p6.v" outputs="appended path:bp6.v" uid="bp6" uid_parent="root"/>
  <Constant outputs="value:p7.v" type="path" uid="p7" uid_parent="root" value="unit\5CInput\5CTest\20Translate\20Input\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p7.v" outputs="appended path:bp7.v" uid="bp7" uid_parent="root"/>
  <Constant outputs="value:p8.v" type="path" uid="p8" uid_parent="root" value="unit\5CInput\5CTest\20Track\20Modifiers\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p8.v" outputs="appended path:bp8.v" uid="bp8" uid_parent="root"/>
  <Constant outputs="value:p9.v" type="path" uid="p9" uid_parent="root" value="unit\5CProtocol\5CTest\20JSON\20String\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p9.v" outputs="appended path:bp9.v" uid="bp9" uid_parent="root"/>
  <Constant outputs="value:p10.v" type="path" uid="p10" uid_parent="root" value="unit\5CProtocol\5CTest\20Tips\20Message\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p10.v" outputs="appended path:bp10.v" uid="bp10" uid_parent="root"/>
  <Constant outputs="value:p11.v" type="path" uid="p11" uid_parent="root" value="unit\5CProtocol\5CTest\20Splitters\20Message\2Evi"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:p11.v" outputs="appended path:bp11.v" uid="bp11" uid_parent="root"/>
  <Node _name="Build Array" inputs="element:bp0.v,element:bp1.v,element:bp2.v,element:bp3.v,element:bp4.v,element:bp5.v,element:bp6.v,element:bp7.v,element:bp8.v,element:bp9.v,element:bp10.v,element:bp11.v" outputs="appended array:ba.v" uid="ba" uid_parent="root"/>
  <Constant outputs="value:dn.v" type="string" uid="dn" uid_parent="root" value="RemoteVI\20Caraya\20Report\2Exml"/>
  <Node _name="Build Path" inputs="base path:sp.v,name or relative path:dn.v" outputs="appended path:bd.v" uid="bd" uid_parent="root"/>
  <Node _name="Empty String/Path?" inputs="string/path:rp.v" outputs="empty?:ep.v" uid="ep" uid_parent="root"/>
  <Node _name="Select" inputs="t:bd.v,s:ep.v,f:rp.v" outputs="s? t\3Af:sel.v" uid="sel" uid_parent="root"/>
  <Constant _name="Interactive (T)" outputs="value:fi.v" type="bool" uid="fi" uid_parent="root" value="false"/>
  <Call adapt="true" instance="Caraya.lvlib\3ARun Test (Array Path).vi" target="Caraya.lvlib\3ARun Tests.vi" inputs="timeout (2000 ms):,Test Report:,Verbose:,Report Path:sel.v,error in:,Inspect Recursively (T):,Paths:ba.v,Interactive (T):fi.v" outputs="error out:run.err,Test Results:" uid="run" uid_parent="root"/>
  <Indicator _name="Report Path used" conIdx="4" connection="recommended" description="The JUnit report this run wrote." inputs="value:sel.v" type="path" uid="o_rp" uid_parent="root" value=""/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Caraya's error: 7002 when a test failed. Not a fault - read the report." inputs="value:run.err" type="cluster{bool.status,int32.code,string.source}" uid="o_err" uid_parent="root" value="[false,0,]"/>
</VI>
