<VI _name="RemoteVI Complex Fixture All Controls.vi" description="Helper of RemoteVI Complex Fixture.vi. Every control on Panel down to three levels\3A the top-level controls of all panes\2C the controls on their tab pages and in their clusters\2C and one level further (a cluster on a tab page). Errors of the property reads go to error out.">
  <FreeLabel comment="Top level plus two levels inside" uid="lbl" uid_parent="root"/>
  <Control _name="Panel" conIdx="0" connection="required" description="Front Panel of the VI." outputs="value:pa.value" type="ref{LV.Panel}" uid="pa" uid_parent="root" value=""/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Error chain in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Property Node" fields="read+Controls[]" inputs="reference:pa.value,error in (no error):ei.value" outputs="Controls[]:pcs.c,reference out:,error out:pcs.error out" type="{LV.Panel}" uid="pcs" uid_parent="root"/>
  <Structure _name="For Loop" count="" label="Level 1" maxin="" maxout="" uid="f1" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pcs.c" mode="index" outputs="value:c1.value" uid="c1" uid_parent="f1"/>
    <ShiftReg uid="sr1" uid_parent="f1">
      <Left inputs="value:pcs.error out" outputs="value:e1.value" uid="sr1l" uid_parent="sr1"/>
      <Right inputs="value:k1.error out" outputs="value:err1.value" uid="sr1r" uid_parent="sr1"/>
    </ShiftReg>
    <Call target="RemoteVI Complex Fixture Children.vi" inputs="Control:c1.value,error in:e1.value" outputs="Children:k1.Children,error out:k1.error out" uid="k1" uid_parent="f1"/>
    <Tunnel _id="Out1" inputs="value:k1.Children" mode="concat" outputs="value:lvl1.value" uid="lvl1" uid_parent="f1"/>
  </Structure>
  <Structure _name="For Loop" count="" label="Level 2" maxin="" maxout="" uid="f2" uid_parent="root">
    <Tunnel _id="In1" inputs="value:lvl1.value" mode="index" outputs="value:c2.value" uid="c2" uid_parent="f2"/>
    <ShiftReg uid="sr2" uid_parent="f2">
      <Left inputs="value:err1.value" outputs="value:e2.value" uid="sr2l" uid_parent="sr2"/>
      <Right inputs="value:k2.error out" outputs="value:err2.value" uid="sr2r" uid_parent="sr2"/>
    </ShiftReg>
    <Call target="RemoteVI Complex Fixture Children.vi" inputs="Control:c2.value,error in:e2.value" outputs="Children:k2.Children,error out:k2.error out" uid="k2" uid_parent="f2"/>
    <Tunnel _id="Out1" inputs="value:k2.Children" mode="concat" outputs="value:lvl2.value" uid="lvl2" uid_parent="f2"/>
  </Structure>
  <Node _name="Build Array" concat="true" inputs="array:pcs.c,array:lvl1.value,array:lvl2.value" outputs="appended array:ba.appended array" uid="ba" uid_parent="root"/>
  <Indicator _name="Controls" conIdx="4" connection="recommended" description="Top-level controls first\2C then those one level inside\2C then two levels inside." inputs="value:ba.appended array" type="array{ref{LV.Control}}" uid="co" uid_parent="root" value="[]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Errors of the property reads." inputs="value:err2.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
