<VI _name="RemoteVI Complex Fixture Paste.vi" description="Build tool of RemoteVI Complex Fixture.vi\3A run it ONCE after the graft (see compose_complex.py)\2C with the fixture idle. AIXML cannot create a tab control\2C a subpanel\2C a slide\2C a knob\2C a tree or a graph with cursors (the composer's slide and knob parts crash LabVIEW 2025 on load)\2C so this copies them from other VIs onto the fixture's panel\2C into the pane given by Pane (0 left\2C 1 toolbar\2C 2 main\2C the order of Panes[] on NI's splitter example) at Position\2C and relabels them\3A for each row of Donors\2C the control labelled Donor Labels is selected on the donor's panel\2C copied (Copy Selection) and pasted (Paste Selection with the pane)\2C then found on the fixture by its donor label and given its new label. Saves the fixture. Run Arrange afterwards.">
  <FreeLabel comment="Copy each donor control into its pane" uid="lbl" uid_parent="root"/>
  <Control _name="Fixture" conIdx="0" connection="required" description="Path of RemoteVI Complex Fixture.vi. Saved in place." outputs="value:fx.value" type="path" uid="fx" uid_parent="root" value=""/>
  <Control _name="Donors" conIdx="1" connection="required" description="Path of the VI to copy each control from." outputs="value:dn.value" type="array{path}" uid="dn" uid_parent="root" value="[]"/>
  <Control _name="Donor Labels" conIdx="2" connection="required" description="Label of the control on each donor." outputs="value:dl.value" type="array{string}" uid="dl" uid_parent="root" value="[]"/>
  <Control _name="Labels" conIdx="3" connection="required" description="New label of each pasted control." outputs="value:nl.value" type="array{string}" uid="nl" uid_parent="root" value="[]"/>
  <Control _name="Pane" conIdx="5" connection="required" description="Index in Panes[] of the fixture's panel for each control." outputs="value:pn.value" type="array{int32}" uid="pn" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Error chain in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Open VI Reference" inputs="vi path:fx.value,error in (no error):ei.value" outputs="vi reference:of.vi reference,error out:of.error out" uid="of" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Front Panel" inputs="reference:of.vi reference,error in (no error):of.error out" outputs="reference out:,error out:fpf.error out,Front Panel:fpf.fp" type="{LV.VI}" uid="fpf" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Panes[]" inputs="reference:fpf.fp,error in (no error):fpf.error out" outputs="reference out:,error out:pp.error out,Panes[]:pp.panes" type="{LV.Panel}" uid="pp" uid_parent="root"/>
  <Constant _name="paste at" outputs="value:pa.value" type="cluster{int32.Left,int32.Top}" uid="pa" uid_parent="root" value="[20,20]"/>
  <Structure _name="For Loop" count="" label="One donor control per iteration" maxin="" maxout="" uid="fl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:dn.value" mode="index" outputs="value:l_dn.value" uid="l_dn" uid_parent="fl"/>
    <Tunnel _id="In2" inputs="value:dl.value" mode="index" outputs="value:l_dl.value" uid="l_dl" uid_parent="fl"/>
    <Tunnel _id="In3" inputs="value:nl.value" mode="index" outputs="value:l_nl.value" uid="l_nl" uid_parent="fl"/>
    <Tunnel _id="In4" inputs="value:pn.value" mode="index" outputs="value:l_pn.value" uid="l_pn" uid_parent="fl"/>
    <Tunnel _id="In5" inputs="value:fpf.fp" outputs="value:l_fp.value" uid="l_fp" uid_parent="fl"/>
    <Tunnel _id="In6" inputs="value:pp.panes" outputs="value:l_pp.value" uid="l_pp" uid_parent="fl"/>
    <Tunnel _id="In7" inputs="value:pa.value" outputs="value:l_pa.value" uid="l_pa" uid_parent="fl"/>
    <ShiftReg uid="sre" uid_parent="fl">
      <Left inputs="value:pp.error out" outputs="value:le.value" uid="srel" uid_parent="sre"/>
      <Right inputs="value:cd.error out" outputs="value:loopErr.value" uid="srer" uid_parent="sre"/>
    </ShiftReg>
    <Node _name="Open VI Reference" inputs="vi path:l_dn.value,error in (no error):le.value" outputs="vi reference:od.vi reference,error out:od.error out" uid="od" uid_parent="fl"/>
    <Node _name="Property Node" fields="read+Front Panel" inputs="reference:od.vi reference,error in (no error):od.error out" outputs="reference out:,error out:dfp.error out,Front Panel:dfp.fp" type="{LV.VI}" uid="dfp" uid_parent="fl"/>
    <Call target="RemoteVI Fixture Find Control.vi" inputs="Panel:dfp.fp,label:l_dl.value,error in:dfp.error out" outputs="Control Ref:fd.Control Ref,error out:fd.error out" uid="fd" uid_parent="fl"/>
    <Node _name="Build Array" inputs="element:fd.Control Ref" outputs="appended array:sel.appended array" uid="sel" uid_parent="fl"/>
    <Node _name="Invoke Node" target="Make Selection" type="{LV.Panel}" inputs="reference:dfp.fp,error in (no error):fd.error out,Objects:sel.appended array" outputs="reference out:,error out:ms.error out" uid="ms" uid_parent="fl"/>
    <Node _name="Invoke Node" target="Copy Selection" type="{LV.Panel}" inputs="reference:dfp.fp,error in (no error):ms.error out" outputs="reference out:,error out:cp.error out" uid="cp" uid_parent="fl"/>
    <Node _name="Index Array" inputs="array:l_pp.value,index:l_pn.value" outputs="element:pane.element" uid="pane" uid_parent="fl"/>
    <Node _name="Invoke Node" target="Paste Selection" type="{LV.Panel}" inputs="reference:l_fp.value,error in (no error):cp.error out,Pos:l_pa.value,Pane:pane.element" outputs="reference out:,error out:ps.error out" uid="ps" uid_parent="fl"/>
    <Node _name="Invoke Node" target="Clear Selection" type="{LV.Panel}" inputs="reference:dfp.fp,error in (no error):ps.error out" outputs="reference out:,error out:cs.error out" uid="cs" uid_parent="fl"/>
    <Call target="RemoteVI Fixture Find Control.vi" inputs="Panel:l_fp.value,label:l_dl.value,error in:cs.error out" outputs="Control Ref:ft.Control Ref,error out:ft.error out" uid="ft" uid_parent="fl"/>
    <Node _name="Property Node" fields="write+Label.Text" inputs="reference:ft.Control Ref,error in (no error):ft.error out,Label.Text:l_nl.value" outputs="reference out:,error out:wl.error out" type="{LV.Control}" uid="wl" uid_parent="fl"/>
    <Node _name="Close Reference" inputs="reference:od.vi reference,error in (no error):wl.error out" outputs="error out:cd.error out" uid="cd" uid_parent="fl"/>
  </Structure>
  <Node _name="Invoke Node" target="Save.Instrument" type="{LV.VI}" inputs="reference:of.vi reference,error in (no error):loopErr.value" outputs="reference out:sv.reference out,error out:sv.error out" uid="sv" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:sv.reference out,error in (no error):sv.error out" outputs="error out:cr.error out" uid="cr" uid_parent="root"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Errors of the copies\2C the pastes and the save." inputs="value:cr.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
