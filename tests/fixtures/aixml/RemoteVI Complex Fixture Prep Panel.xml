<VI _name="RemoteVI Complex Fixture Prep Panel.vi" description="Build helper of RemoteVI Complex Fixture.vi (AIXML cannot create panes or splitter bars). Edits the VI at path - a COPY of NI's example Resizable Panel with Splitter Bars.vi - so that its panel keeps its three panes and its two splitter bars but holds no control and no decoration\3A every control and every decoration (the example's instructions) is deleted\2C and the VI is saved. Its diagram is left for lvai_graft_diagram (replaceDiagram) to discard.">
  <FreeLabel comment="Keep the panes\2C delete every control" uid="lbl" uid_parent="root"/>
  <Control _name="path" conIdx="0" connection="required" description="The copy to edit. Saved in place." outputs="value:p.value" type="path" uid="p" uid_parent="root" value=""/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Error chain in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Open VI Reference" inputs="vi path:p.value,error in (no error):ei.value" outputs="vi reference:ov.vi reference,error out:ov.error out" uid="ov" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Front Panel" inputs="reference:ov.vi reference,error in (no error):ov.error out" outputs="reference out:pv.reference out,error out:pv.error out,Front Panel:pv.fp" type="{LV.VI}" uid="pv" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Controls[]" inputs="reference:pv.fp,error in (no error):pv.error out" outputs="reference out:,error out:pc.error out,Controls[]:pc.c" type="{LV.Panel}" uid="pc" uid_parent="root"/>
  <Structure _name="For Loop" count="" label="Delete every control" maxin="" maxout="" uid="fc" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pc.c" mode="index" outputs="value:c.value" uid="c" uid_parent="fc"/>
    <ShiftReg uid="sre" uid_parent="fc">
      <Left inputs="value:pc.error out" outputs="value:le.value" uid="srel" uid_parent="sre"/>
      <Right inputs="value:del.error out" outputs="value:loopErr.value" uid="srer" uid_parent="sre"/>
    </ShiftReg>
    <Node _name="Invoke Node" target="Delete" type="{LV.GObject}" inputs="reference:c.value,error in (no error):le.value" outputs="error out:del.error out" uid="del" uid_parent="fc"/>
  </Structure>
  <Node _name="Property Node" fields="read+Decorations[]" inputs="reference:pv.fp,error in (no error):loopErr.value" outputs="reference out:,error out:pd.error out,Decorations[]:pd.d" type="{LV.Panel}" uid="pd" uid_parent="root"/>
  <Structure _name="For Loop" count="" label="Delete every decoration" maxin="" maxout="" uid="fd" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pd.d" mode="index" outputs="value:d.value" uid="d" uid_parent="fd"/>
    <ShiftReg uid="srd" uid_parent="fd">
      <Left inputs="value:pd.error out" outputs="value:de.value" uid="srdl" uid_parent="srd"/>
      <Right inputs="value:dd.error out" outputs="value:decErr.value" uid="srdr" uid_parent="srd"/>
    </ShiftReg>
    <Node _name="Invoke Node" target="Delete" type="{LV.GObject}" inputs="reference:d.value,error in (no error):de.value" outputs="error out:dd.error out" uid="dd" uid_parent="fd"/>
  </Structure>
  <Node _name="Invoke Node" target="Save.Instrument" type="{LV.VI}" inputs="reference:pv.reference out,error in (no error):decErr.value" outputs="reference out:sv.reference out,error out:sv.error out" uid="sv" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:sv.reference out,error in (no error):sv.error out" outputs="error out:cr.error out" uid="cr" uid_parent="root"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Errors of the edit and the save." inputs="value:cr.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
