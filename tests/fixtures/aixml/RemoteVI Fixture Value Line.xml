<VI _name="RemoteVI Fixture Value Line.vi" description="Event-log helper of RemoteVI Fixture.vi. Builds one value line of the log\3A value TAB label TAB value LF\2C with every line feed inside value written as the two characters \5Cn so the line stays one line. error in is passed through unchanged.">
  <FreeLabel comment="value TAB label TAB value LF" uid="lbl" uid_parent="root"/>
  <Control _name="label" conIdx="0" connection="required" description="Label of the control whose value changed." outputs="value:lb.value" type="string" uid="lb" uid_parent="root" value=""/>
  <Control _name="value" conIdx="5" connection="required" description="The new value\2C already as text." outputs="value:va.value" type="string" uid="va" uid_parent="root" value=""/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Passed through to error out." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant _name="kind" outputs="value:ck.value" type="string" uid="ck" uid_parent="root" value="value"/>
  <Constant _name="tab" outputs="value:ct.value" type="string" uid="ct" uid_parent="root" value="\09"/>
  <Constant _name="line feed" outputs="value:cl.value" type="string" uid="cl" uid_parent="root" value="\0A"/>
  <Constant _name="escaped line feed" outputs="value:cn.value" type="string" uid="cn" uid_parent="root" value="\5Cn"/>
  <Constant _name="replace all" outputs="value:ra.value" type="bool" uid="ra" uid_parent="root" value="true"/>
  <Node _name="Search and Replace String" inputs="input string:va.value,search string:cl.value,replace string:cn.value,replace all?:ra.value" outputs="result string:sr.result string" uid="sr" uid_parent="root"/>
  <Node _name="Concatenate Strings" inputs="string:ck.value,string:ct.value,string:lb.value,string:ct.value,string:sr.result string,string:cl.value" outputs="concatenated string:cat.concatenated string" uid="cat" uid_parent="root"/>
  <Indicator _name="line" conIdx="4" connection="recommended" description="One log line\2C terminated by a line feed." inputs="value:cat.concatenated string" type="string" uid="li" uid_parent="root" value=""/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in\2C unchanged." inputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
