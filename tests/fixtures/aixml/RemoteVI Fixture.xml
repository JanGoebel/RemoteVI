<VI _name="RemoteVI Fixture.vi" description="Event-logging test fixture of the RemoteVI integration tests (tests\5Clv). At start it truncates or creates the log file (Log Path\2C or RemoteVI Fixture.log in the system temp directory when Log Path is empty)\2C writes one layout line per logged control with its body rectangle in panel-image coordinates\2C publishes its own front panel with RemoteVI Start.vi on port 8089 and writes ready. An event loop then appends one tab-separated line per handled event - value changes of Switch\2C Button\2C Number\2C Text\2C Mode and Tab (Tab registered dynamically\2C because the tab control is pasted in after generation)\2C mouse down and up on Switch\2C Button\2C Number and Text\2C mouse enter and leave on Button\2C key down on Text and Number\2C double click on List with the row\2C mouse wheel on Number with the delta\2C and the selection in the run-time shortcut menu of Text by item tag (the menu is rebuilt in Shortcut Menu Activation? as Top and More with the submenu item Deep) - in the format documented in tests\5Clv\5Charness.mjs\2C while a parallel loop redraws a moving sine on Graph every 50 ms. Stop ends both loops\2C the log is closed and RemoteVI Stop.vi releases the port. error out merges every error path.">
  <FreeLabel comment="One log line per handled event" uid="lbl" uid_parent="root"/>
  <Control _name="Log Path" description="Where the event log is written. Empty: RemoteVI Fixture.log in the system temp directory. The file is truncated at start." outputs="value:lp.value" type="path" uid="lp" uid_parent="root" value=""/>
  <Call target="RemoteVI Fixture Log Path.vi" inputs="Log Path:lp.value,error in:" outputs="path:lpath.path,error out:" uid="lpath" uid_parent="root"/>
  <Constant _name="Notifier Type" outputs="value:nt.value" type="bool" uid="nt" uid_parent="root" value="false"/>
  <Node _name="Obtain Notifier" inputs="name (unnamed):,notification data type:nt.value,create if not found? (T):,error in (no error):" outputs="notifier out:obt.notifier out,created new?:,error out:obt.error out" uid="obt" uid_parent="root"/>
  <Constant _name="replace or create" outputs="value:op.value" type="uint16{open,replace,create,open or create,replace or create,replace or create with confirmation}" uid="op" uid_parent="root" value="4"/>
  <Node _name="Open/Create/Replace File" inputs="file path (use dialog):lpath.path,operation (0\3Aopen):op.value,error in:obt.error out" outputs="refnum out:of.refnum out,error out:of.error out" uid="of" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Front Panel,read+Front Panel Window\3AOrigin" inputs="reference:,error in (no error):" outputs="Front Panel:vp.fp,Front Panel Window\3AOrigin:vp.org,reference out:,error out:vp.error out" type="{LV.VI}" uid="vp" uid_parent="root"/>
  <Call target="RemoteVI Fixture Layout.vi" inputs="Panel:vp.fp,Origin:vp.org,error in:vp.error out" outputs="layout:lay.layout,error out:lay.error out" uid="lay" uid_parent="root"/>
  <Constant _name="tab label" outputs="value:tbl.value" type="string" uid="tbl" uid_parent="root" value="Tab"/>
  <Call target="RemoteVI Fixture Find Control.vi" inputs="Panel:vp.fp,label:tbl.value,error in:lay.error out" outputs="Control Ref:fc.Control Ref,error out:fc.error out" uid="fc" uid_parent="root"/>
  <Node _name="Register For Events" inputs="event registration refnum:,error in (no error):fc.error out,event source:fc.Control Ref" outputs="event registration refnum:reg.event registration refnum,error out:reg.error out" uid="reg" uid_parent="root"/>
  <Constant _name="port" outputs="value:port.value" type="uint16" uid="port" uid_parent="root" value="8089"/>
  <Call target="../../source/API/RemoteVI Start.vi" inputs="port:port.value,error in:of.error out" outputs="URL:,error out:st.error out" uid="st" uid_parent="root"/>
  <Constant _name="ready line" outputs="value:rl.value" type="string" uid="rl" uid_parent="root" value="ready\0A"/>
  <Node _name="Concatenate Strings" inputs="string:lay.layout,string:rl.value" outputs="concatenated string:lr.concatenated string" uid="lr" uid_parent="root"/>
  <Node _name="Write to Text File" inputs="file (use dialog):of.refnum out,text:lr.concatenated string,error in:st.error out" outputs="refnum out:w2.refnum out,error out:w2.error out" uid="w2" uid_parent="root"/>

  <Structure _name="While Loop" count="" label="Event loop - log every event" uid="evl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:obt.notifier out" outputs="value:evN.value" uid="evN" uid_parent="evl"/>
    <Tunnel _id="In2" inputs="value:w2.refnum out" outputs="value:evF.value" uid="evF" uid_parent="evl"/>
    <Tunnel _id="In3" inputs="value:reg.event registration refnum" outputs="value:evR.value" uid="evR" uid_parent="evl"/>
    <ShiftReg uid="srE" uid_parent="evl">
      <Left inputs="value:w2.error out" outputs="value:evE.value" uid="evEl" uid_parent="srE"/>
      <Right inputs="value:wl.error out" outputs="value:evErr.value" uid="evEr" uid_parent="srE"/>
    </ShiftReg>
    <Structure _name="Event Structure" uid="ev" uid_parent="evl">
      <Tunnel _id="In1" inputs="value:evN.value" uid="evI1" uid_parent="ev"/>
      <Tunnel _id="In2" inputs="value:evR.value" uid="evI2" uid_parent="ev"/>

      <CaseFrame selector=" &quot;Switch&quot;, &quot;Button&quot;, &quot;Number&quot;, &quot;Text&quot;\3A Mouse Down " uid="fmd" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fmdI1" uid_parent="fmd"/>
        <Tunnel _id="In2" outputs="value:" uid="fmdI2" uid_parent="fmd"/>
        <Node _name="Event Data Node" fields="CtlRef,Coords,Button,PlatMods" outputs="CtlRef:edmd.CtlRef,Coords:edmd.Coords,Button:edmd.Button,PlatMods:edmd.PlatMods" uid="edmd" uid_parent="fmd"/>
        <Constant _name="kind" outputs="value:kmd.value" type="string" uid="kmd" uid_parent="fmd" value="mousedown"/>
        <Call target="RemoteVI Fixture Mouse Line.vi" inputs="kind:kmd.value,CtlRef:edmd.CtlRef,Coords:edmd.Coords,Button:edmd.Button,PlatMods:edmd.PlatMods,error in:" outputs="line:cmd.line,error out:" uid="cmd" uid_parent="fmd"/>
        <Tunnel _id="Out1" inputs="value:" uid="fmdO1" uid_parent="fmd"/>
        <Tunnel _id="Out2" inputs="value:cmd.line" uid="fmdO2" uid_parent="fmd"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Switch&quot;, &quot;Button&quot;, &quot;Number&quot;, &quot;Text&quot;\3A Mouse Up " uid="fmu" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fmuI1" uid_parent="fmu"/>
        <Tunnel _id="In2" outputs="value:" uid="fmuI2" uid_parent="fmu"/>
        <Node _name="Event Data Node" fields="CtlRef,Coords,Button,PlatMods" outputs="CtlRef:edmu.CtlRef,Coords:edmu.Coords,Button:edmu.Button,PlatMods:edmu.PlatMods" uid="edmu" uid_parent="fmu"/>
        <Constant _name="kind" outputs="value:kmu.value" type="string" uid="kmu" uid_parent="fmu" value="mouseup"/>
        <Call target="RemoteVI Fixture Mouse Line.vi" inputs="kind:kmu.value,CtlRef:edmu.CtlRef,Coords:edmu.Coords,Button:edmu.Button,PlatMods:edmu.PlatMods,error in:" outputs="line:cmu.line,error out:" uid="cmu" uid_parent="fmu"/>
        <Tunnel _id="Out1" inputs="value:" uid="fmuO1" uid_parent="fmu"/>
        <Tunnel _id="Out2" inputs="value:cmu.line" uid="fmuO2" uid_parent="fmu"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Button&quot;\3A Mouse Enter " uid="fme" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fmeI1" uid_parent="fme"/>
        <Tunnel _id="In2" outputs="value:" uid="fmeI2" uid_parent="fme"/>
        <Constant _name="enter line" outputs="value:kme.value" type="string" uid="kme" uid_parent="fme" value="enter\09Button\0A"/>
        <Tunnel _id="Out1" inputs="value:" uid="fmeO1" uid_parent="fme"/>
        <Tunnel _id="Out2" inputs="value:kme.value" uid="fmeO2" uid_parent="fme"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Button&quot;\3A Mouse Leave " uid="fml" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fmlI1" uid_parent="fml"/>
        <Tunnel _id="In2" outputs="value:" uid="fmlI2" uid_parent="fml"/>
        <Constant _name="leave line" outputs="value:kml.value" type="string" uid="kml" uid_parent="fml" value="leave\09Button\0A"/>
        <Tunnel _id="Out1" inputs="value:" uid="fmlO1" uid_parent="fml"/>
        <Tunnel _id="Out2" inputs="value:kml.value" uid="fmlO2" uid_parent="fml"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Text&quot;, &quot;Number&quot;\3A Key Down " uid="fkd" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fkdI1" uid_parent="fkd"/>
        <Tunnel _id="In2" outputs="value:" uid="fkdI2" uid_parent="fkd"/>
        <Node _name="Event Data Node" fields="CtlRef,Char,VKey,PlatMods" outputs="CtlRef:edkd.CtlRef,Char:edkd.Char,VKey:edkd.VKey,PlatMods:edkd.PlatMods" uid="edkd" uid_parent="fkd"/>
        <Constant _name="item name" outputs="value:fsk.value" type="string" uid="fsk" uid_parent="fkd" value="%s"/>
        <Node _name="Format Into String" inputs="format string:fsk.value,input 1:edkd.VKey" outputs="resulting string:vkn.resulting string,error out:" uid="vkn" uid_parent="fkd"/>
        <Call target="RemoteVI Fixture Key Line.vi" inputs="CtlRef:edkd.CtlRef,Char:edkd.Char,VKey:vkn.resulting string,PlatMods:edkd.PlatMods,error in:" outputs="line:ckd.line,error out:" uid="ckd" uid_parent="fkd"/>
        <Tunnel _id="Out1" inputs="value:" uid="fkdO1" uid_parent="fkd"/>
        <Tunnel _id="Out2" inputs="value:ckd.line" uid="fkdO2" uid_parent="fkd"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Switch&quot;\3A Value Change " uid="fsw" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fswI1" uid_parent="fsw"/>
        <Tunnel _id="In2" outputs="value:" uid="fswI2" uid_parent="fsw"/>
        <Control _name="Switch" description="Switch when pressed. Its Value Change\2C Mouse Down and Mouse Up are logged." outputs="value:sw.value" type="bool" uid="sw" uid_parent="fsw" value="false"/>
        <Constant _name="label" outputs="value:lsw.value" type="string" uid="lsw" uid_parent="fsw" value="Switch"/>
        <Constant _name="TRUE" outputs="value:tsw.value" type="string" uid="tsw" uid_parent="fsw" value="TRUE"/>
        <Constant _name="FALSE" outputs="value:fsw2.value" type="string" uid="fsw2" uid_parent="fsw" value="FALSE"/>
        <Node _name="Select" inputs="t:tsw.value,s:sw.value,f:fsw2.value" outputs="s? t\3Af:ssw.s? t\3Af" uid="ssw" uid_parent="fsw"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:lsw.value,value:ssw.s? t\3Af,error in:" outputs="line:csw.line,error out:" uid="csw" uid_parent="fsw"/>
        <Tunnel _id="Out1" inputs="value:" uid="fswO1" uid_parent="fsw"/>
        <Tunnel _id="Out2" inputs="value:csw.line" uid="fswO2" uid_parent="fsw"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Button&quot;\3A Value Change " uid="fbt" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fbtI1" uid_parent="fbt"/>
        <Tunnel _id="In2" outputs="value:" uid="fbtI2" uid_parent="fbt"/>
        <Control _name="Button" description="Latched OK button\3B read in its own frame so it resets. Its Value Change\2C mouse and enter/leave events are logged." outputs="value:bt.value" style="latched" type="bool" uid="bt" uid_parent="fbt" value="false"/>
        <Constant _name="label" outputs="value:lbt.value" type="string" uid="lbt" uid_parent="fbt" value="Button"/>
        <Constant _name="TRUE" outputs="value:tbt.value" type="string" uid="tbt" uid_parent="fbt" value="TRUE"/>
        <Constant _name="FALSE" outputs="value:fbt2.value" type="string" uid="fbt2" uid_parent="fbt" value="FALSE"/>
        <Node _name="Select" inputs="t:tbt.value,s:bt.value,f:fbt2.value" outputs="s? t\3Af:sbt.s? t\3Af" uid="sbt" uid_parent="fbt"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:lbt.value,value:sbt.s? t\3Af,error in:" outputs="line:cbt.line,error out:" uid="cbt" uid_parent="fbt"/>
        <Tunnel _id="Out1" inputs="value:" uid="fbtO1" uid_parent="fbt"/>
        <Tunnel _id="Out2" inputs="value:cbt.line" uid="fbtO2" uid_parent="fbt"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Number&quot;\3A Value Change " uid="fnu" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fnuI1" uid_parent="fnu"/>
        <Tunnel _id="In2" outputs="value:" uid="fnuI2" uid_parent="fnu"/>
        <Control _name="Number" description="DBL numeric. Its Value Change (as %g)\2C mouse and key events are logged." outputs="value:nu.value" type="double" uid="nu" uid_parent="fnu" value="0"/>
        <Constant _name="label" outputs="value:lnu.value" type="string" uid="lnu" uid_parent="fnu" value="Number"/>
        <Constant _name="format" outputs="value:fnu2.value" type="string" uid="fnu2" uid_parent="fnu" value="%.;%#g"/>
        <Node _name="Format Into String" inputs="format string:fnu2.value,input 1:nu.value" outputs="resulting string:snu.resulting string,error out:" uid="snu" uid_parent="fnu"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:lnu.value,value:snu.resulting string,error in:" outputs="line:cnu.line,error out:" uid="cnu" uid_parent="fnu"/>
        <Tunnel _id="Out1" inputs="value:" uid="fnuO1" uid_parent="fnu"/>
        <Tunnel _id="Out2" inputs="value:cnu.line" uid="fnuO2" uid_parent="fnu"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Text&quot;\3A Value Change " uid="ftx" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="ftxI1" uid_parent="ftx"/>
        <Tunnel _id="In2" outputs="value:" uid="ftxI2" uid_parent="ftx"/>
        <Control _name="Text" description="Single-line string. Its Value Change\2C mouse and key events are logged." outputs="value:tx.value" type="string" uid="tx" uid_parent="ftx" value=""/>
        <Constant _name="label" outputs="value:ltx.value" type="string" uid="ltx" uid_parent="ftx" value="Text"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:ltx.value,value:tx.value,error in:" outputs="line:ctx.line,error out:" uid="ctx" uid_parent="ftx"/>
        <Tunnel _id="Out1" inputs="value:" uid="ftxO1" uid_parent="ftx"/>
        <Tunnel _id="Out2" inputs="value:ctx.line" uid="ftxO2" uid_parent="ftx"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Mode&quot;\3A Value Change " uid="fmo" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fmoI1" uid_parent="fmo"/>
        <Tunnel _id="In2" outputs="value:" uid="fmoI2" uid_parent="fmo"/>
        <Control _name="Mode" description="Text ring Off\2C Slow\2C Fast. Its Value Change is logged by item text." items="Off,Slow,Fast" outputs="value:mo.value" style="Ring" type="int32" uid="mo" uid_parent="fmo" value="0" values="[0,1,2]"/>
        <Constant _name="label" outputs="value:lmo.value" type="string" uid="lmo" uid_parent="fmo" value="Mode"/>
        <Constant _name="item texts" outputs="value:imo.value" type="array{string}" uid="imo" uid_parent="fmo" value="[Off,Slow,Fast]"/>
        <Node _name="Index Array" inputs="array:imo.value,index:mo.value" outputs="element:smo.element" uid="smo" uid_parent="fmo"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:lmo.value,value:smo.element,error in:" outputs="line:cmo.line,error out:" uid="cmo" uid_parent="fmo"/>
        <Tunnel _id="Out1" inputs="value:" uid="fmoO1" uid_parent="fmo"/>
        <Tunnel _id="Out2" inputs="value:cmo.line" uid="fmoO2" uid_parent="fmo"/>
      </CaseFrame>

      <CaseFrame selector=" &lt;Control Ref&gt;\3A Value Change " uid="fta" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="ftaI1" uid_parent="fta"/>
        <Tunnel _id="In2" outputs="value:" uid="ftaI2" uid_parent="fta"/>
        <Node _name="Event Data Node" fields="NewVal" outputs="NewVal:edta.NewVal" uid="edta" uid_parent="fta"/>
        <Constant _name="tab type" outputs="value:tty.value" type="uint32{One,Two}" uid="tty" uid_parent="fta" value="0"/>
        <Node _name="Variant To Data" inputs="variant:edta.NewVal,type:tty.value" outputs="data:vtd.data,error out:" uid="vtd" uid_parent="fta"/>
        <Constant _name="label" outputs="value:lta.value" type="string" uid="lta" uid_parent="fta" value="Tab"/>
        <Constant _name="item name" outputs="value:fta2.value" type="string" uid="fta2" uid_parent="fta" value="%s"/>
        <Node _name="Format Into String" inputs="format string:fta2.value,input 1:vtd.data" outputs="resulting string:sta.resulting string,error out:" uid="sta" uid_parent="fta"/>
        <Call target="RemoteVI Fixture Value Line.vi" inputs="label:lta.value,value:sta.resulting string,error in:" outputs="line:cta.line,error out:" uid="cta" uid_parent="fta"/>
        <Tunnel _id="Out1" inputs="value:" uid="ftaO1" uid_parent="fta"/>
        <Tunnel _id="Out2" inputs="value:cta.line" uid="ftaO2" uid_parent="fta"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;List&quot;\3A Double Click " uid="fdc" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fdcI1" uid_parent="fdc"/>
        <Tunnel _id="In2" outputs="value:" uid="fdcI2" uid_parent="fdc"/>
        <Control _name="List" description="Single-column multicolumn listbox (system style) with four rows\2C items set by RemoteVI Fixture Arrange.vi. Its Double Click is logged with the row." outputs="value:" style="Listbox" type="int32" uid="lst" uid_parent="fdc" value="0"/>
        <Node _name="Event Data Node" fields="CtlRef,Row" outputs="CtlRef:,Row:eddc.Row" uid="eddc" uid_parent="fdc"/>
        <Constant _name="dblclick line" outputs="value:fdc2.value" type="string" uid="fdc2" uid_parent="fdc" value="dblclick\09List\09%d\0A"/>
        <Node _name="Format Into String" inputs="format string:fdc2.value,input 1:eddc.Row" outputs="resulting string:sdc.resulting string,error out:" uid="sdc" uid_parent="fdc"/>
        <Tunnel _id="Out1" inputs="value:" uid="fdcO1" uid_parent="fdc"/>
        <Tunnel _id="Out2" inputs="value:sdc.resulting string" uid="fdcO2" uid_parent="fdc"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Number&quot;\3A Mouse Wheel " uid="fwh" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fwhI1" uid_parent="fwh"/>
        <Tunnel _id="In2" outputs="value:" uid="fwhI2" uid_parent="fwh"/>
        <Node _name="Event Data Node" fields="CtlRef,Delta" outputs="CtlRef:,Delta:edwh.Delta" uid="edwh" uid_parent="fwh"/>
        <Constant _name="wheel line" outputs="value:fwh2.value" type="string" uid="fwh2" uid_parent="fwh" value="wheel\09Number\09%d\0A"/>
        <Node _name="Format Into String" inputs="format string:fwh2.value,input 1:edwh.Delta" outputs="resulting string:swh.resulting string,error out:" uid="swh" uid_parent="fwh"/>
        <Tunnel _id="Out1" inputs="value:" uid="fwhO1" uid_parent="fwh"/>
        <Tunnel _id="Out2" inputs="value:swh.resulting string" uid="fwhO2" uid_parent="fwh"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Text&quot;\3A Shortcut Menu Activation? " uid="fsa" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fsaI1" uid_parent="fsa"/>
        <Tunnel _id="In2" outputs="value:" uid="fsaI2" uid_parent="fsa"/>
        <Node _name="Event Data Node" fields="MenuRef" outputs="MenuRef:edsa.MenuRef" uid="edsa" uid_parent="fsa"/>
        <Node _name="Delete Menu Items" inputs="menu reference:edsa.MenuRef,menu tag:,items:,error in (no error):" outputs="menu reference out:dmi.menu reference out,error out:dmi.error out" uid="dmi" uid_parent="fsa"/>
        <Constant _name="top items" outputs="value:tpi.value" type="array{string}" uid="tpi" uid_parent="fsa" value="[Top,More]"/>
        <Node _name="Insert Menu Items" inputs="menu reference:dmi.menu reference out,item names:tpi.value,item tags:tpi.value,error in (no error):dmi.error out,menu tag:,after item:" outputs="menu reference out:imt.menu reference out,item tags out:,error out:imt.error out" uid="imt" uid_parent="fsa"/>
        <Constant _name="submenu items" outputs="value:sbi.value" type="array{string}" uid="sbi" uid_parent="fsa" value="[Deep]"/>
        <Constant _name="submenu tag" outputs="value:sbt.value" type="string" uid="sbt" uid_parent="fsa" value="More"/>
        <Node _name="Insert Menu Items" inputs="menu reference:imt.menu reference out,item names:sbi.value,item tags:sbi.value,error in (no error):imt.error out,menu tag:sbt.value,after item:" outputs="menu reference out:,item tags out:,error out:" uid="ims" uid_parent="fsa"/>
        <Tunnel _id="Out1" inputs="value:" uid="fsaO1" uid_parent="fsa"/>
        <Tunnel _id="Out2" inputs="value:" uid="fsaO2" uid_parent="fsa"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Text&quot;\3A Shortcut Menu Selection (User) " uid="fss" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:" uid="fssI1" uid_parent="fss"/>
        <Tunnel _id="In2" outputs="value:" uid="fssI2" uid_parent="fss"/>
        <Node _name="Event Data Node" fields="ItemTag" outputs="ItemTag:edss.ItemTag" uid="edss" uid_parent="fss"/>
        <Constant _name="menu kind" outputs="value:kss.value" type="string" uid="kss" uid_parent="fss" value="menu\09Text\09"/>
        <Constant _name="line feed" outputs="value:lfss.value" type="string" uid="lfss" uid_parent="fss" value="\0A"/>
        <Node _name="Concatenate Strings" inputs="string:kss.value,string:edss.ItemTag,string:lfss.value" outputs="concatenated string:css.concatenated string" uid="css" uid_parent="fss"/>
        <Tunnel _id="Out1" inputs="value:" uid="fssO1" uid_parent="fss"/>
        <Tunnel _id="Out2" inputs="value:css.concatenated string" uid="fssO2" uid_parent="fss"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Stop&quot;\3A Value Change " uid="fst" uid_parent="ev">
        <Tunnel _id="In1" outputs="value:stN.value" uid="stN" uid_parent="fst"/>
        <Tunnel _id="In2" outputs="value:" uid="fstI2" uid_parent="fst"/>
        <Control _name="Stop" description="Latched button that ends the fixture." outputs="value:stop.value" style="latched" type="bool" uid="stop" uid_parent="fst" value="false"/>
        <Node _name="Send Notification" inputs="notifier:stN.value,notification:stop.value,error in (no error):" outputs="notifier out:,error out:" uid="snd" uid_parent="fst"/>
        <Tunnel _id="Out1" inputs="value:stop.value" uid="fstO1" uid_parent="fst"/>
        <Tunnel _id="Out2" inputs="value:" uid="fstO2" uid_parent="fst"/>
      </CaseFrame>
      <Tunnel _id="Out1" cond="true" outputs="value:evStop.value" uid="evStop" uid_parent="ev"/>
      <Tunnel _id="Out2" cond="true" outputs="value:evLine.value" uid="evLine" uid_parent="ev"/>
    </Structure>
    <Node _name="Write to Text File" inputs="file (use dialog):evF.value,text:evLine.value,error in:evE.value" outputs="refnum out:,error out:wl.error out" uid="wl" uid_parent="evl"/>
    <Condition inputs="value:evStop.value" uid="evlCond" uid_parent="evl" value="stop"/>
    <Tunnel _id="Out1" inputs="value:evR.value" outputs="value:evRo.value" uid="evRo" uid_parent="evl"/>
