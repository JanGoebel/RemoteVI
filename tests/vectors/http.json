{
 "description": "Request heads (latin1 text) and the expected parse result or HTTP error status.",
 "limits": {
  "maxHeadBytes": 8192,
  "maxHeaders": 32,
  "maxPathBytes": 1024
 },
 "cases": [
  {
   "name": "websocket upgrade",
   "head": "GET /ws HTTP/1.1\r\nHost: 127.0.0.1:8080\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n",
   "path": "/ws",
   "upgrade": true
  },
  {
   "name": "static file with query",
   "head": "GET /js/client.js?v=1 HTTP/1.1\r\nHost: x\r\n\r\n",
   "path": "/js/client.js",
   "upgrade": false
  },
  {
   "name": "POST rejected",
   "head": "POST / HTTP/1.1\r\nHost: x\r\n\r\n",
   "status": 405
  },
  {
   "name": "HTTP/2 preface rejected",
   "head": "PRI * HTTP/2.0\r\n\r\n",
   "status": 505
  },
  {
   "name": "absolute-form rejected",
   "head": "GET http://evil/ HTTP/1.1\r\nHost: x\r\n\r\n",
   "status": 400
  },
  {
   "name": "garbage request line",
