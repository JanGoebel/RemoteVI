<VI _name="RemoteVI Share Rows.vi" description="RemoteVI Server's list of hosted shares\3A one listbox row per share of status (RemoteVI Status.vi) - shared (target and kind)\2C port\2C reach (this computer or whole network\2C and view only) and clients (their number\2C or stopped when the share's loop no longer runs) - and the ports. Pure.">
  <Control _name="status" conIdx="0" connection="required" description="RemoteVI Status.vi's servers." outputs="value:st.value" type="array{cluster{uint16.port,string.url,string.target,string.kind,bool.whole network,bool.running,double.uptime s,array{cluster{string.address,double.connected s,double.idle s}}.clients,double.fps,double.kB per s,uint32.frames,double.latency ms,bool.view only,string.last error,uint64.hWnd}}" uid="st" uid_parent="root" value="[]"/>
  <Constant outputs="value:tfmt.value" type="string" uid="tfmt" uid_parent="root" value="%s (%s)"/>
  <Constant outputs="value:here.value" type="string" uid="here" uid_parent="root" value="this computer"/>
  <Constant outputs="value:net.value" type="string" uid="net" uid_parent="root" value="whole network"/>
  <Constant outputs="value:vo.value" type="string" uid="vo" uid_parent="root" value="\2C view only"/>
  <Constant outputs="value:none.value" type="string" uid="none" uid_parent="root" value=""/>
  <Constant outputs="value:stopped.value" type="string" uid="stopped" uid_parent="root" value="stopped"/>
  <Structure _name="For Loop" count="" label="One row per share" maxin="" maxout="" uid="fl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:st.value" mode="index" outputs="value:s.value" uid="s" uid_parent="fl"/>
    <Tunnel _id="In2" inputs="value:tfmt.value" outputs="value:l_tf.value" uid="l_tf" uid_parent="fl"/>
    <Tunnel _id="In3" inputs="value:here.value" outputs="value:l_here.value" uid="l_here" uid_parent="fl"/>
    <Tunnel _id="In4" inputs="value:net.value" outputs="value:l_net.value" uid="l_net" uid_parent="fl"/>
    <Tunnel _id="In5" inputs="value:vo.value" outputs="value:l_vo.value" uid="l_vo" uid_parent="fl"/>
    <Tunnel _id="In6" inputs="value:none.value" outputs="value:l_none.value" uid="l_none" uid_parent="fl"/>
    <Tunnel _id="In7" inputs="value:stopped.value" outputs="value:l_stp.value" uid="l_stp" uid_parent="fl"/>
    <Node _name="Unbundle By Name" fields="port,target,kind,whole network,running,clients,view only" inputs="input cluster:s.value" outputs="port:su.port,target:su.target,kind:su.kind,whole network:su.wn,running:su.run,clients:su.cl,view only:su.vo" uid="su" uid_parent="fl"/>
    <Node _name="Format Into String" inputs="format string:l_tf.value,input 1:su.target,input 2:su.kind" outputs="resulting string:tt.s" uid="tt" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:su.port" outputs="decimal integer string:ps.s" uid="ps" uid_parent="fl"/>
    <Node _name="Select" inputs="t:l_net.value,s:su.wn,f:l_here.value" outputs="s? t\3Af:reach.v" uid="reach" uid_parent="fl"/>
    <Node _name="Select" inputs="t:l_vo.value,s:su.vo,f:l_none.value" outputs="s? t\3Af:vos.v" uid="vos" uid_parent="fl"/>
    <Node _name="Concatenate Strings" inputs="string:reach.v,string:vos.v" outputs="concatenated string:rch.s" uid="rch" uid_parent="fl"/>
    <Node _name="Array Size" inputs="array:su.cl" outputs="size(s):nc.v" uid="nc" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:nc.v" outputs="decimal integer string:ncs.s" uid="ncs" uid_parent="fl"/>
    <Node _name="Select" inputs="t:ncs.s,s:su.run,f:l_stp.value" outputs="s? t\3Af:cls.v" uid="cls" uid_parent="fl"/>
    <Node _name="Build Array" inputs="element:tt.s,element:ps.s,element:rch.s,element:cls.v" outputs="appended array:row.v" uid="row" uid_parent="fl"/>
    <Tunnel _id="Out1" inputs="value:row.v" mode="index" outputs="value:items.value" uid="items" uid_parent="fl"/>
    <Tunnel _id="Out2" inputs="value:su.port" mode="index" outputs="value:ports.value" uid="ports" uid_parent="fl"/>
  </Structure>
  <Indicator _name="items" conIdx="4" connection="recommended" description="Listbox rows\3A shared\2C port\2C reach\2C clients." inputs="value:items.value" type="array.2{string}" uid="o_i" uid_parent="root" value="[]"/>
  <Indicator _name="ports" conIdx="5" connection="recommended" description="The shares' ports\2C in the same order." inputs="value:ports.value" type="array{uint16}" uid="o_p" uid_parent="root" value="[]"/>
</VI>
