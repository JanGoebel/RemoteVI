<VI _name="RemoteVI Remote Hooks.vi" description="Runs INSIDE another LabVIEW process (a LabVIEW-built application or another LabVIEW) whose window RemoteVI shares over VI Server (docs\5Carchitecture.md\2C Window targets\2C VI Server route). RemoteVI Server opens this VI in that application instance by its path on disk (Open VI Reference with the application reference)\2C sets its controls (Set Control Value)\2C runs it (Run VI\2C wait until done) and reads its indicators - so the work below happens in the target's own process and UI thread\2C exactly as for a panel of RemoteVI's own LabVIEW. panel? FALSE\3A mods is written into the key state of the target's UI thread (RemoteVI Set Modifier Keys.vi\2C SetKeyboardState in the UI thread - the only way Shift\2C Ctrl and Alt reach LabVIEW\2C which reads them with GetKeyState). panel? TRUE\3A the VI called VI name is opened in this process and its tip strips and splitter bars are read (RemoteVI Read Tips.vi\2C RemoteVI Read Splitters.vi) with origin\3B tips out\2C splitters out and bars out are the messages (tips in\2C splitters in and bars in on an error). Not a member of RemoteVI.lvlib on purpose\3A an application built with RemoteVI holds the library's VIs without front panels\2C and a VI without a front panel cannot take Set Control Value\3B this VI is always loaded from disk with its panel and calls the library VIs as subVIs (those the target already holds\2C or loaded from source next to this file).">
  <Control _name="panel?" conIdx="0" connection="recommended" description="FALSE\3A write mods. TRUE\3A read the tip strips and splitter bars of VI name." outputs="value:pn.value" type="bool" uid="pn" uid_parent="root" value="false"/>
  <Control _name="mods" conIdx="1" connection="recommended" description="Modifier keys to show as held in the UI thread's key state\3A 1 Shift\2C 2 Ctrl\2C 4 Alt." outputs="value:mods.value" type="uint8" uid="mods" uid_parent="root" value="0"/>
  <Control _name="VI name" conIdx="2" connection="recommended" description="The shared VI (its name in this application instance)." outputs="value:vn.value" type="string" uid="vn" uid_parent="root" value=""/>
  <Control _name="origin" conIdx="3" connection="recommended" description="Where the panel area starts inside the frame." outputs="value:og.value" type="cluster{int32.x,int32.y}" uid="og" uid_parent="root" value="[0,0]"/>
  <Control _name="tips in" conIdx="5" connection="recommended" description="The tips message of the last read." outputs="value:ti.value" type="string" uid="ti" uid_parent="root" value="tips []"/>
  <Control _name="splitters in" conIdx="6" connection="recommended" description="The splitters message of the last read." outputs="value:si.value" type="string" uid="si" uid_parent="root" value="splitters []"/>
  <Control _name="bars in" conIdx="7" connection="recommended" description="The bars of the last read." outputs="value:bi.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="bi" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Nothing is done when this carries an error." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Structure _name="Case Structure" selectin="pn.value" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:mods.value" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:vn.value" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:og.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:ti.value" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:si.value" uid="cs_i5" uid_parent="cs"/>
    <Tunnel _id="In6" inputs="value:bi.value" uid="cs_i6" uid_parent="cs"/>
    <Tunnel _id="In7" inputs="value:ei.value" uid="cs_i7" uid_parent="cs"/>
    <CaseFrame label="Modifier keys" selector="False" selectout="" uid="csf" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:f_m.value" uid="f_m" uid_parent="csf"/>
      <Tunnel _id="In2" outputs="value:" uid="f_vn" uid_parent="csf"/>
      <Tunnel _id="In3" outputs="value:" uid="f_og" uid_parent="csf"/>
      <Tunnel _id="In4" outputs="value:f_ti.value" uid="f_ti" uid_parent="csf"/>
      <Tunnel _id="In5" outputs="value:f_si.value" uid="f_si" uid_parent="csf"/>
      <Tunnel _id="In6" outputs="value:f_bi.value" uid="f_bi" uid_parent="csf"/>
      <Tunnel _id="In7" outputs="value:f_e.value" uid="f_e" uid_parent="csf"/>
      <Call inputs="mods:f_m.value,error in:f_e.value" outputs="error out:smk.error out" target="RemoteVI Set Modifier Keys.vi" uid="smk" uid_parent="csf"/>
      <Tunnel _id="Out1" inputs="value:f_ti.value" uid="f_o1" uid_parent="csf"/>
      <Tunnel _id="Out2" inputs="value:f_si.value" uid="f_o2" uid_parent="csf"/>
      <Tunnel _id="Out3" inputs="value:f_bi.value" uid="f_o3" uid_parent="csf"/>
      <Tunnel _id="Out4" inputs="value:smk.error out" uid="f_o4" uid_parent="csf"/>
    </CaseFrame>
    <CaseFrame label="Tip strips and splitter bars of VI name" selector="True" selectout="" uid="cst" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:" uid="t_m" uid_parent="cst"/>
      <Tunnel _id="In2" outputs="value:t_vn.value" uid="t_vn" uid_parent="cst"/>
      <Tunnel _id="In3" outputs="value:t_og.value" uid="t_og" uid_parent="cst"/>
      <Tunnel _id="In4" outputs="value:t_ti.value" uid="t_ti" uid_parent="cst"/>
      <Tunnel _id="In5" outputs="value:t_si.value" uid="t_si" uid_parent="cst"/>
      <Tunnel _id="In6" outputs="value:t_bi.value" uid="t_bi" uid_parent="cst"/>
      <Tunnel _id="In7" outputs="value:t_e.value" uid="t_e" uid_parent="cst"/>
      <Node _name="Open VI Reference" inputs="vi path:t_vn.value,error in (no error):t_e.value" outputs="vi reference:ov.vi reference,error out:ov.error out" uid="ov" uid_parent="cst"/>
      <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="cst" value="true"/>
      <Call inputs="VI:ov.vi reference,refresh?:kt.value,origin:t_og.value,message in:t_ti.value" outputs="message out:rt.message out" target="RemoteVI Read Tips.vi" uid="rt" uid_parent="cst"/>
      <Call inputs="VI:ov.vi reference,refresh?:kt.value,origin:t_og.value,message in:t_si.value,bars in:t_bi.value" outputs="message out:rs.message out,bars out:rs.bars out" target="RemoteVI Read Splitters.vi" uid="rs" uid_parent="cst"/>
      <Node _name="Close Reference" inputs="reference:ov.vi reference,error in (no error):ov.error out" outputs="error out:cr.error out" uid="cr" uid_parent="cst"/>
      <Tunnel _id="Out1" inputs="value:rt.message out" uid="t_o1" uid_parent="cst"/>
      <Tunnel _id="Out2" inputs="value:rs.message out" uid="t_o2" uid_parent="cst"/>
      <Tunnel _id="Out3" inputs="value:rs.bars out" uid="t_o3" uid_parent="cst"/>
      <Tunnel _id="Out4" inputs="value:cr.error out" uid="t_o4" uid_parent="cst"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:to.value" uid="to" uid_parent="cs"/>
    <Tunnel _id="Out2" outputs="value:so.value" uid="so" uid_parent="cs"/>
    <Tunnel _id="Out3" outputs="value:bo.value" uid="bo" uid_parent="cs"/>
    <Tunnel _id="Out4" outputs="value:eo.value" uid="eo" uid_parent="cs"/>
  </Structure>
  <Indicator _name="tips out" conIdx="4" connection="recommended" description="panel? TRUE\3A the tips message (RemoteVI Read Tips.vi)\3B else tips in." inputs="value:to.value" type="string" uid="o_t" uid_parent="root" value=""/>
  <Indicator _name="splitters out" conIdx="8" connection="recommended" description="panel? TRUE\3A the splitters message (RemoteVI Read Splitters.vi)\3B else splitters in." inputs="value:so.value" type="string" uid="o_s" uid_parent="root" value=""/>
  <Indicator _name="bars out" conIdx="9" connection="recommended" description="panel? TRUE\3A the splitter bars\3B else bars in." inputs="value:bo.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="o_b" uid_parent="root" value="[]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in\2C or the error of writing the key state or of opening VI name." inputs="value:eo.value" type="cluster{bool.status,int32.code,string.source}" uid="o_e" uid_parent="root" value="[false,0,]"/>
</VI>
