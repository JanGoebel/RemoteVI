<VI _name="RemoteVI Close Submenus.vi" description="Closes the count deepest submenus of an open LabVIEW menu chain\2C as moving the pointer back to a parent menu does locally\3A posts one VK_LEFT (scan code 0x4B\2C extended) per submenu to the panel window with RemoteVI Post Menu Key.vi\2C each waiting until LabVIEW has handled it. VK_LEFT closes the deepest open submenu and leaves its parent's highlight on the item that opened it (measured). A custom popup such as the colour picker takes no keys and is not closed by this. No VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="count" conIdx="5" connection="required" description="How many submenus to close (0 closes none)." outputs="value:n.value" type="int32" uid="n" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant _name="VK_LEFT" outputs="value:kvk.value" type="uint64" uid="kvk" uid_parent="root" value="37"/>
  <Constant _name="scan 0x4B extended" outputs="value:klp.value" type="int64" uid="klp" uid_parent="root" value="21692417"/>
  <Structure _name="For Loop" count="" label="One VK_LEFT per submenu" maxin="n.value" maxout="" uid="fl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:hw.value" outputs="value:l_hw.value" uid="l_hw" uid_parent="fl"/>
    <Tunnel _id="In2" inputs="value:kvk.value" outputs="value:l_vk.value" uid="l_vk" uid_parent="fl"/>
    <Tunnel _id="In3" inputs="value:klp.value" outputs="value:l_lp.value" uid="l_lp" uid_parent="fl"/>
    <ShiftReg uid="sre" uid_parent="fl">
      <Left inputs="value:ei.value" outputs="value:le.value" uid="srel" uid_parent="sre"/>
      <Right inputs="value:pmk.error out" outputs="value:eend.value" uid="srer" uid_parent="sre"/>
    </ShiftReg>
    <Call inputs="hWnd:l_hw.value,vk:l_vk.value,key lParam:l_lp.value,error in:le.value" outputs="error out:pmk.error out" target="RemoteVI Post Menu Key.vi" uid="pmk" uid_parent="fl"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:eend.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
