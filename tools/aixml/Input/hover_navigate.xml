<VI _name="RemoteVI Hover Navigate.vi" description="Applies the remote pointer to the deepest open LabVIEW menu\2C like a local hover\3A RemoteVI Highlight Menu Row.vi moves the menu's highlight onto the item under the pointer (state.y\2C a logical screen y\2C taken relative to menu.y) with VK_DOWN / VK_UP - no cursor and no window is moved. The menu pointer state is updated\3A navigated TRUE\3B menu\2C top and hit from the result\3B when the highlighted band moved to another item (or another menu) row since becomes now and dwelled FALSE\2C so the dwell timer of RemoteVI Menu Hover.vi starts again\3B when the window showed no highlight even after the probe key it is no keyboard menu and becomes state.plain (the mouse path handles it). No VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="menu" conIdx="5" connection="required" description="The deepest open menu window with its screen rectangle (RemoteVI List Menus.vi)." outputs="value:mn.value" type="cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}" uid="mn" uid_parent="root" value="[0,0,0,0,0]"/>
  <Control _name="state" conIdx="7" connection="required" description="The menu pointer state (RemoteVI Menu Pointer.vi)." outputs="value:st.value" type="cluster{bool.active,int32.x,int32.y,uint32.moved,bool.navigated,uint64.menu,int32.top,bool.hit,uint32.row since,bool.dwelled,uint64.plain,bool.swallow up}" uid="st" uid_parent="root" value="[false,0,0,0,false,0,0,false,0,false,0,false]"/>
  <Control _name="now" conIdx="9" connection="required" description="Tick count (ms)." outputs="value:nw.value" type="uint32" uid="nw" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Unbundle By Name" fields="hwnd,y" inputs="input cluster:mn.value" outputs="hwnd:mu.hwnd,y:mu.y" uid="mu" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="y,menu,top,row since,dwelled,plain" inputs="input cluster:st.value" outputs="y:su.y,menu:su.menu,top:su.top,row since:su.row since,dwelled:su.dwelled,plain:su.plain" uid="su" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:su.y,y:mu.y" outputs="x-y:ly.x-y" uid="ly" uid_parent="root"/>
  <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="root" value="true"/>
  <Constant outputs="value:kf.value" type="bool" uid="kf" uid_parent="root" value="false"/>
  <Call inputs="hWnd:hw.value,menu:mu.hwnd,y:ly.x-y,probe?:kt.value,error in:ei.value" outputs="keyed?:hmr.keyed?,hit?:hmr.hit?,top:hmr.top,bottom:,error out:hmr.error out" target="RemoteVI Highlight Menu Row.vi" uid="hmr" uid_parent="root"/>
  <Node _name="Not Equal?" inputs="x:hmr.top,y:su.top" outputs="x != y?:dt.x != y?" uid="dt" uid_parent="root"/>
  <Node _name="Not Equal?" inputs="x:mu.hwnd,y:su.menu" outputs="x != y?:dm.x != y?" uid="dm" uid_parent="root"/>
  <Node _name="Or" inputs="x:dt.x != y?,y:dm.x != y?" outputs="x .or. y?:chg.x .or. y?" uid="chg" uid_parent="root"/>
  <Node _name="Select" inputs="t:nw.value,s:chg.x .or. y?,f:su.row since" outputs="s? t\3Af:rs.s? t\3Af" uid="rs" uid_parent="root"/>
  <Node _name="Select" inputs="t:kf.value,s:chg.x .or. y?,f:su.dwelled" outputs="s? t\3Af:dw.s? t\3Af" uid="dw" uid_parent="root"/>
  <Node _name="Select" inputs="t:su.plain,s:hmr.keyed?,f:mu.hwnd" outputs="s? t\3Af:pl.s? t\3Af" uid="pl" uid_parent="root"/>
  <Node _name="Bundle By Name" fields="navigated,menu,top,hit,row since,dwelled,plain" inputs="navigated:kt.value,menu:mu.hwnd,top:hmr.top,hit:hmr.hit?,row since:rs.s? t\3Af,dwelled:dw.s? t\3Af,plain:pl.s? t\3Af,input cluster:st.value" outputs="output cluster:bs.output cluster" uid="bs" uid_parent="root"/>
  <Indicator _name="state out" conIdx="4" connection="recommended" description="The updated menu pointer state." inputs="value:bs.output cluster" type="cluster{bool.active,int32.x,int32.y,uint32.moved,bool.navigated,uint64.menu,int32.top,bool.hit,uint32.row since,bool.dwelled,uint64.plain,bool.swallow up}" uid="so" uid_parent="root" value="[false,0,0,0,false,0,0,false,0,false,0,false]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:hmr.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
