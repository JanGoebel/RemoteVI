<VI _name="RemoteVI Hover Parent Menu.vi" description="The remote pointer rests over a PARENT menu (menus[k]\2C k &gt; 0) while k submenus are open below it - what happens locally when the pointer moves back from a submenu. When the pointer is on the parent's highlighted item (the one that opened the submenu) nothing changes and the submenu stays open. Otherwise\2C once the pointer has not moved for 300 ms (so a pointer crossing the parent on its way into the submenu does not close it)\2C the k submenus are closed with VK_LEFT (RemoteVI Close Submenus.vi) and the parent's highlight is moved under the pointer (RemoteVI Hover Navigate.vi). Before that state passes through unchanged. Win32 only\2C no VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="menus" conIdx="5" connection="required" description="The open menu windows\2C top-most (deepest) first (RemoteVI List Menus.vi)." outputs="value:ms.value" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}" uid="ms" uid_parent="root" value="[]"/>
  <Control _name="k" conIdx="7" connection="required" description="Index of the menu under the pointer (&gt; 0)." outputs="value:k.value" type="int32" uid="k" uid_parent="root" value="1"/>
  <Control _name="state" conIdx="9" connection="required" description="The menu pointer state." outputs="value:st.value" type="cluster{bool.active,int32.x,int32.y,uint32.moved,bool.navigated,uint64.menu,int32.top,bool.hit,uint32.row since,bool.dwelled,uint64.plain,bool.swallow up}" uid="st" uid_parent="root" value="[false,0,0,0,false,0,0,false,0,false,0,false]"/>
  <Control _name="now" conIdx="1" connection="required" description="Tick count (ms)." outputs="value:nw.value" type="uint32" uid="nw" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Index Array" inputs="array:ms.value,index:k.value" outputs="element:mk.element" uid="mk" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="hwnd,y" inputs="input cluster:mk.element" outputs="hwnd:mu.hwnd,y:mu.y" uid="mu" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="y,moved" inputs="input cluster:st.value" outputs="y:su.y,moved:su.moved" uid="su" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:su.y,y:mu.y" outputs="x-y:ly.x-y" uid="ly" uid_parent="root"/>
  <Call inputs="hwnd:mu.hwnd,error in:ei.value" outputs="found?:mh.found?,top:mh.top,bottom:mh.bottom,height:,error out:mh.error out" target="RemoteVI Menu Highlight.vi" uid="mh" uid_parent="root"/>
  <Node _name="Less Or Equal?" inputs="x:mh.top,y:ly.x-y" outputs="x &lt;= y?:c1.x &lt;= y?" uid="c1" uid_parent="root"/>
  <Node _name="Less Or Equal?" inputs="x:ly.x-y,y:mh.bottom" outputs="x &lt;= y?:c2.x &lt;= y?" uid="c2" uid_parent="root"/>
  <Node _name="And" inputs="x:c1.x &lt;= y?,y:c2.x &lt;= y?" outputs="x .and. y?:c12.x .and. y?" uid="c12" uid_parent="root"/>
  <Node _name="And" inputs="x:mh.found?,y:c12.x .and. y?" outputs="x .and. y?:own.x .and. y?" uid="own" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:nw.value,y:su.moved" outputs="x-y:age.x-y" uid="age" uid_parent="root"/>
  <Constant _name="rest 300 ms" outputs="value:k300.value" type="uint32" uid="k300" uid_parent="root" value="300"/>
  <Node _name="Greater Or Equal?" inputs="x:age.x-y,y:k300.value" outputs="x &gt;= y?:rest.x &gt;= y?" uid="rest" uid_parent="root"/>
  <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="root" value="true"/>
  <Node _name="Bundle By Name" fields="navigated" inputs="navigated:kt.value,input cluster:st.value" outputs="output cluster:bn.output cluster" uid="bn" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="own.x .and. y?" uid="co" uid_parent="root">
    <Tunnel _id="In1" inputs="value:bn.output cluster" uid="co_i1" uid_parent="co"/>
    <Tunnel _id="In2" inputs="value:st.value" uid="co_i2" uid_parent="co"/>
    <Tunnel _id="In3" inputs="value:mh.error out" uid="co_i3" uid_parent="co"/>
    <Tunnel _id="In4" inputs="value:rest.x &gt;= y?" uid="co_i4" uid_parent="co"/>
    <Tunnel _id="In5" inputs="value:hw.value" uid="co_i5" uid_parent="co"/>
    <Tunnel _id="In6" inputs="value:k.value" uid="co_i6" uid_parent="co"/>
    <Tunnel _id="In7" inputs="value:mk.element" uid="co_i7" uid_parent="co"/>
    <Tunnel _id="In8" inputs="value:nw.value" uid="co_i8" uid_parent="co"/>
    <CaseFrame label="On the item that opened the submenu" selector="True" selectout="" uid="cot" uid_parent="co">
      <Tunnel _id="In1" outputs="value:a_bn.value" uid="a_bn" uid_parent="cot"/>
      <Tunnel _id="In2" outputs="value:" uid="a_st" uid_parent="cot"/>
      <Tunnel _id="In3" outputs="value:a_e.value" uid="a_e" uid_parent="cot"/>
      <Tunnel _id="In4" outputs="value:" uid="a_r" uid_parent="cot"/>
      <Tunnel _id="In5" outputs="value:" uid="a_hw" uid_parent="cot"/>
      <Tunnel _id="In6" outputs="value:" uid="a_k" uid_parent="cot"/>
      <Tunnel _id="In7" outputs="value:" uid="a_m" uid_parent="cot"/>
      <Tunnel _id="In8" outputs="value:" uid="a_n" uid_parent="cot"/>
      <Tunnel _id="Out1" inputs="value:a_bn.value" uid="a_o1" uid_parent="cot"/>
      <Tunnel _id="Out2" inputs="value:a_e.value" uid="a_o2" uid_parent="cot"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="cof" uid_parent="co">
      <Tunnel _id="In1" outputs="value:" uid="b_bn" uid_parent="cof"/>
      <Tunnel _id="In2" outputs="value:b_st.value" uid="b_st" uid_parent="cof"/>
      <Tunnel _id="In3" outputs="value:b_e.value" uid="b_e" uid_parent="cof"/>
      <Tunnel _id="In4" outputs="value:b_r.value" uid="b_r" uid_parent="cof"/>
      <Tunnel _id="In5" outputs="value:b_hw.value" uid="b_hw" uid_parent="cof"/>
      <Tunnel _id="In6" outputs="value:b_k.value" uid="b_k" uid_parent="cof"/>
      <Tunnel _id="In7" outputs="value:b_m.value" uid="b_m" uid_parent="cof"/>
      <Tunnel _id="In8" outputs="value:b_n.value" uid="b_n" uid_parent="cof"/>
      <Structure _name="Case Structure" selectin="b_r.value" uid="cr" uid_parent="cof">
        <Tunnel _id="In1" inputs="value:b_st.value" uid="cr_i1" uid_parent="cr"/>
        <Tunnel _id="In2" inputs="value:b_e.value" uid="cr_i2" uid_parent="cr"/>
        <Tunnel _id="In3" inputs="value:b_hw.value" uid="cr_i3" uid_parent="cr"/>
        <Tunnel _id="In4" inputs="value:b_k.value" uid="cr_i4" uid_parent="cr"/>
        <Tunnel _id="In5" inputs="value:b_m.value" uid="cr_i5" uid_parent="cr"/>
        <Tunnel _id="In6" inputs="value:b_n.value" uid="cr_i6" uid_parent="cr"/>
        <CaseFrame label="Rested on another item\3A close the submenus" selector="True" selectout="" uid="crt" uid_parent="cr">
          <Tunnel _id="In1" outputs="value:c_st.value" uid="c_st" uid_parent="crt"/>
          <Tunnel _id="In2" outputs="value:c_e.value" uid="c_e" uid_parent="crt"/>
          <Tunnel _id="In3" outputs="value:c_hw.value" uid="c_hw" uid_parent="crt"/>
          <Tunnel _id="In4" outputs="value:c_k.value" uid="c_k" uid_parent="crt"/>
          <Tunnel _id="In5" outputs="value:c_m.value" uid="c_m" uid_parent="crt"/>
          <Tunnel _id="In6" outputs="value:c_n.value" uid="c_n" uid_parent="crt"/>
          <Call inputs="hWnd:c_hw.value,count:c_k.value,error in:c_e.value" outputs="error out:cs.error out" target="RemoteVI Close Submenus.vi" uid="cs" uid_parent="crt"/>
          <Call inputs="hWnd:c_hw.value,menu:c_m.value,state:c_st.value,now:c_n.value,error in:cs.error out" outputs="state out:hn.state out,error out:hn.error out" target="RemoteVI Hover Navigate.vi" uid="hn" uid_parent="crt"/>
          <Tunnel _id="Out1" inputs="value:hn.state out" uid="c_o1" uid_parent="crt"/>
          <Tunnel _id="Out2" inputs="value:hn.error out" uid="c_o2" uid_parent="crt"/>
        </CaseFrame>
        <CaseFrame selector="False" selectout="" uid="crf" uid_parent="cr">
          <Tunnel _id="In1" outputs="value:d_st.value" uid="d_st" uid_parent="crf"/>
          <Tunnel _id="In2" outputs="value:d_e.value" uid="d_e" uid_parent="crf"/>
          <Tunnel _id="In3" outputs="value:" uid="d_hw" uid_parent="crf"/>
          <Tunnel _id="In4" outputs="value:" uid="d_k" uid_parent="crf"/>
          <Tunnel _id="In5" outputs="value:" uid="d_m" uid_parent="crf"/>
          <Tunnel _id="In6" outputs="value:" uid="d_n" uid_parent="crf"/>
          <Tunnel _id="Out1" inputs="value:d_st.value" uid="d_o1" uid_parent="crf"/>
          <Tunnel _id="Out2" inputs="value:d_e.value" uid="d_o2" uid_parent="crf"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:cr_o1.value" uid="cr_o1" uid_parent="cr"/>
        <Tunnel _id="Out2" outputs="value:cr_o2.value" uid="cr_o2" uid_parent="cr"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:cr_o1.value" uid="b_o1" uid_parent="cof"/>
      <Tunnel _id="Out2" inputs="value:cr_o2.value" uid="b_o2" uid_parent="cof"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:co_o1.value" uid="co_o1" uid_parent="co"/>
    <Tunnel _id="Out2" outputs="value:co_o2.value" uid="co_o2" uid_parent="co"/>
  </Structure>
  <Indicator _name="state out" conIdx="4" connection="recommended" description="The updated menu pointer state." inputs="value:co_o1.value" type="cluster{bool.active,int32.x,int32.y,uint32.moved,bool.navigated,uint64.menu,int32.top,bool.hit,uint32.row since,bool.dwelled,uint64.plain,bool.swallow up}" uid="so" uid_parent="root" value="[false,0,0,0,false,0,0,false,0,false,0,false]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:co_o2.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
