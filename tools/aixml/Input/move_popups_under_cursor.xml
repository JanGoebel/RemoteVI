<VI _name="RemoteVI Move Popups Under Cursor.vi" description="Aims a click on a popup WITHOUT moving the host cursor (docs\5Carchitecture.md\2C Popups)\3A before a button-down RemoteVI Prepare Menu Click.vi closes submenus that would be hit-tested in the wrong place\3B the real cursor c is read (user32 GetCursorPos)\2C d = c - (x\2C y) is formed ((x\2C y) is the clicked LOGICAL screen point)\2C every popup still open is moved to its logical position + d with user32 SetWindowPos (0x15 = SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE)\2C a closed clicked submenu is reopened at its new place (RemoteVI Reopen Submenu.vi)\2C and a WM_MOUSEMOVE at c is posted (without it the popup ignores the click - measured). lParam is c packed for the posts that follow (screen coordinates). When the cursor cannot be read d stays dx\2C dy. No VI Server call.">
  <Control _name="x" conIdx="0" connection="required" description="Clicked logical screen x." outputs="value:x.value" type="int32" uid="x" uid_parent="root" value="0"/>
  <Control _name="y" conIdx="5" connection="required" description="Clicked logical screen y." outputs="value:y.value" type="int32" uid="y" uid_parent="root" value="0"/>
  <Control _name="hWnd" conIdx="7" connection="required" description="The served front panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="windows" conIdx="9" connection="required" description="The popups at their logical positions." outputs="value:win.value" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}" uid="win" uid_parent="root" value="[]"/>
  <Control _name="dx" conIdx="1" connection="recommended" description="Current displacement d\2C x." outputs="value:dx.value" type="int32" uid="dx" uid_parent="root" value="0"/>
  <Control _name="dy" conIdx="2" connection="recommended" description="Current displacement d\2C y." outputs="value:dy.value" type="int32" uid="dy" uid_parent="root" value="0"/>
  <Control _name="posts" conIdx="3" connection="required" description="The messages of the click." outputs="value:ps.value" type="array{cluster{uint32.msg,uint64.wParam,int64.lParam}}" uid="ps" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Call inputs="posts:ps.value" outputs="button down?:bd.button down?" target="RemoteVI Is Button Down.vi" uid="bd" uid_parent="root"/>
  <Constant _name="point" outputs="value:kpt.value" type="cluster{int32.x,int32.y}" uid="kpt" uid_parent="root" value="[0,0]"/>
  <Node _name="Bundle By Name" fields="x,y" inputs="x:x.value,y:y.value,input cluster:kpt.value" outputs="output cluster:ipt.output cluster" uid="ipt" uid_parent="root"/>
  <Call inputs="hWnd:hw.value,windows:win.value,point:ipt.output cluster,button down?:bd.button down?,error in:ei.value" outputs="windows out:pmc.windows out,reopen?:pmc.reopen?,menu?:pmc.menu?,error out:pmc.error out" target="RemoteVI Prepare Menu Click.vi" uid="pmc" uid_parent="root"/>
  <Call inputs="error in:pmc.error out" outputs="X:gcp.X,Y:gcp.Y,return value:,error out:gcp.error out" target="user32 GetCursorPos.vi" uid="gcp" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="status" inputs="input cluster:gcp.error out" outputs="status:gcs.status" uid="gcs" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:gcp.X,y:x.value" outputs="x-y:ddx.x-y" uid="ddx" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:gcp.Y,y:y.value" outputs="x-y:ddy.x-y" uid="ddy" uid_parent="root"/>
  <Node _name="Select" inputs="t:dx.value,s:gcs.status,f:ddx.x-y" outputs="s? t\3Af:ndx.s? t\3Af" uid="ndx" uid_parent="root"/>
  <Node _name="Select" inputs="t:dy.value,s:gcs.status,f:ddy.x-y" outputs="s? t\3Af:ndy.s? t\3Af" uid="ndy" uid_parent="root"/>
  <Constant _name="SWP_NOSIZE|NOZORDER|NOACTIVATE" outputs="value:kswp.value" type="uint32" uid="kswp" uid_parent="root" value="21"/>
  <Structure _name="For Loop" count="" label="Move each popup to logical + d" maxin="" maxout="" uid="fm" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pmc.windows out" mode="index" outputs="value:m_w.value" uid="m_w" uid_parent="fm"/>
    <Tunnel _id="In2" inputs="value:ndx.s? t\3Af" outputs="value:m_dx.value" uid="m_dx" uid_parent="fm"/>
    <Tunnel _id="In3" inputs="value:ndy.s? t\3Af" outputs="value:m_dy.value" uid="m_dy" uid_parent="fm"/>
    <Tunnel _id="In4" inputs="value:kswp.value" outputs="value:m_fl.value" uid="m_fl" uid_parent="fm"/>
    <ShiftReg uid="sr_m" uid_parent="fm">
      <Left inputs="value:gcp.error out" outputs="value:m_e.value" uid="sr_ml" uid_parent="sr_m"/>
      <Right inputs="value:swp.error out" outputs="value:m_e_end.value" uid="sr_mr" uid_parent="sr_m"/>
    </ShiftReg>
    <Node _name="Unbundle By Name" fields="hwnd,x,y" inputs="input cluster:m_w.value" outputs="hwnd:mwu.hwnd,x:mwu.x,y:mwu.y" uid="mwu" uid_parent="fm"/>
    <Node _name="Add" inputs="x:mwu.x,y:m_dx.value" outputs="x+y:mx.x+y" uid="mx" uid_parent="fm"/>
    <Node _name="Add" inputs="x:mwu.y,y:m_dy.value" outputs="x+y:my.x+y" uid="my" uid_parent="fm"/>
    <Call inputs="hWnd:mwu.hwnd,X:mx.x+y,Y:my.x+y,uFlags:m_fl.value,error in:m_e.value" outputs="return value:,error out:swp.error out" target="user32 SetWindowPos.vi" uid="swp" uid_parent="fm"/>
  </Structure>
  <Call inputs="x:gcp.X,y:gcp.Y" outputs="lParam:ppl.lParam" target="RemoteVI Pack Point lParam.vi" uid="ppl" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="pmc.reopen?" uid="cro" uid_parent="root">
    <Tunnel _id="In1" inputs="value:m_e_end.value" uid="cro_i1" uid_parent="cro"/>
    <Tunnel _id="In2" inputs="value:hw.value" uid="cro_i2" uid_parent="cro"/>
    <Tunnel _id="In3" inputs="value:pmc.windows out" uid="cro_i3" uid_parent="cro"/>
    <CaseFrame label="Reopen the clicked submenu" selector="True" selectout="" uid="crot" uid_parent="cro">
      <Tunnel _id="In1" outputs="value:ro_e.value" uid="ro_e" uid_parent="crot"/>
      <Tunnel _id="In2" outputs="value:ro_hw.value" uid="ro_hw" uid_parent="crot"/>
      <Tunnel _id="In3" outputs="value:ro_w.value" uid="ro_w" uid_parent="crot"/>
      <Call inputs="hWnd:ro_hw.value,windows:ro_w.value,error in:ro_e.value" outputs="error out:rs.error out" target="RemoteVI Reopen Submenu.vi" uid="rs" uid_parent="crot"/>
      <Tunnel _id="Out1" inputs="value:rs.error out" uid="ro_o1" uid_parent="crot"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="crof" uid_parent="cro">
      <Tunnel _id="In1" outputs="value:rf_e.value" uid="rf_e" uid_parent="crof"/>
      <Tunnel _id="In2" outputs="value:" uid="rf_hw" uid_parent="crof"/>
      <Tunnel _id="In3" outputs="value:" uid="rf_w" uid_parent="crof"/>
      <Tunnel _id="Out1" inputs="value:rf_e.value" uid="rf_o1" uid_parent="crof"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cro_o1.value" uid="cro_o1" uid_parent="cro"/>
  </Structure>
  <Constant _name="WM_MOUSEMOVE" outputs="value:kmm.value" type="uint32" uid="kmm" uid_parent="root" value="512"/>
  <Constant _name="no buttons" outputs="value:kw0.value" type="uint64" uid="kw0" uid_parent="root" value="0"/>
  <Call inputs="hWnd:hw.value,Msg:kmm.value,wParam:kw0.value,lParam:ppl.lParam,error in (no error):cro_o1.value" outputs="return value:,error out:pmm.error out" target="user32 PostMessageW.vi" uid="pmm" uid_parent="root"/>
  <Indicator _name="lParam" conIdx="4" connection="recommended" description="The real cursor position packed as a message lParam." inputs="value:ppl.lParam" type="int64" uid="o_lp" uid_parent="root" value="0"/>
  <Indicator _name="dx out" conIdx="6" connection="recommended" description="The displacement d used\2C x." inputs="value:ndx.s? t\3Af" type="int32" uid="o_dx" uid_parent="root" value="0"/>
  <Indicator _name="dy out" conIdx="8" connection="recommended" description="The displacement d used\2C y." inputs="value:ndy.s? t\3Af" type="int32" uid="o_dy" uid_parent="root" value="0"/>
  <Indicator _name="menu?" conIdx="10" connection="recommended" description="From RemoteVI Prepare Menu Click.vi\3A the click is on a LabVIEW menu." inputs="value:pmc.menu?" type="bool" uid="o_menu" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Errors of preparing\2C reading the cursor\2C moving\2C reopening and posting." inputs="value:pmm.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
