<VI _name="RemoteVI Popup Click.vi" description="The popup branch of RemoteVI Post Input.vi - a remote mouse button message while a LabVIEW popup is open (docs\5Carchitecture.md\2C Popups). The host cursor never moves. The LabVIEW menus are listed fresh (RemoteVI List Menus.vi\2C deepest first\3B menus are never moved\2C so their real place is the logical one) and the one under the clicked point is found (RemoteVI Point On Popup.vi). On a menu the click is done with KEYS (RemoteVI Menu Click.vi\3A close the submenus above with VK_LEFT\2C move the highlight with VK_DOWN / VK_UP\2C VK_RETURN\3B a button-up is dropped). When that window takes no keys (colour picker\2C line width popup)\2C or the point lies on another popup of the server's list (windows - graph palette popups\2C drop-downs)\2C the MOUSE path clicks it (RemoteVI Plain Popup Click.vi\3A only that window is moved under the cursor for the message and moved back). A point outside every popup\3A a button-down closes all popups with WM_CANCELMODE (RemoteVI Cancel Popups.vi)\2C a button-up is dropped. No waiting beyond LabVIEW handling each key or message\3B no VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="posts" conIdx="5" connection="required" description="The button message from RemoteVI Translate Input.vi (not empty)." outputs="value:ps.value" type="array{cluster{uint32.msg,uint64.wParam,int64.lParam}}" uid="ps" uid_parent="root" value="[]"/>
  <Control _name="point" conIdx="7" connection="required" description="The clicked point\2C LOGICAL screen pixels." outputs="value:pt.value" type="cluster{int32.x,int32.y}" uid="pt" uid_parent="root" value="[0,0]"/>
  <Control _name="windows" conIdx="9" connection="recommended" description="The modal popups as the server loop last listed them (RemoteVI Track Popups.vi)\2C top-most first." outputs="value:win.value" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}" uid="win" uid_parent="root" value="[]"/>
  <Control _name="popup since" conIdx="1" connection="recommended" description="Tick count when the server first saw a popup open." outputs="value:since.value" type="uint32" uid="since" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Unbundle By Name" fields="x,y" inputs="input cluster:pt.value" outputs="x:pu.x,y:pu.y" uid="pu" uid_parent="root"/>
  <Call inputs="posts:ps.value" outputs="button down?:bd.button down?" target="RemoteVI Is Button Down.vi" uid="bd" uid_parent="root"/>
  <Call inputs="" outputs="menus:lm.menus" target="RemoteVI List Menus.vi" uid="lm" uid_parent="root"/>
  <Call inputs="windows:lm.menus,x:pu.x,y:pu.y" outputs="on popup?:pm.on popup?,index:pm.index" target="RemoteVI Point On Popup.vi" uid="pm" uid_parent="root"/>
  <Call inputs="windows:win.value,x:pu.x,y:pu.y" outputs="on popup?:pw.on popup?,index:pw.index" target="RemoteVI Point On Popup.vi" uid="pw" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="pm.on popup?" uid="cm" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ei.value" uid="cm_i1" uid_parent="cm"/>
    <Tunnel _id="In2" inputs="value:hw.value" uid="cm_i2" uid_parent="cm"/>
    <Tunnel _id="In3" inputs="value:lm.menus" uid="cm_i3" uid_parent="cm"/>
    <Tunnel _id="In4" inputs="value:pm.index" uid="cm_i4" uid_parent="cm"/>
    <Tunnel _id="In5" inputs="value:pt.value" uid="cm_i5" uid_parent="cm"/>
    <Tunnel _id="In6" inputs="value:bd.button down?" uid="cm_i6" uid_parent="cm"/>
    <CaseFrame label="On a LabVIEW menu\3A keys" selector="True" selectout="" uid="cmt" uid_parent="cm">
      <Tunnel _id="In1" outputs="value:a_e.value" uid="a_e" uid_parent="cmt"/>
      <Tunnel _id="In2" outputs="value:a_hw.value" uid="a_hw" uid_parent="cmt"/>
      <Tunnel _id="In3" outputs="value:a_ms.value" uid="a_ms" uid_parent="cmt"/>
      <Tunnel _id="In4" outputs="value:a_k.value" uid="a_k" uid_parent="cmt"/>
      <Tunnel _id="In5" outputs="value:a_pt.value" uid="a_pt" uid_parent="cmt"/>
      <Tunnel _id="In6" outputs="value:a_bd.value" uid="a_bd" uid_parent="cmt"/>
      <Call inputs="hWnd:a_hw.value,menus:a_ms.value,k:a_k.value,point:a_pt.value,button down?:a_bd.value,error in:a_e.value" outputs="handled?:mc.handled?,error out:mc.error out" target="RemoteVI Menu Click.vi" uid="mc" uid_parent="cmt"/>
      <Tunnel _id="Out1" inputs="value:mc.error out" uid="a_o1" uid_parent="cmt"/>
      <Tunnel _id="Out2" inputs="value:mc.handled?" uid="a_o2" uid_parent="cmt"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="cmf" uid_parent="cm">
      <Tunnel _id="In1" outputs="value:b_e.value" uid="b_e" uid_parent="cmf"/>
      <Tunnel _id="In2" outputs="value:" uid="b_hw" uid_parent="cmf"/>
      <Tunnel _id="In3" outputs="value:" uid="b_ms" uid_parent="cmf"/>
      <Tunnel _id="In4" outputs="value:" uid="b_k" uid_parent="cmf"/>
      <Tunnel _id="In5" outputs="value:" uid="b_pt" uid_parent="cmf"/>
      <Tunnel _id="In6" outputs="value:" uid="b_bd" uid_parent="cmf"/>
      <Constant outputs="value:bf.value" type="bool" uid="bf" uid_parent="cmf" value="false"/>
      <Tunnel _id="Out1" inputs="value:b_e.value" uid="b_o1" uid_parent="cmf"/>
      <Tunnel _id="Out2" inputs="value:bf.value" uid="b_o2" uid_parent="cmf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cm_o1.value" uid="cm_o1" uid_parent="cm"/>
    <Tunnel _id="Out2" outputs="value:cm_o2.value" uid="cm_o2" uid_parent="cm"/>
  </Structure>
  <Node _name="Index Array" inputs="array:lm.menus,index:pm.index" outputs="element:wm.element" uid="wm" uid_parent="root"/>
  <Node _name="Index Array" inputs="array:win.value,index:pw.index" outputs="element:ww.element" uid="ww" uid_parent="root"/>
  <Node _name="Select" inputs="t:wm.element,s:pm.on popup?,f:ww.element" outputs="s? t\3Af:tw.s? t\3Af" uid="tw" uid_parent="root"/>
  <Node _name="Or" inputs="x:pm.on popup?,y:pw.on popup?" outputs="x .or. y?:onany.x .or. y?" uid="onany" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="cm_o2.value" uid="ch" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cm_o1.value" uid="ch_i1" uid_parent="ch"/>
    <Tunnel _id="In2" inputs="value:hw.value" uid="ch_i2" uid_parent="ch"/>
    <Tunnel _id="In3" inputs="value:onany.x .or. y?" uid="ch_i3" uid_parent="ch"/>
    <Tunnel _id="In4" inputs="value:tw.s? t\3Af" uid="ch_i4" uid_parent="ch"/>
    <Tunnel _id="In5" inputs="value:pt.value" uid="ch_i5" uid_parent="ch"/>
    <Tunnel _id="In6" inputs="value:ps.value" uid="ch_i6" uid_parent="ch"/>
    <Tunnel _id="In7" inputs="value:since.value" uid="ch_i7" uid_parent="ch"/>
    <CaseFrame label="Handled with keys" selector="True" selectout="" uid="cht" uid_parent="ch">
      <Tunnel _id="In1" outputs="value:c_e.value" uid="c_e" uid_parent="cht"/>
      <Tunnel _id="In2" outputs="value:" uid="c_hw" uid_parent="cht"/>
      <Tunnel _id="In3" outputs="value:" uid="c_on" uid_parent="cht"/>
      <Tunnel _id="In4" outputs="value:" uid="c_w" uid_parent="cht"/>
      <Tunnel _id="In5" outputs="value:" uid="c_pt" uid_parent="cht"/>
      <Tunnel _id="In6" outputs="value:" uid="c_ps" uid_parent="cht"/>
      <Tunnel _id="In7" outputs="value:" uid="c_si" uid_parent="cht"/>
      <Tunnel _id="Out1" inputs="value:c_e.value" uid="c_o1" uid_parent="cht"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="chf" uid_parent="ch">
      <Tunnel _id="In1" outputs="value:d_e.value" uid="d_e" uid_parent="chf"/>
      <Tunnel _id="In2" outputs="value:d_hw.value" uid="d_hw" uid_parent="chf"/>
      <Tunnel _id="In3" outputs="value:d_on.value" uid="d_on" uid_parent="chf"/>
      <Tunnel _id="In4" outputs="value:d_w.value" uid="d_w" uid_parent="chf"/>
      <Tunnel _id="In5" outputs="value:d_pt.value" uid="d_pt" uid_parent="chf"/>
      <Tunnel _id="In6" outputs="value:d_ps.value" uid="d_ps" uid_parent="chf"/>
      <Tunnel _id="In7" outputs="value:d_si.value" uid="d_si" uid_parent="chf"/>
      <Structure _name="Case Structure" selectin="d_on.value" uid="co" uid_parent="chf">
        <Tunnel _id="In1" inputs="value:d_e.value" uid="co_i1" uid_parent="co"/>
        <Tunnel _id="In2" inputs="value:d_hw.value" uid="co_i2" uid_parent="co"/>
        <Tunnel _id="In3" inputs="value:d_w.value" uid="co_i3" uid_parent="co"/>
        <Tunnel _id="In4" inputs="value:d_pt.value" uid="co_i4" uid_parent="co"/>
        <Tunnel _id="In5" inputs="value:d_ps.value" uid="co_i5" uid_parent="co"/>
        <Tunnel _id="In6" inputs="value:d_si.value" uid="co_i6" uid_parent="co"/>
        <CaseFrame label="On a popup that takes no keys\3A mouse path" selector="True" selectout="" uid="cot" uid_parent="co">
          <Tunnel _id="In1" outputs="value:e_e.value" uid="e_e" uid_parent="cot"/>
          <Tunnel _id="In2" outputs="value:e_hw.value" uid="e_hw" uid_parent="cot"/>
          <Tunnel _id="In3" outputs="value:e_w.value" uid="e_w" uid_parent="cot"/>
          <Tunnel _id="In4" outputs="value:e_pt.value" uid="e_pt" uid_parent="cot"/>
          <Tunnel _id="In5" outputs="value:e_ps.value" uid="e_ps" uid_parent="cot"/>
          <Tunnel _id="In6" outputs="value:e_si.value" uid="e_si" uid_parent="cot"/>
          <Call inputs="hWnd:e_hw.value,window:e_w.value,point:e_pt.value,posts:e_ps.value,popup since:e_si.value,error in:e_e.value" outputs="error out:ppc.error out" target="RemoteVI Plain Popup Click.vi" uid="ppc" uid_parent="cot"/>
          <Tunnel _id="Out1" inputs="value:ppc.error out" uid="e_o1" uid_parent="cot"/>
        </CaseFrame>
        <CaseFrame label="Outside every popup\3A close them" selector="False" selectout="" uid="cof" uid_parent="co">
          <Tunnel _id="In1" outputs="value:f_e.value" uid="f_e" uid_parent="cof"/>
          <Tunnel _id="In2" outputs="value:f_hw.value" uid="f_hw" uid_parent="cof"/>
          <Tunnel _id="In3" outputs="value:" uid="f_w" uid_parent="cof"/>
          <Tunnel _id="In4" outputs="value:" uid="f_pt" uid_parent="cof"/>
          <Tunnel _id="In5" outputs="value:f_ps.value" uid="f_ps" uid_parent="cof"/>
          <Tunnel _id="In6" outputs="value:" uid="f_si" uid_parent="cof"/>
          <Call inputs="hWnd:f_hw.value,posts:f_ps.value,error in:f_e.value" outputs="error out:cp.error out" target="RemoteVI Cancel Popups.vi" uid="cp" uid_parent="cof"/>
          <Tunnel _id="Out1" inputs="value:cp.error out" uid="f_o1" uid_parent="cof"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:co_o1.value" uid="co_o1" uid_parent="co"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:co_o1.value" uid="d_o1" uid_parent="chf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:ch_o1.value" uid="ch_o1" uid_parent="ch"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:ch_o1.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
