<VI _name="RemoteVI Post Input.vi" description="Posts the Win32 messages from RemoteVI Translate Input.vi to the window hWnd (the served front panel)\2C in order\2C with user32 PostMessageW. First RemoteVI Swallow Button Up.vi drops the button-up of a click that was turned into menu keys. Without a popup (cursor.move? FALSE) each message is posted only after LabVIEW has handled the one before - except after a hover move (WM_MOUSEMOVE with no button held)\2C which nothing waits on\3B at up to 60 moves per second the round trips kept the server loop waiting for LabVIEW's busy UI thread (measured on the demo) - \3A after every other PostMessageW the VI waits with RemoteVI Wait Input Handled.vi (two WM_NULL sent to hWnd\2C at most 500 ms each) - LabVIEW drops and reorders key messages that arrive in a burst (measured\3A twelve posted Backspace key-downs became one)\2C and the server decides how to post a button-up from the mouse capture the button-down set up. With a popup open (cursor.move? TRUE\2C a button message at the LOGICAL screen point cursor.x\2C cursor.y) the message goes to RemoteVI Popup Click.vi (docs\5Carchitecture.md\2C Popups)\3A on a LabVIEW menu it is done with keys (VK_LEFT\2C VK_DOWN / VK_UP\2C VK_RETURN) - no menu and no cursor moves\2C so every submenu opens where LabVIEW opens it locally\3B on a popup that takes no keys (colour picker\2C line width popup\2C graph palette popups) only that window is moved under the host cursor for the message and moved back\3B outside every popup a button-down closes them all (WM_CANCELMODE). The host cursor never moves. popups passes through to popups out unchanged (the displacement d stays 0\3A popups are no longer left displaced). No VI Server call\2C so it works while an open popup blocks LabVIEW's UI thread. An incoming error posts nothing.">
  <FreeLabel comment="Popup open\3A keys on menus\2C mouse elsewhere" uid="lbl" uid_parent="root"/>
  <Control _name="hWnd" conIdx="0" connection="required" description="Native handle of the window that receives the messages - the served front panel (RemoteVI Get Panel Geometry.vi)." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="posts" conIdx="5" connection="required" description="Messages to post\2C from RemoteVI Translate Input.vi." outputs="value:ps.value" type="array{cluster{uint32.msg,uint64.wParam,int64.lParam}}" uid="ps" uid_parent="root" value="[]"/>
  <Control _name="cursor" conIdx="7" connection="recommended" description="From RemoteVI Translate Input.vi\3A when move? is TRUE a popup is open and (x\2C y) is the clicked LOGICAL screen point." outputs="value:cu.value" type="cluster{bool.move?,int32.x,int32.y}" uid="cu" uid_parent="root" value="[false,0,0]"/>
  <Control _name="popups" conIdx="9" connection="recommended" description="The LabVIEW popups open now (RemoteVI Track Popups.vi\2C as the server loop last saw them)\3A windows = each window handle with its logical top-left in screen pixels and its size\2C dx\2C dy = the displacement d (0\2C 0)." outputs="value:pp.value" type="cluster{array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}.windows,int32.dx,int32.dy}" uid="pp" uid_parent="root" value="[[],0,0]"/>
  <Control _name="popup since" conIdx="1" connection="recommended" description="Tick count when the server first saw a popup open (a mouse-path click waits until the popup is 350 ms old)." outputs="value:since.value" type="uint32" uid="since" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Call inputs="posts:ps.value" outputs="posts out:sw.posts out" target="RemoteVI Swallow Button Up.vi" uid="sw" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="move?,x,y" inputs="input cluster:cu.value" outputs="move?:ucu.move?,x:ucu.x,y:ucu.y" uid="ucu" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="windows" inputs="input cluster:pp.value" outputs="windows:upp.windows" uid="upp" uid_parent="root"/>
  <Node _name="Array Size" inputs="array:sw.posts out" outputs="size(s):n.size(s)" uid="n" uid_parent="root"/>
  <Node _name="Greater Than 0?" inputs="x:n.size(s)" outputs="x &gt; 0?:any.x &gt; 0?" uid="any" uid_parent="root"/>
  <Node _name="And" inputs="x:ucu.move?,y:any.x &gt; 0?" outputs="x .and. y?:pop.x .and. y?" uid="pop" uid_parent="root"/>
  <Constant _name="point" outputs="value:kpt.value" type="cluster{int32.x,int32.y}" uid="kpt" uid_parent="root" value="[0,0]"/>
  <Node _name="Bundle By Name" fields="x,y" inputs="x:ucu.x,y:ucu.y,input cluster:kpt.value" outputs="output cluster:ipt.output cluster" uid="ipt" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="pop.x .and. y?" uid="cm" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ei.value" uid="cm_i1" uid_parent="cm"/>
    <Tunnel _id="In2" inputs="value:hw.value" uid="cm_i2" uid_parent="cm"/>
    <Tunnel _id="In3" inputs="value:sw.posts out" uid="cm_i3" uid_parent="cm"/>
    <Tunnel _id="In4" inputs="value:ipt.output cluster" uid="cm_i4" uid_parent="cm"/>
    <Tunnel _id="In5" inputs="value:upp.windows" uid="cm_i5" uid_parent="cm"/>
    <Tunnel _id="In6" inputs="value:since.value" uid="cm_i6" uid_parent="cm"/>
    <CaseFrame label="Popup open\3A keys or mouse path" selector="True" selectout="" uid="cmt" uid_parent="cm">
      <Tunnel _id="In1" outputs="value:t_e.value" uid="t_e" uid_parent="cmt"/>
      <Tunnel _id="In2" outputs="value:t_hw.value" uid="t_hw" uid_parent="cmt"/>
      <Tunnel _id="In3" outputs="value:t_ps.value" uid="t_ps" uid_parent="cmt"/>
      <Tunnel _id="In4" outputs="value:t_pt.value" uid="t_pt" uid_parent="cmt"/>
      <Tunnel _id="In5" outputs="value:t_w.value" uid="t_w" uid_parent="cmt"/>
      <Tunnel _id="In6" outputs="value:t_si.value" uid="t_si" uid_parent="cmt"/>
      <Call inputs="hWnd:t_hw.value,posts:t_ps.value,point:t_pt.value,windows:t_w.value,popup since:t_si.value,error in:t_e.value" outputs="error out:pc.error out" target="RemoteVI Popup Click.vi" uid="pc" uid_parent="cmt"/>
      <Tunnel _id="Out1" inputs="value:pc.error out" uid="t_o1" uid_parent="cmt"/>
    </CaseFrame>
    <CaseFrame label="Post each message\2C wait until handled" selector="False" selectout="" uid="cmf" uid_parent="cm">
      <Tunnel _id="In1" outputs="value:f_e.value" uid="f_e" uid_parent="cmf"/>
      <Tunnel _id="In2" outputs="value:f_hw.value" uid="f_hw" uid_parent="cmf"/>
      <Tunnel _id="In3" outputs="value:f_ps.value" uid="f_ps" uid_parent="cmf"/>
      <Tunnel _id="In4" outputs="value:" uid="f_pt" uid_parent="cmf"/>
      <Tunnel _id="In5" outputs="value:" uid="f_w" uid_parent="cmf"/>
      <Tunnel _id="In6" outputs="value:" uid="f_si" uid_parent="cmf"/>
      <Structure _name="For Loop" count="" label="Post each message" maxin="" maxout="" uid="loop" uid_parent="cmf">
        <Tunnel _id="In1" inputs="value:f_ps.value" mode="index" outputs="value:pi.value" uid="pi" uid_parent="loop"/>
        <Tunnel _id="In2" inputs="value:f_hw.value" outputs="value:hi2.value" uid="hi2" uid_parent="loop"/>
        <ShiftReg uid="sr" uid_parent="loop">
          <Left inputs="value:f_e.value" outputs="value:srl.value" uid="srl" uid_parent="sr"/>
          <Right inputs="value:wco.value" outputs="value:srr.value" uid="srr" uid_parent="sr"/>
        </ShiftReg>
        <Node _name="Unbundle By Name" fields="msg,wParam,lParam" inputs="input cluster:pi.value" outputs="msg:ub.msg,wParam:ub.wParam,lParam:ub.lParam" uid="ub" uid_parent="loop"/>
        <Call inputs="hWnd:hi2.value,Msg:ub.msg,wParam:ub.wParam,lParam:ub.lParam,error in (no error):srl.value" outputs="return value:,error out:pm.error out" target="user32 PostMessageW.vi" uid="pm" uid_parent="loop"/>
        <Constant _name="WM_MOUSEMOVE" outputs="value:kmm.value" type="uint32" uid="kmm" uid_parent="loop" value="512"/>
        <Constant _name="MK_LBUTTON | MK_RBUTTON | MK_MBUTTON" outputs="value:kbtn.value" type="uint64" uid="kbtn" uid_parent="loop" value="19"/>
        <Node _name="Equal?" inputs="x:ub.msg,y:kmm.value" outputs="x = y?:ismv.x = y?" uid="ismv" uid_parent="loop"/>
        <Node _name="And" inputs="x:ub.wParam,y:kbtn.value" outputs="x .and. y?:btns.x .and. y?" uid="btns" uid_parent="loop"/>
        <Node _name="Equal To 0?" inputs="x:btns.x .and. y?" outputs="x = 0?:nobtn.x = 0?" uid="nobtn" uid_parent="loop"/>
        <Node _name="And" inputs="x:ismv.x = y?,y:nobtn.x = 0?" outputs="x .and. y?:hover.x .and. y?" uid="hover" uid_parent="loop"/>
        <Structure _name="Case Structure" selectin="hover.x .and. y?" uid="wc" uid_parent="loop">
          <Tunnel _id="In1" inputs="value:hi2.value" uid="wc_i1" uid_parent="wc"/>
          <Tunnel _id="In2" inputs="value:pm.error out" uid="wc_i2" uid_parent="wc"/>
          <CaseFrame label="Hover move\3A no wait (nothing depends on it being handled)" selector="True" selectout="" uid="wct" uid_parent="wc">
            <Tunnel _id="In1" outputs="value:" uid="wct1" uid_parent="wct"/>
            <Tunnel _id="In2" outputs="value:wct2.value" uid="wct2" uid_parent="wct"/>
            <Tunnel _id="Out1" inputs="value:wct2.value" uid="wcto" uid_parent="wct"/>
          </CaseFrame>
          <CaseFrame label="Wait until LabVIEW handled it" selector="False" selectout="" uid="wcf" uid_parent="wc">
            <Tunnel _id="In1" outputs="value:wcf1.value" uid="wcf1" uid_parent="wcf"/>
            <Tunnel _id="In2" outputs="value:wcf2.value" uid="wcf2" uid_parent="wcf"/>
            <Call inputs="hWnd:wcf1.value,error in:wcf2.value" outputs="error out:wih.error out" target="RemoteVI Wait Input Handled.vi" uid="wih" uid_parent="wcf"/>
            <Tunnel _id="Out1" inputs="value:wih.error out" uid="wcfo" uid_parent="wcf"/>
          </CaseFrame>
          <Tunnel _id="Out1" outputs="value:wco.value" uid="wco" uid_parent="wc"/>
        </Structure>
      </Structure>
      <Tunnel _id="Out1" inputs="value:srr.value" uid="f_o1" uid_parent="cmf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cm_o1.value" uid="cm_o1" uid_parent="cm"/>
  </Structure>
  <Indicator _name="popups out" conIdx="4" connection="recommended" description="popups\2C unchanged." inputs="value:pp.value" type="cluster{array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}.windows,int32.dx,int32.dy}" uid="po" uid_parent="root" value="[[],0,0]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:cm_o1.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
