<VI _name="RemoteVI Post Input.vi" description="Posts the Win32 messages from RemoteVI Translate Input.vi to the front panel window of VI\2C in order\2C with user32 PostMessageW. The window handle is Front Panel Window\3AOS Window\2C sign-extended I32 to I64 to U64. Posting does not wait for LabVIEW to process the messages. An incoming error posts nothing; an error from a post skips the rest.">
  <FreeLabel comment="One PostMessageW per post\2C in order" uid="lbl" uid_parent="root"/>
  <Control _name="VI" conIdx="0" connection="required" description="The VI whose front panel window receives the messages." outputs="value:vi.value" type="ref{LV.VI}" uid="vi" uid_parent="root" value=""/>
  <Control _name="posts" conIdx="5" connection="required" description="Messages to post\2C from RemoteVI Translate Input.vi." outputs="value:ps.value" type="array{cluster{uint32.msg,uint64.wParam,int64.lParam}}" uid="ps" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Property Node" fields="read+Front Panel Window\3AOS Window" inputs="reference:vi.value,error in (no error):ei.value" outputs="error out:pn.error out,Front Panel Window\3AOS Window:pn.Front Panel Window\3AOS Window" type="{LV.VI}" uid="pn" uid_parent="root"/>
  <Node _name="To Quad Integer" inputs="number:pn.Front Panel Window\3AOS Window" outputs="64bit integer:q1.64bit integer" uid="q1" uid_parent="root"/>
  <Node _name="To Unsigned Quad Integer" inputs="number:q1.64bit integer" outputs="unsigned 64bit integer:hw.unsigned 64bit integer" uid="hw" uid_parent="root"/>
  <Structure _name="For Loop" count="" label="Post each message" maxin="" maxout="" uid="loop" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ps.value" mode="index" outputs="value:pi.value" uid="pi" uid_parent="loop"/>
    <Tunnel _id="In2" inputs="value:hw.unsigned 64bit integer" outputs="value:hi.value" uid="hi" uid_parent="loop"/>
    <ShiftReg uid="sr" uid_parent="loop">
      <Left inputs="value:pn.error out" outputs="value:srl.value" uid="srl" uid_parent="sr"/>
      <Right inputs="value:pm.error out" outputs="value:srr.value" uid="srr" uid_parent="sr"/>
    </ShiftReg>
    <Node _name="Unbundle By Name" fields="msg,wParam,lParam" inputs="input cluster:pi.value" outputs="msg:ub.msg,wParam:ub.wParam,lParam:ub.lParam" uid="ub" uid_parent="loop"/>
    <Call inputs="hWnd:hi.value,Msg:ub.msg,wParam:ub.wParam,lParam:ub.lParam,error in (no error):srl.value" outputs="return value:,error out:pm.error out" target="user32 PostMessageW.vi" uid="pm" uid_parent="loop"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:srr.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
