<VI _name="RemoteVI Reopen Submenu.vi" description="Reopens the clicked submenu at its new place after RemoteVI Prepare Menu Click.vi closed it\3A posts VK_RIGHT (scan code 0x4D\2C extended) with RemoteVI Post Menu Key.vi\2C which LabVIEW answers by opening the submenu next to its moved parent with the clicked point under the host cursor\2C then waits 350 ms - a reopened menu ignores a click that follows sooner (a button-up about 10 ms after the reopen was ignored\2C measured). No VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served front panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="windows" conIdx="5" connection="required" description="The popups still open (Prepare Menu Click windows out)." outputs="value:win.value" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}" uid="win" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Structure _name="For Loop" count="" label="Handles" maxin="" maxout="" uid="froh" uid_parent="root">
    <Tunnel _id="In1" inputs="value:win.value" mode="index" outputs="value:rh_w.value" uid="rh_w" uid_parent="froh"/>
    <Node _name="Unbundle By Name" fields="hwnd" inputs="input cluster:rh_w.value" outputs="hwnd:rhu.hwnd" uid="rhu" uid_parent="froh"/>
    <Tunnel _id="Out1" inputs="value:rhu.hwnd" mode="index" outputs="value:roh.value" uid="roh" uid_parent="froh"/>
  </Structure>
  <Constant _name="VK_RIGHT" outputs="value:krv.value" type="uint64" uid="krv" uid_parent="root" value="39"/>
  <Constant _name="scan 0x4D\2C extended" outputs="value:krl.value" type="int64" uid="krl" uid_parent="root" value="21823489"/>
  <Call inputs="hWnd:hw.value,vk:krv.value,key lParam:krl.value,popup hWnds:roh.value,error in:ei.value" outputs="changed?:,error out:rpk.error out" target="RemoteVI Post Menu Key.vi" uid="rpk" uid_parent="root"/>
  <Constant _name="a reopened menu takes clicks after 350 ms" outputs="value:k350.value" type="uint32" uid="k350" uid_parent="root" value="350"/>
  <Node _name="Wait (ms)" inputs="milliseconds to wait:k350.value" outputs="millisecond timer value:" uid="w350" uid_parent="root"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in or the error of posting the key." inputs="value:rpk.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
