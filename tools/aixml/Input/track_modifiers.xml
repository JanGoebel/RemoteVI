<VI _name="RemoteVI Track Modifiers.vi" description="Keeps the modifier keys the remote user holds\2C per client (docs\5Cprotocol.md section 4.4). mods is a bit set\3A 1 Shift\2C 2 Ctrl\2C 4 Alt. A key message WM_KEYDOWN (256) of VK_SHIFT 0x10\2C VK_LSHIFT 0xA0 or VK_RSHIFT 0xA1 sets bit 1 and its WM_KEYUP (257) clears it - likewise 0x11/0xA2/0xA3 for Ctrl (bit 2) and 0x12/0xA4/0xA5 for Alt (bit 4). An allowed mouse message (512-522) carries the whole Shift and Ctrl state in wParam\3A bit 1 = MK_SHIFT (4)\2C bit 2 = MK_CONTROL (8)\3B Alt is kept. Anything else leaves mods unchanged. The server writes the result into the key state of LabVIEW's UI thread (RemoteVI Set Modifier Keys.vi) before posting\2C because LabVIEW reads the modifiers with GetKeyState and posted messages do not change that state (measured). Pure\3B reference trackModifiers() in tools\5Clib\5Cinput.mjs\2C vectors tests\5Cvectors\5Ctranslate.json (modifiers).">
  <FreeLabel comment="Key down/up of a modifier\2C or mouse MK_ bits" uid="lbl" uid_parent="root"/>
  <Control _name="kind" conIdx="0" connection="required" description="Message kind from RemoteVI Parse Input.vi." outputs="value:kind.value" type="uint16{invalid,mouse,key,ack}" uid="kind" uid_parent="root" value="0"/>
  <Control _name="msg" conIdx="5" connection="required" description="Win32 message number." outputs="value:msg.value" type="uint32" uid="msg" uid_parent="root" value="0"/>
  <Control _name="wParam" conIdx="7" connection="required" description="wParam\3A the virtual-key code of a key message\2C the MK_* flags of a mouse message." outputs="value:wp.value" type="uint64" uid="wp" uid_parent="root" value="0"/>
  <Control _name="mods in" conIdx="9" connection="required" description="Modifiers held before this message\3A 1 Shift\2C 2 Ctrl\2C 4 Alt." outputs="value:min.value" type="uint8" uid="min" uid_parent="root" value="0"/>
  <Indicator _name="mods out" conIdx="4" connection="recommended" description="Modifiers held after this message." inputs="value:res.s? t\3Af" type="uint8" uid="mout" uid_parent="root" value="0"/>

  <Constant outputs="value:kM.value" type="uint16{invalid,mouse,key,ack}" uid="kM" uid_parent="root" value="1"/>
  <Constant outputs="value:kK.value" type="uint16{invalid,mouse,key,ack}" uid="kK" uid_parent="root" value="2"/>
  <Constant _name="WM_KEYDOWN" outputs="value:kKD.value" type="uint32" uid="kKD" uid_parent="root" value="256"/>
  <Constant _name="WM_KEYUP" outputs="value:kKU.value" type="uint32" uid="kKU" uid_parent="root" value="257"/>
  <Constant _name="mouse messages" outputs="value:aMs.value" type="array{uint32}" uid="aMs" uid_parent="root" value="[512,513,514,515,516,517,518,519,520,521,522]"/>
  <Constant _name="modifier keys" outputs="value:aVK.value" type="array{uint64}" uid="aVK" uid_parent="root" value="[16,160,161,17,162,163,18,164,165]"/>
  <Constant _name="their bits" outputs="value:aBit.value" type="array{uint8}" uid="aBit" uid_parent="root" value="[1,1,1,2,2,2,4,4,4]"/>
  <Constant _name="MK_SHIFT" outputs="value:kMS.value" type="uint64" uid="kMS" uid_parent="root" value="4"/>
  <Constant _name="MK_CONTROL" outputs="value:kMC.value" type="uint64" uid="kMC" uid_parent="root" value="8"/>
  <Constant _name="Shift" outputs="value:b1.value" type="uint8" uid="b1" uid_parent="root" value="1"/>
  <Constant _name="Ctrl" outputs="value:b2.value" type="uint8" uid="b2" uid_parent="root" value="2"/>
  <Constant _name="Alt" outputs="value:b4.value" type="uint8" uid="b4" uid_parent="root" value="4"/>
  <Constant _name="none" outputs="value:b0.value" type="uint8" uid="b0" uid_parent="root" value="0"/>

  <Node _name="Equal?" inputs="x:kind.value,y:kK.value" outputs="x = y?:isK.x = y?" uid="isK" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:kind.value,y:kM.value" outputs="x = y?:isM.x = y?" uid="isM" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:msg.value,y:kKD.value" outputs="x = y?:isD.x = y?" uid="isD" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:msg.value,y:kKU.value" outputs="x = y?:isU.x = y?" uid="isU" uid_parent="root"/>
  <Node _name="Search 1D Array" inputs="1D array:aMs.value,element:msg.value" outputs="index of element:sMs.index of element" uid="sMs" uid_parent="root"/>
  <Node _name="Greater Or Equal To 0?" inputs="x:sMs.index of element" outputs="x &gt;= 0?:okM.x &gt;= 0?" uid="okM" uid_parent="root"/>
  <Node _name="And" inputs="x:isM.x = y?,y:okM.x &gt;= 0?" outputs="x .and. y?:mouse.x .and. y?" uid="mouse" uid_parent="root"/>

  <Node _name="Search 1D Array" inputs="1D array:aVK.value,element:wp.value" outputs="index of element:sVK.index of element" uid="sVK" uid_parent="root"/>
  <Node _name="Index Array" inputs="array:aBit.value,index:sVK.index of element" outputs="element:bit.element" uid="bit" uid_parent="root"/>
  <Node _name="Or" inputs="x:min.value,y:bit.element" outputs="x .or. y?:mSet.x .or. y?" uid="mSet" uid_parent="root"/>
  <Node _name="Not" inputs="x:bit.element" outputs=".not. x?:nBit..not. x?" uid="nBit" uid_parent="root"/>
  <Node _name="And" inputs="x:min.value,y:nBit..not. x?" outputs="x .and. y?:mClr.x .and. y?" uid="mClr" uid_parent="root"/>
  <Node _name="Select" inputs="t:mClr.x .and. y?,s:isU.x = y?,f:min.value" outputs="s? t\3Af:kUp.s? t\3Af" uid="kUp" uid_parent="root"/>
  <Node _name="Select" inputs="t:mSet.x .or. y?,s:isD.x = y?,f:kUp.s? t\3Af" outputs="s? t\3Af:kMods.s? t\3Af" uid="kMods" uid_parent="root"/>

  <Node _name="And" inputs="x:wp.value,y:kMS.value" outputs="x .and. y?:wS.x .and. y?" uid="wS" uid_parent="root"/>
  <Node _name="And" inputs="x:wp.value,y:kMC.value" outputs="x .and. y?:wC.x .and. y?" uid="wC" uid_parent="root"/>
  <Node _name="Not Equal To 0?" inputs="x:wS.x .and. y?" outputs="x != 0?:hS.x != 0?" uid="hS" uid_parent="root"/>
  <Node _name="Not Equal To 0?" inputs="x:wC.x .and. y?" outputs="x != 0?:hC.x != 0?" uid="hC" uid_parent="root"/>
  <Node _name="Select" inputs="t:b1.value,s:hS.x != 0?,f:b0.value" outputs="s? t\3Af:mS.s? t\3Af" uid="mS" uid_parent="root"/>
  <Node _name="Select" inputs="t:b2.value,s:hC.x != 0?,f:b0.value" outputs="s? t\3Af:mC.s? t\3Af" uid="mC" uid_parent="root"/>
  <Node _name="And" inputs="x:min.value,y:b4.value" outputs="x .and. y?:mA.x .and. y?" uid="mA" uid_parent="root"/>
  <Node _name="Or" inputs="x:mS.s? t\3Af,y:mC.s? t\3Af" outputs="x .or. y?:mSC.x .or. y?" uid="mSC" uid_parent="root"/>
  <Node _name="Or" inputs="x:mSC.x .or. y?,y:mA.x .and. y?" outputs="x .or. y?:mMods.x .or. y?" uid="mMods" uid_parent="root"/>

  <Node _name="Select" inputs="t:mMods.x .or. y?,s:mouse.x .and. y?,f:min.value" outputs="s? t\3Af:r1.s? t\3Af" uid="r1" uid_parent="root"/>
  <Node _name="Select" inputs="t:kMods.s? t\3Af,s:isK.x = y?,f:r1.s? t\3Af" outputs="s? t\3Af:res.s? t\3Af" uid="res" uid_parent="root"/>
</VI>
