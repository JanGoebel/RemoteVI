<VI _name="RemoteVI Wait Popup Click Handled.vi" description="After a click on a popup has been posted\2C waits until LabVIEW has handled it (RemoteVI Wait Popups Change.vi\3A until the popups differ from popup hWnds - the menu closed or another popup opened - at most 300 ms after a button-up and 50 ms after a button-down) so that the next message cannot move the popups before LabVIEW handled this one. A click on an entry that opens a submenu only highlights it (measured\3A a second click opens it)\3B so when a button-up on a menu (menu? TRUE) leaves the popups unchanged\2C VK_RIGHT opens the highlighted entry's submenu (RemoteVI Post Menu Key.vi\3B it does nothing on an entry without one\2C measured). No VI Server call.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The served front panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="popup hWnds" conIdx="5" connection="required" description="Window handles of the popups the click was aimed at." outputs="value:ph.value" type="array{uint64}" uid="ph" uid_parent="root" value="[]"/>
  <Control _name="posts" conIdx="7" connection="required" description="The messages of the click." outputs="value:ps.value" type="array{cluster{uint32.msg,uint64.wParam,int64.lParam}}" uid="ps" uid_parent="root" value="[]"/>
  <Control _name="menu?" conIdx="9" connection="recommended" description="TRUE when the click was on a LabVIEW menu." outputs="value:menu.value" type="bool" uid="menu" uid_parent="root" value="false"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant outputs="value:i0.value" type="int32" uid="i0" uid_parent="root" value="0"/>
  <Node _name="Index Array" inputs="array:ps.value,index:i0.value" outputs="element:p0.element" uid="p0" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="msg" inputs="input cluster:p0.element" outputs="msg:p0u.msg" uid="p0u" uid_parent="root"/>
  <Constant _name="button up" outputs="value:aU.value" type="array{uint32}" uid="aU" uid_parent="root" value="[514,517,520]"/>
  <Node _name="Search 1D Array" inputs="1D array:aU.value,element:p0u.msg" outputs="index of element:sU.index of element" uid="sU" uid_parent="root"/>
  <Node _name="Greater Or Equal To 0?" inputs="x:sU.index of element" outputs="x &gt;= 0?:isU.x &gt;= 0?" uid="isU" uid_parent="root"/>
  <Constant _name="300 ms after an up" outputs="value:k300.value" type="uint32" uid="k300" uid_parent="root" value="300"/>
  <Constant _name="50 ms after a down" outputs="value:k50.value" type="uint32" uid="k50" uid_parent="root" value="50"/>
  <Node _name="Select" inputs="t:k300.value,s:isU.x &gt;= 0?,f:k50.value" outputs="s? t\3Af:maxw.s? t\3Af" uid="maxw" uid_parent="root"/>
  <Call inputs="panel hWnd:hw.value,popup hWnds:ph.value,timeout ms:maxw.s? t\3Af,error in:ei.value" outputs="changed?:wpc.changed?,error out:wpc.error out" target="RemoteVI Wait Popups Change.vi" uid="wpc" uid_parent="root"/>
  <Node _name="Not" inputs="x:wpc.changed?" outputs=".not. x?:nchg..not. x?" uid="nchg" uid_parent="root"/>
  <Node _name="And" inputs="x:isU.x &gt;= 0?,y:menu.value" outputs="x .and. y?:umn.x .and. y?" uid="umn" uid_parent="root"/>
  <Node _name="And" inputs="x:umn.x .and. y?,y:nchg..not. x?" outputs="x .and. y?:opn.x .and. y?" uid="opn" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="opn.x .and. y?" uid="cop" uid_parent="root">
    <Tunnel _id="In1" inputs="value:wpc.error out" uid="cop_i1" uid_parent="cop"/>
    <Tunnel _id="In2" inputs="value:hw.value" uid="cop_i2" uid_parent="cop"/>
    <Tunnel _id="In3" inputs="value:ph.value" uid="cop_i3" uid_parent="cop"/>
    <CaseFrame label="Menu unchanged after a click\3A open the entry's submenu" selector="True" selectout="" uid="copt" uid_parent="cop">
      <Tunnel _id="In1" outputs="value:op_e.value" uid="op_e" uid_parent="copt"/>
      <Tunnel _id="In2" outputs="value:op_hw.value" uid="op_hw" uid_parent="copt"/>
      <Tunnel _id="In3" outputs="value:op_ph.value" uid="op_ph" uid_parent="copt"/>
      <Constant _name="VK_RIGHT" outputs="value:kov.value" type="uint64" uid="kov" uid_parent="copt" value="39"/>
      <Constant _name="scan 0x4D\2C extended" outputs="value:kol.value" type="int64" uid="kol" uid_parent="copt" value="21823489"/>
      <Call inputs="hWnd:op_hw.value,vk:kov.value,key lParam:kol.value,popup hWnds:op_ph.value,error in:op_e.value" outputs="changed?:,error out:opk.error out" target="RemoteVI Post Menu Key.vi" uid="opk" uid_parent="copt"/>
      <Tunnel _id="Out1" inputs="value:opk.error out" uid="op_o1" uid_parent="copt"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="copf" uid_parent="cop">
      <Tunnel _id="In1" outputs="value:oq_e.value" uid="oq_e" uid_parent="copf"/>
      <Tunnel _id="In2" outputs="value:" uid="oq_hw" uid_parent="copf"/>
      <Tunnel _id="In3" outputs="value:" uid="oq_ph" uid_parent="copf"/>
      <Tunnel _id="Out1" inputs="value:oq_e.value" uid="oq_o1" uid_parent="copf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cop_o1.value" uid="cop_o1" uid_parent="cop"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Standard error out." inputs="value:cop_o1.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
