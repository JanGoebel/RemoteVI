<VI _name="RemoteVI Write Modifiers.vi" description="Writes the modifier keys the remote user holds into the key state of the UI thread that owns hWnd. A panel of this LabVIEW\3A RemoteVI Set Modifier Keys.vi (SetKeyboardState in this LabVIEW's UI thread). A window of another LabVIEW reached over VI Server (RemoteVI Remote Target.vi has an entry for hWnd)\3A RemoteVI Remote Hooks.vi runs Set Modifier Keys INSIDE that process (RemoteVI Call Hooks.vi)\2C so its UI thread gets them exactly as a panel of this LabVIEW does. Any other window (another process without VI Server)\3A nothing is written - its key state belongs to its own input thread\3B the mouse messages still carry MK_SHIFT and MK_CONTROL. An incoming error skips the write.">
  <Control _name="hWnd" conIdx="0" connection="required" description="The shared window (0 = this LabVIEW)." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="mods" conIdx="1" connection="required" description="1 Shift\2C 2 Ctrl\2C 4 Alt." outputs="value:mods.value" type="uint8" uid="mods" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Nothing is written on an incoming error." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant outputs="value:kf.value" type="bool" uid="kf" uid_parent="root" value="false"/>
  <Call inputs="put?:kf.value,hWnd:hw.value,remove?:kf.value" outputs="found?:rt.found?,hooks out:rt.hooks out" target="RemoteVI Remote Target.vi" uid="rt" uid_parent="root"/>
  <Call inputs="hWnd:hw.value" outputs="process ID:wp.process ID,thread ID:,error out:" target="user32 GetWindowThreadProcessId.vi" uid="wp" uid_parent="root"/>
  <Call inputs="" outputs="process ID:mp.process ID,error out:" target="kernel32 GetCurrentProcessId.vi" uid="mp" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:wp.process ID,y:mp.process ID" outputs="x = y?:mine.v" uid="mine" uid_parent="root"/>
  <Node _name="Equal To 0?" inputs="x:hw.value" outputs="x = 0?:none.v" uid="none" uid_parent="root"/>
  <Node _name="Or" inputs="x:mine.v,y:none.v" outputs="x .or. y?:local.v" uid="local" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="rt.found?" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:rt.hooks out" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:mods.value" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:ei.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:local.v" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:hw.value" uid="cs_i5" uid_parent="cs"/>
    <CaseFrame label="VI Server\3A inside the other LabVIEW" selector="True" selectout="" uid="cst" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:t_h.value" uid="t_h" uid_parent="cst"/>
      <Tunnel _id="In2" outputs="value:t_m.value" uid="t_m" uid_parent="cst"/>
      <Tunnel _id="In3" outputs="value:t_e.value" uid="t_e" uid_parent="cst"/>
      <Tunnel _id="In4" outputs="value:" uid="t_l" uid_parent="cst"/>
      <Tunnel _id="In5" outputs="value:" uid="t_w" uid_parent="cst"/>
      <Constant outputs="value:tf.value" type="bool" uid="tf" uid_parent="cst" value="false"/>
      <Call inputs="hooks:t_h.value,panel?:tf.value,mods:t_m.value,error in:t_e.value" outputs="error out:ch.error out" target="RemoteVI Call Hooks.vi" uid="ch" uid_parent="cst"/>
      <Tunnel _id="Out1" inputs="value:ch.error out" uid="t_o1" uid_parent="cst"/>
    </CaseFrame>
    <CaseFrame label="This LabVIEW\2C or another process without VI Server" selector="False" selectout="" uid="csf" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:" uid="f_h" uid_parent="csf"/>
      <Tunnel _id="In2" outputs="value:f_m.value" uid="f_m" uid_parent="csf"/>
      <Tunnel _id="In3" outputs="value:f_e.value" uid="f_e" uid_parent="csf"/>
      <Tunnel _id="In4" outputs="value:f_l.value" uid="f_l" uid_parent="csf"/>
      <Tunnel _id="In5" outputs="value:f_w.value" uid="f_w" uid_parent="csf"/>
      <Structure _name="Case Structure" selectin="f_l.value" uid="cl" uid_parent="csf">
        <Tunnel _id="In1" inputs="value:f_m.value" uid="cl_i1" uid_parent="cl"/>
        <Tunnel _id="In2" inputs="value:f_e.value" uid="cl_i2" uid_parent="cl"/>
        <Tunnel _id="In3" inputs="value:f_w.value" uid="cl_i3" uid_parent="cl"/>
        <CaseFrame label="This LabVIEW" selector="True" selectout="" uid="clt" uid_parent="cl">
          <Tunnel _id="In1" outputs="value:l_m.value" uid="l_m" uid_parent="clt"/>
          <Tunnel _id="In2" outputs="value:l_e.value" uid="l_e" uid_parent="clt"/>
          <Tunnel _id="In3" outputs="value:" uid="l_w" uid_parent="clt"/>
          <Call inputs="mods:l_m.value,error in:l_e.value" outputs="error out:smk.error out" target="RemoteVI Set Modifier Keys.vi" uid="smk" uid_parent="clt"/>
          <Tunnel _id="Out1" inputs="value:smk.error out" uid="l_o1" uid_parent="clt"/>
        </CaseFrame>
        <CaseFrame label="Another process without VI Server\3A its key state cannot be set (only the mouse messages carry MK_SHIFT and MK_CONTROL)" selector="False" selectout="" uid="clf" uid_parent="cl">
          <Tunnel _id="In1" outputs="value:" uid="o_m" uid_parent="clf"/>
          <Tunnel _id="In2" outputs="value:o_e.value" uid="o_e" uid_parent="clf"/>
          <Tunnel _id="In3" outputs="value:" uid="o_w" uid_parent="clf"/>
          <Tunnel _id="Out1" inputs="value:o_e.value" uid="o_o1" uid_parent="clf"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:clo.value" uid="clo" uid_parent="cl"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:clo.value" uid="f_o1" uid_parent="csf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cso.value" uid="cso" uid_parent="cs"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in or the error of the write." inputs="value:cso.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
