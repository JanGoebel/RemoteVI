<VI _name="RemoteVI Tips Message.vi" description="Builds the text message tips &lt;json&gt; (docs\5Cprotocol.md section 3.3) from the tip strips RemoteVI Read Tips.vi read\3A a JSON array with one object per control whose tip strip text is not empty\2C x\2C y\2C w\2C h\2C text in that order - tips [] when there is none. text is the control's Tip Strip as LabVIEW holds it (bytes of the system code page)\3B each byte is widened to one UTF-16 code unit (exact for ASCII and Latin-1\3B Windows-1252 differs only in 0x80-0x9F) and written as an ASCII-only JSON string literal by RemoteVI JSON String.vi\2C so the message is valid UTF-8 whatever the host's code page. The JSON is written field by field\2C like RemoteVI Windows Message.vi. Pure function\2C cannot fail. Reference\3A tipsMessage() in tools\5Clib\5Cprotocol.mjs\2C vectors tests\5Cvectors\5Ctext.json.">
  <FreeLabel comment="One JSON object per control with a tip strip\2C comma joined" uid="lbl" uid_parent="root"/>
  <Control _name="tips" conIdx="0" connection="required" description="Tip strips of the visible controls\3A bounds x\2C y\2C w\2C h in frame coordinates and the tip strip text (empty = none)." outputs="value:tl.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,string.text}}" uid="tl" uid_parent="root" value="[]"/>
  <Constant outputs="value:k1.value" type="string" uid="k1" uid_parent="root" value="\2C{&quot;x&quot;\3A"/>
  <Constant outputs="value:k2.value" type="string" uid="k2" uid_parent="root" value="\2C&quot;y&quot;\3A"/>
  <Constant outputs="value:k3.value" type="string" uid="k3" uid_parent="root" value="\2C&quot;w&quot;\3A"/>
  <Constant outputs="value:k4.value" type="string" uid="k4" uid_parent="root" value="\2C&quot;h&quot;\3A"/>
  <Constant outputs="value:k5.value" type="string" uid="k5" uid_parent="root" value="\2C&quot;text&quot;\3A"/>
  <Constant outputs="value:k6.value" type="string" uid="k6" uid_parent="root" value="}"/>
  <Structure _name="For Loop" count="" label="One object per control with a tip strip" maxin="" maxout="" uid="fl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:tl.value" mode="index" outputs="value:t.value" uid="t" uid_parent="fl"/>
    <Tunnel _id="In2" inputs="value:k1.value" outputs="value:t1.value" uid="t1" uid_parent="fl"/>
    <Tunnel _id="In3" inputs="value:k2.value" outputs="value:t2.value" uid="t2" uid_parent="fl"/>
    <Tunnel _id="In4" inputs="value:k3.value" outputs="value:t3.value" uid="t3" uid_parent="fl"/>
    <Tunnel _id="In5" inputs="value:k4.value" outputs="value:t4.value" uid="t4" uid_parent="fl"/>
    <Tunnel _id="In6" inputs="value:k5.value" outputs="value:t5.value" uid="t5" uid_parent="fl"/>
    <Tunnel _id="In7" inputs="value:k6.value" outputs="value:t6.value" uid="t6" uid_parent="fl"/>
    <Node _name="Unbundle By Name" fields="x,y,w,h,text" inputs="input cluster:t.value" outputs="x:u.x,y:u.y,w:u.w,h:u.h,text:u.text" uid="u" uid_parent="fl"/>
    <Node _name="Empty String/Path?" inputs="string/path:u.text" outputs="empty?:em.empty?" uid="em" uid_parent="fl"/>
    <Node _name="Not" inputs="x:em.empty?" outputs=".not. x?:keep..not. x?" uid="keep" uid_parent="fl"/>
    <Node _name="String To Byte Array" inputs="string:u.text" outputs="unsigned byte array:sb.unsigned byte array" uid="sb" uid_parent="fl"/>
    <Node _name="To Unsigned Word Integer" inputs="number:sb.unsigned byte array" outputs="unsigned 16bit integer:w16.unsigned 16bit integer" uid="w16" uid_parent="fl"/>
    <Call inputs="text:w16.unsigned 16bit integer" outputs="json:js.json" target="RemoteVI JSON String.vi" uid="js" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:u.x" outputs="decimal integer string:dx.v" uid="dx" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:u.y" outputs="decimal integer string:dy.v" uid="dy" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:u.w" outputs="decimal integer string:dw.v" uid="dw" uid_parent="fl"/>
    <Node _name="Number To Decimal String" inputs="number:u.h" outputs="decimal integer string:dh.v" uid="dh" uid_parent="fl"/>
    <Node _name="Concatenate Strings" inputs="string:t1.value,string:dx.v,string:t2.value,string:dy.v,string:t3.value,string:dw.v,string:t4.value,string:dh.v,string:t5.value,string:js.json,string:t6.value" outputs="concatenated string:obj.v" uid="obj" uid_parent="fl"/>
    <Tunnel _id="Out1" inputs="value:obj.v" mode="index" cond="keep..not. x?" outputs="value:objs.value" uid="objs" uid_parent="fl"/>
  </Structure>
  <Node _name="Concatenate Strings" inputs="string:objs.value" outputs="concatenated string:all.v" uid="all" uid_parent="root"/>
  <Constant _name="drop the leading comma" outputs="value:one.value" type="int32" uid="one" uid_parent="root" value="1"/>
  <Node _name="String Subset" inputs="string:all.v,offset (0):one.value" outputs="substring:body.v" uid="body" uid_parent="root"/>
  <Constant outputs="value:pre.value" type="string" uid="pre" uid_parent="root" value="tips ["/>
  <Constant outputs="value:post.value" type="string" uid="post" uid_parent="root" value="]"/>
  <Node _name="Concatenate Strings" inputs="string:pre.value,string:body.v,string:post.value" outputs="concatenated string:msg.v" uid="msg" uid_parent="root"/>
  <Indicator _name="message" conIdx="4" connection="recommended" description="The text message tips [...]\2C to be sent as one WebSocket text frame." inputs="value:msg.v" type="string" uid="o_msg" uid_parent="root" value=""/>
</VI>
