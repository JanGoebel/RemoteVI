<VI _name="RemoteVI Add Client.vi" description="Greets a freshly upgraded WebSocket connection and appends it to clients\3A restores a minimized panel (RemoteVI Restore If Minimized.vi on hWnd)\2C writes hello (the title and viewonly text messages) followed by overlay frame (the current OVERLAY\2C empty when no popup is open) with a 2 s timeout\2C and appends a new client with that connection\3B closed is set when the write failed. connection is the TCP connection refnum type-cast to U32.">
  <Control _name="connection" conIdx="0" connection="required" description="The upgraded TCP connection refnum\2C type-cast to U32." outputs="value:cin.value" type="uint32" uid="cin" uid_parent="root" value="0"/>
  <Control _name="clients" conIdx="5" connection="required" description="The connected clients (same cluster as in RemoteVI Server Loop.vi)." outputs="value:cl.value" type="array{cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since}}" uid="cl" uid_parent="root" value="[]"/>
  <Control _name="hello" conIdx="7" connection="required" description="The greeting frames (RemoteVI Greeting.vi)." outputs="value:hel.value" type="string" uid="hel" uid_parent="root" value=""/>
  <Control _name="overlay frame" conIdx="9" connection="recommended" description="The last OVERLAY frame sent to the clients\3B empty when no popup is open." outputs="value:ovf.value" type="string" uid="ovf" uid_parent="root" value=""/>
  <Control _name="hWnd" conIdx="1" connection="recommended" description="Native handle of the served front panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>

  <Structure _name="For Loop" count="" label="Never runs\3A TCP refnum type only" maxin="tn0.value" maxout="" uid="tpl" uid_parent="root">
    <Constant outputs="value:tp0.value" type="uint16" uid="tp0" uid_parent="tpl" value="0"/>
    <Node _name="TCP Open Connection" inputs="remote port or service name:tp0.value" outputs="connection ID:toc.connection ID" uid="toc" uid_parent="tpl"/>
    <Tunnel _id="Out1" inputs="value:toc.connection ID" outputs="value:tplo.value" uid="tplo" uid_parent="tpl"/>
  </Structure>
  <Constant outputs="value:tn0.value" type="int32" uid="tn0" uid_parent="root" value="0"/>
  <Node _name="Type Cast" inputs="x:cin.value,type:tplo.value" outputs="*(type *) &amp;x:conn.*(type *) &amp;x" uid="conn" uid_parent="root"/>

  <Node _name="Concatenate Strings" inputs="string:hel.value,string:ovf.value" outputs="concatenated string:hov.concatenated string" uid="hov" uid_parent="root"/>
  <Call inputs="hWnd:hw.value" outputs="was minimized?:,error out:" target="RemoteVI Restore If Minimized.vi" uid="rim" uid_parent="root"/>
  <Constant outputs="value:wto.value" type="int32" uid="wto" uid_parent="root" value="2000"/>
  <Node _name="TCP Write" inputs="connection ID:conn.*(type *) &amp;x,data in:hov.concatenated string,?parm9:wto.value" outputs="error out:tw.error out" uid="tw" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="status" inputs="input cluster:tw.error out" outputs="status:tws.status" uid="tws" uid_parent="root"/>
  <Constant _name="new client" outputs="value:cl0.value" type="cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since}" uid="cl0" uid_parent="root" value="[0,,0,0,[],false,false,0,0,0]"/>
  <Node _name="Bundle By Name" fields="connection,closed" inputs="connection:cin.value,closed:tws.status,input cluster:cl0.value" outputs="output cluster:nc.output cluster" uid="nc" uid_parent="root"/>
  <Node _name="Build Array" inputs="array:cl.value,element:nc.output cluster" outputs="appended array:ba.appended array" uid="ba" uid_parent="root"/>
  <Indicator _name="clients out" conIdx="4" connection="recommended" description="clients with the new client appended." inputs="value:ba.appended array" type="array{cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since}}" uid="o_cl" uid_parent="root" value="[]"/>
</VI>
