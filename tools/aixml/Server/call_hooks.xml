<VI _name="RemoteVI Call Hooks.vi" description="Runs RemoteVI Remote Hooks.vi in the other LabVIEW (hooks\2C opened there by RemoteVI Connect VI Server.vi) over VI Server\3A sets its controls (Set Control Value)\2C runs it and waits (Run VI)\2C and reads tips out\2C splitters out and bars out back (Get Control Value) when panel? is TRUE. One VI Server round trip per control\2C about a millisecond each on this computer. On an error the inputs pass through.">
  <Control _name="hooks" conIdx="0" connection="required" description="RemoteVI Remote Hooks.vi in the other LabVIEW." outputs="value:hk.value" type="ref{LV.VI}" uid="hk" uid_parent="root" value=""/>
  <Control _name="panel?" conIdx="1" connection="recommended" description="FALSE\3A write mods. TRUE\3A read the tip strips and splitter bars." outputs="value:pn.value" type="bool" uid="pn" uid_parent="root" value="false"/>
  <Control _name="mods" conIdx="2" connection="recommended" description="1 Shift\2C 2 Ctrl\2C 4 Alt." outputs="value:mods.value" type="uint8" uid="mods" uid_parent="root" value="0"/>
  <Control _name="VI name" conIdx="3" connection="recommended" description="The shared VI's name there." outputs="value:vn.value" type="string" uid="vn" uid_parent="root" value=""/>
  <Control _name="origin" conIdx="5" connection="recommended" description="Where the panel area starts inside the frame." outputs="value:og.value" type="cluster{int32.x,int32.y}" uid="og" uid_parent="root" value="[0,0]"/>
  <Control _name="tips in" conIdx="6" connection="recommended" description="The last tips message." outputs="value:ti.value" type="string" uid="ti" uid_parent="root" value="tips []"/>
  <Control _name="splitters in" conIdx="7" connection="recommended" description="The last splitters message." outputs="value:si.value" type="string" uid="si" uid_parent="root" value="splitters []"/>
  <Control _name="bars in" conIdx="8" connection="recommended" description="The last bars." outputs="value:bi.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="bi" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Nothing is called on an incoming error." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant outputs="value:n1.value" type="string" uid="n1" uid_parent="root" value="panel?"/>
  <Node _name="To Variant" inputs="anything:pn.value" outputs="Variant:v1.Variant" uid="v1" uid_parent="root"/>
  <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:hk.value,error in (no error):ei.value,Control Name:n1.value,Value:v1.Variant" outputs="reference out:,error out:s1.error out" uid="s1" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="pn.value" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:hk.value" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:s1.error out" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:mods.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:vn.value" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:og.value" uid="cs_i5" uid_parent="cs"/>
    <Tunnel _id="In6" inputs="value:ti.value" uid="cs_i6" uid_parent="cs"/>
    <Tunnel _id="In7" inputs="value:si.value" uid="cs_i7" uid_parent="cs"/>
    <Tunnel _id="In8" inputs="value:bi.value" uid="cs_i8" uid_parent="cs"/>
    <CaseFrame label="Modifier keys\3A set mods\2C run" selector="False" selectout="" uid="csf" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:f_h.value" uid="f_h" uid_parent="csf"/>
      <Tunnel _id="In2" outputs="value:f_e.value" uid="f_e" uid_parent="csf"/>
      <Tunnel _id="In3" outputs="value:f_m.value" uid="f_m" uid_parent="csf"/>
      <Tunnel _id="In4" outputs="value:" uid="f_vn" uid_parent="csf"/>
      <Tunnel _id="In5" outputs="value:" uid="f_og" uid_parent="csf"/>
      <Tunnel _id="In6" outputs="value:f_ti.value" uid="f_ti" uid_parent="csf"/>
      <Tunnel _id="In7" outputs="value:f_si.value" uid="f_si" uid_parent="csf"/>
      <Tunnel _id="In8" outputs="value:f_bi.value" uid="f_bi" uid_parent="csf"/>
      <Constant outputs="value:fn.value" type="string" uid="fn" uid_parent="csf" value="mods"/>
      <Node _name="To Variant" inputs="anything:f_m.value" outputs="Variant:fv.Variant" uid="fv" uid_parent="csf"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:f_h.value,error in (no error):f_e.value,Control Name:fn.value,Value:fv.Variant" outputs="reference out:,error out:fs.error out" uid="fs" uid_parent="csf"/>
      <Constant outputs="value:fw.value" type="bool" uid="fw" uid_parent="csf" value="true"/>
      <Constant outputs="value:fa.value" type="bool" uid="fa" uid_parent="csf" value="false"/>
      <Node _name="Invoke Node" target="Run VI" type="{LV.VI}" inputs="reference:f_h.value,error in (no error):fs.error out,Wait until done:fw.value,Auto Dispose Ref:fa.value" outputs="reference out:,error out:fr.error out" uid="fr" uid_parent="csf"/>
      <Tunnel _id="Out1" inputs="value:f_ti.value" uid="f_o1" uid_parent="csf"/>
      <Tunnel _id="Out2" inputs="value:f_si.value" uid="f_o2" uid_parent="csf"/>
      <Tunnel _id="Out3" inputs="value:f_bi.value" uid="f_o3" uid_parent="csf"/>
      <Tunnel _id="Out4" inputs="value:fr.error out" uid="f_o4" uid_parent="csf"/>
    </CaseFrame>
    <CaseFrame label="Tip strips and splitters\3A set the VI\2C run\2C read back" selector="True" selectout="" uid="cst" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:t_h.value" uid="t_h" uid_parent="cst"/>
      <Tunnel _id="In2" outputs="value:t_e.value" uid="t_e" uid_parent="cst"/>
      <Tunnel _id="In3" outputs="value:" uid="t_m" uid_parent="cst"/>
      <Tunnel _id="In4" outputs="value:t_vn.value" uid="t_vn" uid_parent="cst"/>
      <Tunnel _id="In5" outputs="value:t_og.value" uid="t_og" uid_parent="cst"/>
      <Tunnel _id="In6" outputs="value:t_ti.value" uid="t_ti" uid_parent="cst"/>
      <Tunnel _id="In7" outputs="value:t_si.value" uid="t_si" uid_parent="cst"/>
      <Tunnel _id="In8" outputs="value:t_bi.value" uid="t_bi" uid_parent="cst"/>
      <Constant outputs="value:c2.value" type="string" uid="c2" uid_parent="cst" value="VI name"/>
      <Node _name="To Variant" inputs="anything:t_vn.value" outputs="Variant:w2.Variant" uid="w2" uid_parent="cst"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):t_e.value,Control Name:c2.value,Value:w2.Variant" outputs="reference out:,error out:x2.error out" uid="x2" uid_parent="cst"/>
      <Constant outputs="value:c3.value" type="string" uid="c3" uid_parent="cst" value="origin"/>
      <Node _name="To Variant" inputs="anything:t_og.value" outputs="Variant:w3.Variant" uid="w3" uid_parent="cst"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):x2.error out,Control Name:c3.value,Value:w3.Variant" outputs="reference out:,error out:x3.error out" uid="x3" uid_parent="cst"/>
      <Constant outputs="value:c4.value" type="string" uid="c4" uid_parent="cst" value="tips in"/>
      <Node _name="To Variant" inputs="anything:t_ti.value" outputs="Variant:w4.Variant" uid="w4" uid_parent="cst"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):x3.error out,Control Name:c4.value,Value:w4.Variant" outputs="reference out:,error out:x4.error out" uid="x4" uid_parent="cst"/>
      <Constant outputs="value:c5.value" type="string" uid="c5" uid_parent="cst" value="splitters in"/>
      <Node _name="To Variant" inputs="anything:t_si.value" outputs="Variant:w5.Variant" uid="w5" uid_parent="cst"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):x4.error out,Control Name:c5.value,Value:w5.Variant" outputs="reference out:,error out:x5.error out" uid="x5" uid_parent="cst"/>
      <Constant outputs="value:c6.value" type="string" uid="c6" uid_parent="cst" value="bars in"/>
      <Node _name="To Variant" inputs="anything:t_bi.value" outputs="Variant:w6.Variant" uid="w6" uid_parent="cst"/>
      <Node _name="Invoke Node" target="Set Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):x5.error out,Control Name:c6.value,Value:w6.Variant" outputs="reference out:,error out:x6.error out" uid="x6" uid_parent="cst"/>
      <Constant outputs="value:tw.value" type="bool" uid="tw" uid_parent="cst" value="true"/>
      <Constant outputs="value:ta.value" type="bool" uid="ta" uid_parent="cst" value="false"/>
      <Node _name="Invoke Node" target="Run VI" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):x6.error out,Wait until done:tw.value,Auto Dispose Ref:ta.value" outputs="reference out:,error out:tr.error out" uid="tr" uid_parent="cst"/>
      <Constant outputs="value:g1n.value" type="string" uid="g1n" uid_parent="cst" value="tips out"/>
      <Node _name="Invoke Node" target="Get Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):tr.error out,Control Name:g1n.value" outputs="reference out:,error out:g1.error out,Get Control Value Variant:g1.v" uid="g1" uid_parent="cst"/>
      <Node _name="Variant To Data" inputs="variant:g1.v,type:t_ti.value,error in:g1.error out" outputs="data:d1.data,error out:d1.error out" uid="d1" uid_parent="cst"/>
      <Constant outputs="value:g2n.value" type="string" uid="g2n" uid_parent="cst" value="splitters out"/>
      <Node _name="Invoke Node" target="Get Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):d1.error out,Control Name:g2n.value" outputs="reference out:,error out:g2.error out,Get Control Value Variant:g2.v" uid="g2" uid_parent="cst"/>
      <Node _name="Variant To Data" inputs="variant:g2.v,type:t_si.value,error in:g2.error out" outputs="data:d2.data,error out:d2.error out" uid="d2" uid_parent="cst"/>
      <Constant outputs="value:g3n.value" type="string" uid="g3n" uid_parent="cst" value="bars out"/>
      <Node _name="Invoke Node" target="Get Control Value [Variant]" type="{LV.VI}" inputs="reference:t_h.value,error in (no error):d2.error out,Control Name:g3n.value" outputs="reference out:,error out:g3.error out,Get Control Value Variant:g3.v" uid="g3" uid_parent="cst"/>
      <Node _name="Variant To Data" inputs="variant:g3.v,type:t_bi.value,error in:g3.error out" outputs="data:d3.data,error out:d3.error out" uid="d3" uid_parent="cst"/>
      <Node _name="Unbundle By Name" fields="status" inputs="input cluster:d3.error out" outputs="status:ds.status" uid="ds" uid_parent="cst"/>
      <Node _name="Select" inputs="t:t_ti.value,s:ds.status,f:d1.data" outputs="s? t\3Af:o1.v" uid="o1" uid_parent="cst"/>
      <Node _name="Select" inputs="t:t_si.value,s:ds.status,f:d2.data" outputs="s? t\3Af:o2.v" uid="o2" uid_parent="cst"/>
      <Node _name="Select" inputs="t:t_bi.value,s:ds.status,f:d3.data" outputs="s? t\3Af:o3.v" uid="o3" uid_parent="cst"/>
      <Tunnel _id="Out1" inputs="value:o1.v" uid="t_o1" uid_parent="cst"/>
      <Tunnel _id="Out2" inputs="value:o2.v" uid="t_o2" uid_parent="cst"/>
      <Tunnel _id="Out3" inputs="value:o3.v" uid="t_o3" uid_parent="cst"/>
      <Tunnel _id="Out4" inputs="value:d3.error out" uid="t_o4" uid_parent="cst"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:to.value" uid="to" uid_parent="cs"/>
    <Tunnel _id="Out2" outputs="value:so.value" uid="so" uid_parent="cs"/>
    <Tunnel _id="Out3" outputs="value:bo.value" uid="bo" uid_parent="cs"/>
    <Tunnel _id="Out4" outputs="value:eo.value" uid="eo" uid_parent="cs"/>
  </Structure>
  <Indicator _name="tips out" conIdx="4" connection="recommended" description="The tips message from the other LabVIEW (tips in on an error)." inputs="value:to.value" type="string" uid="o_t" uid_parent="root" value=""/>
  <Indicator _name="splitters out" conIdx="9" connection="recommended" description="The splitters message (splitters in on an error)." inputs="value:so.value" type="string" uid="o_s" uid_parent="root" value=""/>
  <Indicator _name="bars out" conIdx="10" connection="recommended" description="The splitter bars (bars in on an error)." inputs="value:bo.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="o_b" uid_parent="root" value="[]"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in or the first VI Server error." inputs="value:eo.value" type="cluster{bool.status,int32.code,string.source}" uid="o_e" uid_parent="root" value="[false,0,]"/>
</VI>
