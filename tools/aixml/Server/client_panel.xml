<VI _name="RemoteVI Client Panel.vi" description="What servicing a client needs to know about the panel\3A panel = hWnd\2C popup (popups.windows not empty - a popup is open) and the cached geometry\3B popup since out = the tick count at which this client first saw the current popups open - kept while a popup stays open\2C now when one has just opened\2C 0 when none is open.">
  <Control _name="geo" conIdx="0" connection="required" description="Frame origin and client-area origin in screen coordinates (cached)." outputs="value:geo.value" type="cluster{int32.panelX,int32.panelY,int32.clientX,int32.clientY}" uid="geo" uid_parent="root" value="[0,0,0,0]"/>
  <Control _name="hWnd" conIdx="5" connection="required" description="Native handle of the served front panel window (cached)." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="popups" conIdx="7" connection="recommended" description="The popups open now." outputs="value:phw.value" type="cluster{array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}.windows,int32.dx,int32.dy}" uid="phw" uid_parent="root" value="[[],0,0]"/>
  <Control _name="popup since" conIdx="9" connection="recommended" description="The client's popup since (0 = none open)." outputs="value:ps.value" type="uint32" uid="ps" uid_parent="root" value="0"/>
  <Node _name="Unbundle By Name" fields="windows" inputs="input cluster:phw.value" outputs="windows:phu.windows" uid="phu" uid_parent="root"/>
  <Node _name="Empty Array?" inputs="array:phu.windows" outputs="empty?:nopop.empty?" uid="nopop" uid_parent="root"/>
  <Node _name="Not" inputs="x:nopop.empty?" outputs=".not. x?:popin..not. x?" uid="popin" uid_parent="root"/>
  <Constant _name="panel" outputs="value:pan0.value" type="cluster{uint64.hWnd,bool.popup,cluster{int32.panelX,int32.panelY,int32.clientX,int32.clientY}.geo}" uid="pan0" uid_parent="root" value="[0,false,[0,0,0,0]]"/>
  <Node _name="Bundle By Name" fields="geo,hWnd,popup" inputs="geo:geo.value,hWnd:hw.value,popup:popin..not. x?,input cluster:pan0.value" outputs="output cluster:pan.output cluster" uid="pan" uid_parent="root"/>
  <Node _name="Tick Count (ms)" outputs="millisecond timer value:tnow.millisecond timer value" uid="tnow" uid_parent="root"/>
  <Node _name="Equal To 0?" inputs="x:ps.value" outputs="x = 0?:nsince.x = 0?" uid="nsince" uid_parent="root"/>
  <Node _name="Select" inputs="t:tnow.millisecond timer value,s:nsince.x = 0?,f:ps.value" outputs="s? t\3Af:since1.s? t\3Af" uid="since1" uid_parent="root"/>
  <Constant _name="no popup" outputs="value:since0.value" type="uint32" uid="since0" uid_parent="root" value="0"/>
  <Node _name="Select" inputs="t:since1.s? t\3Af,s:popin..not. x?,f:since0.value" outputs="s? t\3Af:since.s? t\3Af" uid="since" uid_parent="root"/>
  <Indicator _name="panel" conIdx="4" connection="recommended" description="hWnd\2C popup and geo." inputs="value:pan.output cluster" type="cluster{uint64.hWnd,bool.popup,cluster{int32.panelX,int32.panelY,int32.clientX,int32.clientY}.geo}" uid="o_pan" uid_parent="root" value="[0,false,[0,0,0,0]]"/>
  <Indicator _name="popup since out" conIdx="6" connection="recommended" description="Updated popup since." inputs="value:since.s? t\3Af" type="uint32" uid="o_ps" uid_parent="root" value="0"/>
</VI>
