<VI _name="RemoteVI Close Clients.vi" description="Ends every connection when the server stops\3A each client gets a WebSocket close frame 1001 (going away\2C 500 ms write timeout) and is closed\3B each pending connection (not answered yet) is closed. Connections are TCP refnums type-cast to U32.">
  <Control _name="clients" conIdx="0" connection="required" description="The connected clients." outputs="value:cl.value" type="array{cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since,string.windows sent,array{cluster{uint64.id,array.2{uint32}.pixels}}.window frames,uint64.key window}}" uid="cl" uid_parent="root" value="[]"/>
  <Control _name="pending" conIdx="5" connection="recommended" description="The pending connections." outputs="value:pn.value" type="array{cluster{uint32.connection,string.head,uint32.accepted}}" uid="pn" uid_parent="root" value="[]"/>
  <Structure _name="For Loop" count="" label="Never runs\3A TCP refnum type only" maxin="tn0.value" maxout="" uid="tpl" uid_parent="root">
    <Constant outputs="value:tp0.value" type="uint16" uid="tp0" uid_parent="tpl" value="0"/>
    <Node _name="TCP Open Connection" inputs="remote port or service name:tp0.value" outputs="connection ID:toc.connection ID" uid="toc" uid_parent="tpl"/>
    <Tunnel _id="Out1" inputs="value:toc.connection ID" outputs="value:tplo.value" uid="tplo" uid_parent="tpl"/>
  </Structure>
  <Constant outputs="value:tn0.value" type="int32" uid="tn0" uid_parent="root" value="0"/>
  <Constant outputs="value:c1001.value" type="uint16" uid="c1001" uid_parent="root" value="1001"/>
  <Constant outputs="value:estr.value" type="string" uid="estr" uid_parent="root" value=""/>
  <Node _name="Type Cast" inputs="x:c1001.value,type:estr.value" outputs="*(type *) &amp;x:byep.*(type *) &amp;x" uid="byep" uid_parent="root"/>
  <Constant outputs="value:op8.value" type="uint8" uid="op8" uid_parent="root" value="8"/>
  <Call inputs="opcode:op8.value,payload:byep.*(type *) &amp;x" outputs="frame:bye.frame" target="RemoteVI WS Encode Server Frame.vi" uid="bye" uid_parent="root"/>
  <Constant outputs="value:byto.value" type="int32" uid="byto" uid_parent="root" value="500"/>
  <Structure _name="For Loop" count="" label="Close every client (1001 going away)" maxin="" maxout="" uid="fc" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cl.value" mode="index" outputs="value:z_cl.value" uid="z_cl" uid_parent="fc"/>
    <Tunnel _id="In2" inputs="value:tplo.value" outputs="value:z_tpl.value" uid="z_tpl" uid_parent="fc"/>
    <Tunnel _id="In3" inputs="value:bye.frame" outputs="value:z_bye.value" uid="z_bye" uid_parent="fc"/>
    <Tunnel _id="In4" inputs="value:byto.value" outputs="value:z_to.value" uid="z_to" uid_parent="fc"/>
    <Node _name="Unbundle By Name" fields="connection" inputs="input cluster:z_cl.value" outputs="connection:zu.connection" uid="zu" uid_parent="fc"/>
    <Node _name="Type Cast" inputs="x:zu.connection,type:z_tpl.value" outputs="*(type *) &amp;x:zc.*(type *) &amp;x" uid="zc" uid_parent="fc"/>
    <Node _name="TCP Write" inputs="connection ID:zc.*(type *) &amp;x,data in:z_bye.value,?parm9:z_to.value" outputs="connection ID out:zw.connection ID out,error out:" uid="zw" uid_parent="fc"/>
    <Node _name="TCP Close Connection" inputs="connection ID:zw.connection ID out" outputs="" uid="zx" uid_parent="fc"/>
  </Structure>
  <Structure _name="For Loop" count="" label="Close every pending connection" maxin="" maxout="" uid="fq" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pn.value" mode="index" outputs="value:q_p.value" uid="q_p" uid_parent="fq"/>
    <Tunnel _id="In2" inputs="value:tplo.value" outputs="value:q_tpl.value" uid="q_tpl" uid_parent="fq"/>
    <Node _name="Unbundle By Name" fields="connection" inputs="input cluster:q_p.value" outputs="connection:qu.connection" uid="qu" uid_parent="fq"/>
    <Node _name="Type Cast" inputs="x:qu.connection,type:q_tpl.value" outputs="*(type *) &amp;x:qc.*(type *) &amp;x" uid="qc" uid_parent="fq"/>
    <Node _name="TCP Close Connection" inputs="connection ID:qc.*(type *) &amp;x" outputs="" uid="qx" uid_parent="fq"/>
  </Structure>
</VI>
