<VI _name="RemoteVI Handle Connection.vi" description="Serves ONE HTTP request whose head has been read completely (docs\5Cprotocol.md section 1). The head is read beforehand without blocking by RemoteVI Read Request Head.vi\2C so this VI never waits for the peer. request head must contain the blank line\3B it is parsed with IG HTTP Utils Parse From String. The status comes from RemoteVI Route Request.vi (with RemoteVI Cross Origin.vi)\3A GET / and /index.html answer 200 with html and the security headers\3B /ws answers 426 without a WebSocket upgrade\2C 403 when an Origin header names another host than Host\2C 503 when max clients reached? is TRUE\2C and otherwise the IG WebSocket upgrade response (101) - then websocket? is TRUE and the connection stays open for the caller. Any other path answers 404. Every non-upgrade answer (RemoteVI Send Static Response.vi) closes the connection\3B a head without the blank line (more than 16 KiB) or one that does not parse is closed without an answer. connection is the TCP connection refnum type-cast to U32 (AIXML has no TCP refnum control type).">
  <FreeLabel comment="One request per connection" uid="lbl" uid_parent="root"/>
  <Control _name="connection" conIdx="0" connection="required" description="The accepted TCP connection refnum\2C type-cast to U32." outputs="value:cin.value" type="uint32" uid="cin" uid_parent="root" value="0"/>
  <Control _name="html" conIdx="5" connection="required" description="The page served for / and /index.html (RemoteVI Index HTML.vi)." outputs="value:html.value" type="string" uid="html" uid_parent="root" value=""/>
  <Control _name="max clients reached?" conIdx="7" connection="recommended" description="TRUE answers a WebSocket upgrade with 503." outputs="value:maxr.value" type="bool" uid="maxr" uid_parent="root" value="false"/>
  <Control _name="request head" conIdx="9" connection="required" description="The request head as read by RemoteVI Read Request Head.vi." outputs="value:head.value" type="string" uid="head" uid_parent="root" value=""/>
  <Control _name="token" conIdx="1" connection="required" description="The share's access token\3A the page and the WebSocket need it as t= in the query (RemoteVI Token Check.vi)\2C else 403." outputs="value:tok.value" type="string" uid="tok" uid_parent="root" value=""/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>

  <Structure _name="For Loop" count="" label="Never runs\3A TCP refnum type only" maxin="tn0.value" maxout="" uid="tpl" uid_parent="root">
    <Constant outputs="value:tp0.value" type="uint16" uid="tp0" uid_parent="tpl" value="0"/>
    <Node _name="TCP Open Connection" inputs="remote port or service name:tp0.value" outputs="connection ID:toc.connection ID" uid="toc" uid_parent="tpl"/>
    <Tunnel _id="Out1" inputs="value:toc.connection ID" outputs="value:tplo.value" uid="tplo" uid_parent="tpl"/>
  </Structure>
  <Constant outputs="value:tn0.value" type="int32" uid="tn0" uid_parent="root" value="0"/>
  <Node _name="Type Cast" inputs="x:cin.value,type:tplo.value" outputs="*(type *) &amp;x:conn.*(type *) &amp;x" uid="conn" uid_parent="root"/>

  <Constant outputs="value:crlf2.value" type="string" uid="crlf2" uid_parent="root" value="\0D\0A\0D\0A"/>
  <Node _name="Search/Split String" inputs="string:head.value,search string/char (-):crlf2.value" outputs="offset of match:ss.offset of match" uid="ss" uid_parent="root"/>
  <Constant outputs="value:zero.value" type="int32" uid="zero" uid_parent="root" value="0"/>
  <Node _name="Greater Or Equal?" inputs="x:ss.offset of match,y:zero.value" outputs="x &gt;= y?:found.x &gt;= y?" uid="found" uid_parent="root"/>
  <Call inputs="Request String:head.value" outputs="error out:pr.error out,Request out:pr.Request out" target="HTTP Utils.lvlib\3ARequest.lvclass\3AParse From String.vi" uid="pr" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="status" inputs="input cluster:pr.error out" outputs="status:prs.status" uid="prs" uid_parent="root"/>
  <Node _name="Not" inputs="x:prs.status" outputs=".not. x?:prok..not. x?" uid="prok" uid_parent="root"/>
  <Node _name="And" inputs="x:found.x &gt;= y?,y:prok..not. x?" outputs="x .and. y?:ok.x .and. y?" uid="ok" uid_parent="root"/>

  <Structure _name="Case Structure" selectin="ok.x .and. y?" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pr.Request out" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:conn.*(type *) &amp;x" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:html.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:maxr.value" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:cin.value" uid="cs_i5" uid_parent="cs"/>
    <Tunnel _id="In6" inputs="value:tok.value" uid="cs_i6" uid_parent="cs"/>
    <CaseFrame label="A request\3A route it" selector="True" selectout="" uid="cft" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:t_req.value" uid="t_req" uid_parent="cft"/>
      <Tunnel _id="In2" outputs="value:t_conn.value" uid="t_conn" uid_parent="cft"/>
      <Tunnel _id="In3" outputs="value:t_html.value" uid="t_html" uid_parent="cft"/>
      <Tunnel _id="In4" outputs="value:t_max.value" uid="t_max" uid_parent="cft"/>
      <Tunnel _id="In5" outputs="value:t_cu.value" uid="t_cu" uid_parent="cft"/>
      <Tunnel _id="In6" outputs="value:t_tok.value" uid="t_tok" uid_parent="cft"/>
      <Call inputs="Request in:t_req.value" outputs="Request out:gu.Request out,Target URI:gu.Target URI" target="HTTP Utils.lvlib\3ARequest.lvclass\3AGet Target URI.vi" uid="gu" uid_parent="cft"/>
      <Call inputs="URI in:gu.Target URI" outputs="Path:gp.Path" target="Stream.lvlib\3AURI.lvclass\3AGet Path.vi" uid="gp" uid_parent="cft"/>
      <Call inputs="URI in:gu.Target URI" outputs="Query:gq.Query" target="Stream.lvlib\3AURI.lvclass\3AGet Query.vi" uid="gq" uid_parent="cft"/>
      <Call inputs="query:gq.Query,token:t_tok.value" outputs="ok?:tc.ok?" target="RemoteVI Token Check.vi" uid="tc" uid_parent="cft"/>
      <Call inputs="Request in:gu.Request out" outputs="Upgrade Request?:up.Upgrade Request?" target="Stream-Websocket.lvlib\3ACheck is Upgrade Request.vi" uid="up" uid_parent="cft"/>
      <Constant outputs="value:hOrigin.value" type="string" uid="hOrigin" uid_parent="cft" value="Origin"/>
      <Constant outputs="value:hHost.value" type="string" uid="hHost" uid_parent="cft" value="Host"/>
      <Call inputs="Request in:gu.Request out,Header:hOrigin.value" outputs="Exists:ho.Exists,Value:ho.Value" target="HTTP Utils.lvlib\3ARequest.lvclass\3AHeader Value.vi" uid="ho" uid_parent="cft"/>
      <Call inputs="Request in:gu.Request out,Header:hHost.value" outputs="Value:hh.Value" target="HTTP Utils.lvlib\3ARequest.lvclass\3AHeader Value.vi" uid="hh" uid_parent="cft"/>
      <Call inputs="origin exists?:ho.Exists,origin:ho.Value,host:hh.Value" outputs="cross origin?:xo.cross origin?" target="RemoteVI Cross Origin.vi" uid="xo" uid_parent="cft"/>
      <Call inputs="path:gp.Path,upgrade request?:up.Upgrade Request?,cross origin?:xo.cross origin?,max clients reached?:t_max.value,token ok?:tc.ok?" outputs="status:rr.status,page?:rr.page?" target="RemoteVI Route Request.vi" uid="rr" uid_parent="cft"/>
      <Constant outputs="value:s101.value" type="uint16" uid="s101" uid_parent="cft" value="101"/>
      <Node _name="Equal?" inputs="x:rr.status,y:s101.value" outputs="x = y?:doup.x = y?" uid="doup" uid_parent="cft"/>

      <Structure _name="Case Structure" selectin="doup.x = y?" uid="cu" uid_parent="cft">
        <Tunnel _id="In1" inputs="value:gu.Request out" uid="cu_i1" uid_parent="cu"/>
        <Tunnel _id="In2" inputs="value:t_conn.value" uid="cu_i2" uid_parent="cu"/>
        <Tunnel _id="In3" inputs="value:rr.status" uid="cu_i3" uid_parent="cu"/>
        <Tunnel _id="In4" inputs="value:rr.page?" uid="cu_i4" uid_parent="cu"/>
        <Tunnel _id="In5" inputs="value:t_html.value" uid="cu_i5" uid_parent="cu"/>
        <Tunnel _id="In6" inputs="value:t_cu.value" uid="cu_i6" uid_parent="cu"/>
        <CaseFrame label="WebSocket upgrade\3A keep it open" selector="True" selectout="" uid="cut" uid_parent="cu">
          <Tunnel _id="In1" outputs="value:u_req.value" uid="u_req" uid_parent="cut"/>
          <Tunnel _id="In2" outputs="value:u_conn.value" uid="u_conn" uid_parent="cut"/>
          <Tunnel _id="In3" outputs="value:" uid="u_st" uid_parent="cut"/>
          <Tunnel _id="In4" outputs="value:" uid="u_pg" uid_parent="cut"/>
          <Tunnel _id="In5" outputs="value:" uid="u_ht" uid_parent="cut"/>
          <Tunnel _id="In6" outputs="value:" uid="u_cu" uid_parent="cut"/>
          <Call inputs="Request:u_req.value" outputs="WebSocket Response:wr.WebSocket Response" target="Stream-Websocket.lvlib\3APrepare WebSocket Upgrade Response.vi" uid="wr" uid_parent="cut"/>
          <Call inputs="Response in:wr.WebSocket Response,TCP Connection:u_conn.value" outputs="error out:ww.error out" target="HTTP Utils.lvlib\3AResponse.lvclass\3AWrite Response to TCP.vi" uid="ww" uid_parent="cut"/>
          <Node _name="Unbundle By Name" fields="status" inputs="input cluster:ww.error out" outputs="status:wws.status" uid="wws" uid_parent="cut"/>
          <Node _name="Not" inputs="x:wws.status" outputs=".not. x?:wok..not. x?" uid="wok" uid_parent="cut"/>
          <Structure _name="Case Structure" selectin="wws.status" uid="cw" uid_parent="cut">
            <Tunnel _id="In1" inputs="value:u_conn.value" uid="cw_i1" uid_parent="cw"/>
            <CaseFrame selector="True" selectout="" uid="cwt" uid_parent="cw">
              <Tunnel _id="In1" outputs="value:cw_c.value" uid="cw_c" uid_parent="cwt"/>
              <Node _name="TCP Close Connection" inputs="connection ID:cw_c.value" outputs="" uid="cwx" uid_parent="cwt"/>
            </CaseFrame>
            <CaseFrame selector="False" selectout="" uid="cwf" uid_parent="cw">
              <Tunnel _id="In1" outputs="value:" uid="cw_c2" uid_parent="cwf"/>
            </CaseFrame>
          </Structure>
          <Tunnel _id="Out1" inputs="value:wok..not. x?" uid="u_o1" uid_parent="cut"/>
          <Tunnel _id="Out2" inputs="value:ww.error out" uid="u_o2" uid_parent="cut"/>
        </CaseFrame>
        <CaseFrame label="Static answer\2C then close" selector="False" selectout="" uid="cuf" uid_parent="cu">
          <Tunnel _id="In1" outputs="value:" uid="f_req" uid_parent="cuf"/>
          <Tunnel _id="In2" outputs="value:" uid="f_conn" uid_parent="cuf"/>
          <Tunnel _id="In3" outputs="value:f_st.value" uid="f_st" uid_parent="cuf"/>
          <Tunnel _id="In4" outputs="value:f_pg.value" uid="f_pg" uid_parent="cuf"/>
          <Tunnel _id="In5" outputs="value:f_ht.value" uid="f_ht" uid_parent="cuf"/>
          <Tunnel _id="In6" outputs="value:f_cu.value" uid="f_cu" uid_parent="cuf"/>
          <Call inputs="connection:f_cu.value,status:f_st.value,page?:f_pg.value,html:f_ht.value" outputs="error out:ssr.error out" target="RemoteVI Send Static Response.vi" uid="ssr" uid_parent="cuf"/>
          <Constant outputs="value:ffalse.value" type="bool" uid="ffalse" uid_parent="cuf" value="false"/>
          <Tunnel _id="Out1" inputs="value:ffalse.value" uid="f_o1" uid_parent="cuf"/>
          <Tunnel _id="Out2" inputs="value:ssr.error out" uid="f_o2" uid_parent="cuf"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:cu_o1.value" uid="cu_o1" uid_parent="cu"/>
        <Tunnel _id="Out2" outputs="value:cu_o2.value" uid="cu_o2" uid_parent="cu"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:cu_o1.value" uid="t_o1" uid_parent="cft"/>
      <Tunnel _id="Out2" inputs="value:cu_o2.value" uid="t_o2" uid_parent="cft"/>
    </CaseFrame>
    <CaseFrame label="Too long or not HTTP\3A close quietly" selector="False" selectout="" uid="cff" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:" uid="x_req" uid_parent="cff"/>
      <Tunnel _id="In2" outputs="value:x_conn.value" uid="x_conn" uid_parent="cff"/>
      <Tunnel _id="In3" outputs="value:" uid="x_html" uid_parent="cff"/>
      <Tunnel _id="In4" outputs="value:" uid="x_max" uid_parent="cff"/>
      <Tunnel _id="In5" outputs="value:" uid="x_cu" uid_parent="cff"/>
      <Tunnel _id="In6" outputs="value:" uid="x_tok" uid_parent="cff"/>
      <Node _name="TCP Close Connection" inputs="connection ID:x_conn.value" outputs="" uid="xx" uid_parent="cff"/>
      <Constant outputs="value:xfalse.value" type="bool" uid="xfalse" uid_parent="cff" value="false"/>
      <Constant outputs="value:xnoerr.value" type="cluster{bool.status,int32.code,string.source}" uid="xnoerr" uid_parent="cff" value="[false,0,]"/>
      <Tunnel _id="Out1" inputs="value:xfalse.value" uid="x_o1" uid_parent="cff"/>
      <Tunnel _id="Out2" inputs="value:xnoerr.value" uid="x_o2" uid_parent="cff"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cs_o1.value" uid="cs_o1" uid_parent="cs"/>
    <Tunnel _id="Out2" outputs="value:cs_o2.value" uid="cs_o2" uid_parent="cs"/>
  </Structure>

  <Node _name="Merge Errors" inputs="error in:ei.value,error in:cs_o2.value" outputs="error out:me.error out" uid="me" uid_parent="root"/>
  <Indicator _name="websocket?" conIdx="4" connection="recommended" description="TRUE when the connection was upgraded to a WebSocket and is still open\3B the caller now owns it." inputs="value:cs_o1.value" type="bool" uid="o_ws" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in merged with the error of writing the answer. A request that does not parse is not an error." inputs="value:me.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
