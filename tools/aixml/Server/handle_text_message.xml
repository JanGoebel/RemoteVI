<VI _name="RemoteVI Handle Text Message.vi" description="Handles one text message of a client (docs\5Cprotocol.md section 5) after RemoteVI Parse Input.vi\3A an ack raises acked to max(acked\2C seq of the ack) when that seq is not ahead of the client's seq\3B a mouse or key message goes to the window RemoteVI Route Input.vi picks (the front-most listed window under the pointer\2C for keys the front-most modal window\2C else the window last clicked\2C else the panel\3B docs\5Cprotocol.md section 7) and is posted to LabVIEW (RemoteVI Post Client Input.vi)\3B x id presses the close box of a listed closable window - WM_SYSCOMMAND SC_CLOSE (RemoteVI Close Window.vi)\3B anything else (invalid) is ignored. No VI Server call.">
  <Control _name="text" conIdx="0" connection="required" description="The message payload." outputs="value:pl.value" type="string" uid="pl" uid_parent="root" value=""/>
  <Control _name="acked" conIdx="1" connection="required" description="Highest frame seq the client acknowledged." outputs="value:ack.value" type="uint32" uid="ack" uid_parent="root" value="0"/>
  <Control _name="tracking" conIdx="2" connection="recommended" description="Mouse tracking state (RemoteVI Translate Input.vi)." outputs="value:trk.value" type="bool" uid="trk" uid_parent="root" value="false"/>
  <Control _name="seq" conIdx="3" connection="required" description="seq of the last frame sent to the client." outputs="value:seq.value" type="uint32" uid="seq" uid_parent="root" value="0"/>
  <Control _name="panel" conIdx="4" connection="required" description="hWnd of the served panel\2C popup (a popup is open) and the cached panel geometry." outputs="value:pan.value" type="cluster{uint64.hWnd,bool.popup,cluster{int32.panelX,int32.panelY,int32.clientX,int32.clientY}.geo}" uid="pan" uid_parent="root" value="[0,false,[0,0,0,0]]"/>
  <Control _name="error in" conIdx="5" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Control _name="popups" conIdx="6" connection="recommended" description="The popups open now at their logical positions\2C with d." outputs="value:pp.value" type="cluster{array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}.windows,int32.dx,int32.dy}" uid="pp" uid_parent="root" value="[[],0,0]"/>
  <Control _name="mods" conIdx="8" connection="recommended" description="Modifier keys the remote user holds." outputs="value:mods.value" type="uint8" uid="mods" uid_parent="root" value="0"/>
  <Control _name="mods set" conIdx="10" connection="recommended" description="Modifier keys last written into LabVIEW's key state for this client." outputs="value:mset.value" type="uint8" uid="mset" uid_parent="root" value="0"/>
  <Control _name="windows" conIdx="7" connection="recommended" description="The application's other windows\2C front-most first (RemoteVI Track Windows.vi)." outputs="value:wl.value" type="array{cluster{uint64.id,string.title,int32.x,int32.y,int32.w,int32.h,bool.modal,bool.active,bool.closable,int32.sx,int32.sy,string.class}}" uid="wl" uid_parent="root" value="[]"/>
  <Control _name="key window" conIdx="9" connection="recommended" description="The window this client last pressed a button in\2C 0 = the panel." outputs="value:kw.value" type="uint64" uid="kw" uid_parent="root" value="0"/>
  <Control _name="popup since" conIdx="12" connection="recommended" description="Tick count (ms) at which the current popups were first seen open." outputs="value:since.value" type="uint32" uid="since" uid_parent="root" value="0"/>

  <Call inputs="text:pl.value" outputs="kind:pi.kind,msg:pi.msg,x:pi.x,y:pi.y,wParam:pi.wParam,lParam:pi.lParam,seq:pi.seq,id:pi.id" target="RemoteVI Parse Input.vi" uid="pi" uid_parent="root"/>
  <Call inputs="kind:pi.kind,id:pi.id,windows:wl.value" outputs="closed?:,error out:" target="RemoteVI Close Window.vi" uid="xw" uid_parent="root"/>
  <Node _name="To Long Integer" inputs="number:pi.kind" outputs="32bit integer:kn.32bit integer" uid="kn" uid_parent="root"/>
  <Constant _name="ack" outputs="value:k3.value" type="int32" uid="k3" uid_parent="root" value="3"/>
  <Constant _name="mouse" outputs="value:k1c.value" type="int32" uid="k1c" uid_parent="root" value="1"/>
  <Constant _name="key" outputs="value:k2c.value" type="int32" uid="k2c" uid_parent="root" value="2"/>
  <Node _name="Equal?" inputs="x:kn.32bit integer,y:k3.value" outputs="x = y?:isAck.x = y?" uid="isAck" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:kn.32bit integer,y:k1c.value" outputs="x = y?:isM.x = y?" uid="isM" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:kn.32bit integer,y:k2c.value" outputs="x = y?:isK.x = y?" uid="isK" uid_parent="root"/>
  <Node _name="Or" inputs="x:isM.x = y?,y:isK.x = y?" outputs="x .or. y?:isIn.x .or. y?" uid="isIn" uid_parent="root"/>
  <Node _name="Less Or Equal?" inputs="x:pi.seq,y:seq.value" outputs="x &lt;= y?:sok.x &lt;= y?" uid="sok" uid_parent="root"/>
  <Node _name="Max &amp; Min" inputs="x:ack.value,y:pi.seq" outputs="max(x\2Cy):mx.max(x\2Cy)" uid="mx" uid_parent="root"/>
  <Node _name="And" inputs="x:isAck.x = y?,y:sok.x &lt;= y?" outputs="x .and. y?:takeAck.x .and. y?" uid="takeAck" uid_parent="root"/>
  <Node _name="Select" inputs="t:mx.max(x\2Cy),s:takeAck.x .and. y?,f:ack.value" outputs="s? t\3Af:nack.s? t\3Af" uid="nack" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="isIn.x .or. y?" uid="cp" uid_parent="root">
    <Tunnel _id="In1" inputs="value:pan.value" uid="cp_i1" uid_parent="cp"/>
    <Tunnel _id="In2" inputs="value:ei.value" uid="cp_i2" uid_parent="cp"/>
    <Tunnel _id="In3" inputs="value:trk.value" uid="cp_i3" uid_parent="cp"/>
    <Tunnel _id="In4" inputs="value:pi.kind" uid="cp_i4" uid_parent="cp"/>
    <Tunnel _id="In5" inputs="value:pi.msg" uid="cp_i5" uid_parent="cp"/>
    <Tunnel _id="In6" inputs="value:pi.x" uid="cp_i6" uid_parent="cp"/>
    <Tunnel _id="In7" inputs="value:pi.y" uid="cp_i7" uid_parent="cp"/>
    <Tunnel _id="In8" inputs="value:pi.wParam" uid="cp_i8" uid_parent="cp"/>
    <Tunnel _id="In9" inputs="value:pi.lParam" uid="cp_i9" uid_parent="cp"/>
    <Tunnel _id="In10" inputs="value:pp.value" uid="cp_i10" uid_parent="cp"/>
    <Tunnel _id="In11" inputs="value:mods.value" uid="cp_i11" uid_parent="cp"/>
    <Tunnel _id="In12" inputs="value:mset.value" uid="cp_i12" uid_parent="cp"/>
    <Tunnel _id="In13" inputs="value:since.value" uid="cp_i13" uid_parent="cp"/>
    <Tunnel _id="In14" inputs="value:wl.value" uid="cp_i14" uid_parent="cp"/>
    <Tunnel _id="In15" inputs="value:kw.value" uid="cp_i15" uid_parent="cp"/>
    <CaseFrame label="Mouse or key\3A post it" selector="True" selectout="" uid="cpt" uid_parent="cp">
      <Tunnel _id="In1" outputs="value:p_vi.value" uid="p_vi" uid_parent="cpt"/>
      <Tunnel _id="In2" outputs="value:p_err.value" uid="p_err" uid_parent="cpt"/>
      <Tunnel _id="In3" outputs="value:" uid="p_trk" uid_parent="cpt"/>
      <Tunnel _id="In4" outputs="value:p_kind.value" uid="p_kind" uid_parent="cpt"/>
      <Tunnel _id="In5" outputs="value:p_msg.value" uid="p_msg" uid_parent="cpt"/>
      <Tunnel _id="In6" outputs="value:p_x.value" uid="p_x" uid_parent="cpt"/>
      <Tunnel _id="In7" outputs="value:p_y.value" uid="p_y" uid_parent="cpt"/>
      <Tunnel _id="In8" outputs="value:p_wp.value" uid="p_wp" uid_parent="cpt"/>
      <Tunnel _id="In9" outputs="value:p_lp.value" uid="p_lp" uid_parent="cpt"/>
      <Tunnel _id="In10" outputs="value:p_pp.value" uid="p_pp" uid_parent="cpt"/>
      <Tunnel _id="In11" outputs="value:p_mods.value" uid="p_mods" uid_parent="cpt"/>
      <Tunnel _id="In12" outputs="value:p_mset.value" uid="p_mset" uid_parent="cpt"/>
      <Tunnel _id="In13" outputs="value:p_since.value" uid="p_since" uid_parent="cpt"/>
      <Tunnel _id="In14" outputs="value:p_wl.value" uid="p_wl" uid_parent="cpt"/>
      <Tunnel _id="In15" outputs="value:p_kw.value" uid="p_kw" uid_parent="cpt"/>
      <Call inputs="kind:p_kind.value,msg:p_msg.value,x:p_x.value,y:p_y.value,panel:p_vi.value,windows:p_wl.value,key window:p_kw.value" outputs="panel out:ri.panel out,msg out:ri.msg out,key window out:ri.key window out,error out:" target="RemoteVI Route Input.vi" uid="ri" uid_parent="cpt"/>
      <Call inputs="panel:ri.panel out,kind:p_kind.value,msg:ri.msg out,x:p_x.value,y:p_y.value,error in:p_err.value,wParam:p_wp.value,lParam:p_lp.value,popups:p_pp.value,mods:p_mods.value,mods set:p_mset.value,popup since:p_since.value" outputs="tracking out:pci.tracking out,clicked?:pci.clicked?,popups out:pci.popups out,mods out:pci.mods out,mods set out:pci.mods set out,error out:pci.error out" target="RemoteVI Post Client Input.vi" uid="pci" uid_parent="cpt"/>
      <Tunnel _id="Out1" inputs="value:pci.tracking out" uid="p_o1" uid_parent="cpt"/>
      <Tunnel _id="Out2" inputs="value:pci.error out" uid="p_o2" uid_parent="cpt"/>
      <Tunnel _id="Out3" inputs="value:pci.clicked?" uid="p_o3" uid_parent="cpt"/>
      <Tunnel _id="Out4" inputs="value:pci.popups out" uid="p_o4" uid_parent="cpt"/>
      <Tunnel _id="Out5" inputs="value:pci.mods out" uid="p_o5" uid_parent="cpt"/>
      <Tunnel _id="Out6" inputs="value:pci.mods set out" uid="p_o6" uid_parent="cpt"/>
      <Tunnel _id="Out7" inputs="value:ri.key window out" uid="p_o7" uid_parent="cpt"/>
    </CaseFrame>
    <CaseFrame selector="False" selectout="" uid="cpf" uid_parent="cp">
      <Tunnel _id="In1" outputs="value:" uid="q_vi" uid_parent="cpf"/>
      <Tunnel _id="In2" outputs="value:q_err.value" uid="q_err" uid_parent="cpf"/>
      <Tunnel _id="In3" outputs="value:q_trk.value" uid="q_trk" uid_parent="cpf"/>
      <Tunnel _id="In4" outputs="value:" uid="q_i4" uid_parent="cpf"/>
      <Tunnel _id="In5" outputs="value:" uid="q_i5" uid_parent="cpf"/>
      <Tunnel _id="In6" outputs="value:" uid="q_i6" uid_parent="cpf"/>
      <Tunnel _id="In7" outputs="value:" uid="q_i7" uid_parent="cpf"/>
      <Tunnel _id="In8" outputs="value:" uid="q_i8" uid_parent="cpf"/>
      <Tunnel _id="In9" outputs="value:" uid="q_i9" uid_parent="cpf"/>
      <Tunnel _id="In10" outputs="value:q_pp.value" uid="q_pp" uid_parent="cpf"/>
      <Tunnel _id="In11" outputs="value:q_mods.value" uid="q_mods" uid_parent="cpf"/>
      <Tunnel _id="In12" outputs="value:q_mset.value" uid="q_mset" uid_parent="cpf"/>
      <Tunnel _id="In13" outputs="value:" uid="q_since" uid_parent="cpf"/>
      <Tunnel _id="In14" outputs="value:" uid="q_wl" uid_parent="cpf"/>
      <Tunnel _id="In15" outputs="value:q_kw.value" uid="q_kw" uid_parent="cpf"/>
      <Tunnel _id="Out1" inputs="value:q_trk.value" uid="q_o1" uid_parent="cpf"/>
      <Tunnel _id="Out2" inputs="value:q_err.value" uid="q_o2" uid_parent="cpf"/>
      <Constant outputs="value:qf.value" type="bool" uid="qf" uid_parent="cpf" value="false"/>
      <Tunnel _id="Out3" inputs="value:qf.value" uid="q_o3" uid_parent="cpf"/>
      <Tunnel _id="Out4" inputs="value:q_pp.value" uid="q_o4" uid_parent="cpf"/>
      <Tunnel _id="Out5" inputs="value:q_mods.value" uid="q_o5" uid_parent="cpf"/>
      <Tunnel _id="Out6" inputs="value:q_mset.value" uid="q_o6" uid_parent="cpf"/>
      <Tunnel _id="Out7" inputs="value:q_kw.value" uid="q_o7" uid_parent="cpf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cp_o1.value" uid="cp_o1" uid_parent="cp"/>
    <Tunnel _id="Out2" outputs="value:cp_o2.value" uid="cp_o2" uid_parent="cp"/>
    <Tunnel _id="Out3" outputs="value:cp_o3.value" uid="cp_o3" uid_parent="cp"/>
    <Tunnel _id="Out4" outputs="value:cp_o4.value" uid="cp_o4" uid_parent="cp"/>
    <Tunnel _id="Out5" outputs="value:cp_o5.value" uid="cp_o5" uid_parent="cp"/>
    <Tunnel _id="Out6" outputs="value:cp_o6.value" uid="cp_o6" uid_parent="cp"/>
    <Tunnel _id="Out7" outputs="value:cp_o7.value" uid="cp_o7" uid_parent="cp"/>
  </Structure>
  <Indicator _name="acked out" conIdx="14" connection="recommended" description="acked after an ack." inputs="value:nack.s? t\3Af" type="uint32" uid="o_ack" uid_parent="root" value="0"/>
  <Indicator _name="tracking out" conIdx="15" connection="recommended" description="tracking after a posted message." inputs="value:cp_o1.value" type="bool" uid="o_trk" uid_parent="root" value="false"/>
  <Indicator _name="clicked?" conIdx="16" connection="recommended" description="TRUE when a message that may open a popup was posted." inputs="value:cp_o3.value" type="bool" uid="o_clk" uid_parent="root" value="false"/>
  <Indicator _name="popups out" conIdx="17" connection="recommended" description="popups with the displacement d used for a popup click." inputs="value:cp_o4.value" type="cluster{array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h}}.windows,int32.dx,int32.dy}" uid="o_pp" uid_parent="root" value="[[],0,0]"/>
  <Indicator _name="mods out" conIdx="18" connection="recommended" description="mods after this message." inputs="value:cp_o5.value" type="uint8" uid="o_m" uid_parent="root" value="0"/>
  <Indicator _name="mods set out" conIdx="11" connection="recommended" description="mods set after this message." inputs="value:cp_o6.value" type="uint8" uid="o_ms" uid_parent="root" value="0"/>
  <Indicator _name="key window out" conIdx="13" connection="recommended" description="key window after this message (RemoteVI Route Input.vi)." inputs="value:cp_o7.value" type="uint64" uid="o_kw" uid_parent="root" value="0"/>
  <Indicator _name="error out" conIdx="19" connection="recommended" description="error in and errors of posting." inputs="value:cp_o2.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
