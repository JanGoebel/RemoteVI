<VI _name="RemoteVI Hide Remote Popups.vi" description="Hides the popups a REMOTE user opened (docs\5Carchitecture.md\2C Popups)\3A a popup in all popups that was not in previous popup hWnds is new\3B a new popup is hidden (RemoteVI Hide Window.vi\2C layered with alpha 0 - it stays open and clickable) when remote click? is TRUE (a client posted a button or key message within the last second)\2C when a popup hidden before is still open (a submenu the remote hover opened with VK_RIGHT belongs to the remote user's menu\2C even long after the last click)\2C and a new tip strip (class LVTipStrip) also when the host cursor is outside the panel window (RemoteVI Cursor Outside Window.vi) - it can only stem from the remote pointer. A popup in previously hidden is hidden again on every call while it is open\2C because a menu's fade-in animation sets its alpha back to 255 (measured). A popup opened at the host stays visible. Win32 only.">
  <Control _name="panel hWnd" conIdx="0" connection="required" description="Native handle of the served front panel window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="all popups" conIdx="5" connection="required" description="Every popup open now (RemoteVI List Popups.vi)." outputs="value:ap.value" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h,string.class}}" uid="ap" uid_parent="root" value="[]"/>
  <Control _name="previous popup hWnds" conIdx="7" connection="recommended" description="popup hWnds of the previous call." outputs="value:prev.value" type="array{uint64}" uid="prev" uid_parent="root" value="[]"/>
  <Control _name="previously hidden" conIdx="9" connection="recommended" description="hidden hWnds of the previous call." outputs="value:phid.value" type="array{uint64}" uid="phid" uid_parent="root" value="[]"/>
  <Control _name="remote click?" conIdx="1" connection="recommended" description="TRUE within 1 s after a client posted a button or key message." outputs="value:rc.value" type="bool" uid="rc" uid_parent="root" value="false"/>
  <Call inputs="hWnd:hw.value" outputs="outside?:co.outside?" target="RemoteVI Cursor Outside Window.vi" uid="co" uid_parent="root"/>
  <Constant _name="tip strip" outputs="value:tipk.value" type="string" uid="tipk" uid_parent="root" value="LVTipStrip"/>
  <Structure _name="For Loop" count="" label="Is a hidden popup still open?" maxin="" maxout="" uid="fo" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ap.value" mode="index" outputs="value:o_p.value" uid="o_p" uid_parent="fo"/>
    <Tunnel _id="In2" inputs="value:phid.value" outputs="value:o_hid.value" uid="o_hid" uid_parent="fo"/>
    <Node _name="Unbundle By Name" fields="hwnd" inputs="input cluster:o_p.value" outputs="hwnd:ou.hwnd" uid="ou" uid_parent="fo"/>
    <Node _name="Search 1D Array" inputs="1D array:o_hid.value,element:ou.hwnd" outputs="index of element:os.index of element" uid="os" uid_parent="fo"/>
    <Node _name="Greater Or Equal To 0?" inputs="x:os.index of element" outputs="x &gt;= 0?:oh.x &gt;= 0?" uid="oh" uid_parent="fo"/>
    <Tunnel _id="Out1" inputs="value:oh.x &gt;= 0?" mode="index" outputs="value:ohs.value" uid="ohs" uid_parent="fo"/>
  </Structure>
  <Node _name="Or Array Elements" inputs="Boolean array:ohs.value" outputs="logical OR:hopen.logical OR" uid="hopen" uid_parent="root"/>
  <Node _name="Or" inputs="x:rc.value,y:hopen.logical OR" outputs="x .or. y?:remote.x .or. y?" uid="remote" uid_parent="root"/>
  <Structure _name="For Loop" count="" label="Hide popups a remote click opened" maxin="" maxout="" uid="fh" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ap.value" mode="index" outputs="value:h_p.value" uid="h_p" uid_parent="fh"/>
    <Tunnel _id="In2" inputs="value:prev.value" outputs="value:h_prev.value" uid="h_prev" uid_parent="fh"/>
    <Tunnel _id="In3" inputs="value:remote.x .or. y?" outputs="value:h_rc.value" uid="h_rc" uid_parent="fh"/>
    <Tunnel _id="In4" inputs="value:phid.value" outputs="value:h_hid.value" uid="h_hid" uid_parent="fh"/>
    <Tunnel _id="In5" inputs="value:co.outside?" outputs="value:h_off.value" uid="h_off" uid_parent="fh"/>
    <Tunnel _id="In6" inputs="value:tipk.value" outputs="value:h_tip.value" uid="h_tip" uid_parent="fh"/>
    <Node _name="Unbundle By Name" fields="hwnd,class" inputs="input cluster:h_p.value" outputs="hwnd:hu.hwnd,class:hu.class" uid="hu" uid_parent="fh"/>
    <Node _name="Equal?" inputs="x:hu.class,y:h_tip.value" outputs="x = y?:htip.x = y?" uid="htip" uid_parent="fh"/>
    <Node _name="And" inputs="x:htip.x = y?,y:h_off.value" outputs="x .and. y?:htr.x .and. y?" uid="htr" uid_parent="fh"/>
    <Node _name="Or" inputs="x:htr.x .and. y?,y:h_rc.value" outputs="x .or. y?:hrem.x .or. y?" uid="hrem" uid_parent="fh"/>
    <Node _name="Search 1D Array" inputs="1D array:h_prev.value,element:hu.hwnd" outputs="index of element:hs.index of element" uid="hs" uid_parent="fh"/>
    <Node _name="Less Than 0?" inputs="x:hs.index of element" outputs="x &lt; 0?:hn.x &lt; 0?" uid="hn" uid_parent="fh"/>
    <Node _name="And" inputs="x:hn.x &lt; 0?,y:hrem.x .or. y?" outputs="x .and. y?:hnew.x .and. y?" uid="hnew" uid_parent="fh"/>
    <Node _name="Search 1D Array" inputs="1D array:h_hid.value,element:hu.hwnd" outputs="index of element:hh.index of element" uid="hh" uid_parent="fh"/>
    <Node _name="Greater Or Equal To 0?" inputs="x:hh.index of element" outputs="x &gt;= 0?:hwas.x &gt;= 0?" uid="hwas" uid_parent="fh"/>
    <Node _name="Or" inputs="x:hnew.x .and. y?,y:hwas.x &gt;= 0?" outputs="x .or. y?:hdo.x .or. y?" uid="hdo" uid_parent="fh"/>
    <Structure _name="Case Structure" selectin="hdo.x .or. y?" uid="hcs" uid_parent="fh">
      <Tunnel _id="In1" inputs="value:hu.hwnd" uid="hc_i1" uid_parent="hcs"/>
      <CaseFrame label="Opened remotely\3A keep it hidden" selector="True" selectout="" uid="hct" uid_parent="hcs">
        <Tunnel _id="In1" outputs="value:hc_w.value" uid="hc_w" uid_parent="hct"/>
        <Call inputs="hwnd:hc_w.value" outputs="hidden?:,error out:" target="RemoteVI Hide Window.vi" uid="hide" uid_parent="hct"/>
      </CaseFrame>
      <CaseFrame selector="False" selectout="" uid="hcf" uid_parent="hcs">
        <Tunnel _id="In1" outputs="value:" uid="hc_x" uid_parent="hcf"/>
      </CaseFrame>
    </Structure>
    <Tunnel _id="Out1" inputs="value:hu.hwnd" mode="index" outputs="value:allhw.value" uid="allhw" uid_parent="fh"/>
    <Tunnel _id="Out2" inputs="value:hu.hwnd" mode="index" cond="hdo.x .or. y?" outputs="value:hidhw.value" uid="hidhw" uid_parent="fh"/>
  </Structure>
  <Indicator _name="popup hWnds" conIdx="4" connection="recommended" description="The window handles of all popups\2C for the next call." inputs="value:allhw.value" type="array{uint64}" uid="o_all" uid_parent="root" value="[]"/>
  <Indicator _name="hidden hWnds" conIdx="6" connection="recommended" description="The popups hidden in this call\2C for the next call." inputs="value:hidhw.value" type="array{uint64}" uid="o_hid" uid_parent="root" value="[]"/>
</VI>
