  <Constant outputs="value:page.value" type="string" uid="page" uid_parent="root" value="&lt;!doctype html&gt;\0A&lt;html lang=&quot;en&quot;&gt;\0A&lt;head&gt;\0A&lt;meta charset=&quot;utf-8&quot;&gt;\0A&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width\2C initial-scale=1&quot;&gt;\0A&lt;title&gt;RemoteVI&lt;/title&gt;\0A&lt;!--\0A  RemoteVI browser client\2C protocol v2 (docs/protocol.md).\0A  Self-contained on purpose: the LabVIEW toolkit embeds this one file as a string\0A  constant and serves it for GET /\2C so a built EXE needs no support files.\0A  Keep it pure ASCII (use \5Cu escapes and HTML entities) so the G string constant\0A  holds exactly these bytes.\0A--&gt;\0A&lt;style&gt;\0A:root {\0A  --bg: #e9ebee; --bar-bg: #fff; --bar-fg: #1d2330; --muted: #667085;\0A  --accent: #1f6feb; --ok: #1a7f37; --warn: #bf8700; --err: #cf222e; --border: #d0d7de;\0A  color-scheme: light dark;\0A}\0A@media (prefers-color-scheme: dark) {\0A  :root { --bg: #15181e; --bar-bg: #1e232b; --bar-fg: #e6edf3; --muted: #8d96a0; --border: #30363d; }\0A}\0A* { box-sizing: border-box; }\0Ahtml\2C body { height: 100%; margin: 0; }\0Abody {\0A  display: flex; flex-direction: column; background: var(--bg); color: var(--bar-fg);\0A  font: 13px/1.4 system-ui\2C -apple-system\2C &quot;Segoe UI&quot;\2C sans-serif;\0A}\0A.bar {\0A  display: flex; align-items: center; gap: 10px; padding: 6px 12px;\0A  background: var(--bar-bg); border-bottom: 1px solid var(--border);\0A}\0A.bar .spacer { flex: 1; }\0A.stats { color: var(--muted); font-variant-numeric: tabular-nums; }\0A.bar button {\0A  font: inherit; padding: 3px 10px; border: 1px solid var(--border); border-radius: 6px;\0A  background: transparent; color: inherit; cursor: pointer;\0A}\0A.bar button[aria-pressed=&quot;true&quot;] { border-color: var(--accent); color: var(--accent); }\0A.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--warn); }\0Abody[data-state=&quot;online&quot;] .dot { background: var(--ok); }\0Abody[data-state=&quot;offline&quot;] .dot { background: var(--err); }\0A.stage { flex: 1; overflow: auto; padding: 16px; }\0A.panel-wrap { width: max-content; margin: 0 auto; box-shadow: 0 1px 6px rgb(0 0 0 / 0.25); }\0A#panel { display: block; outline: none; image-rendering: pixelated; cursor: default; touch-action: none; }\0Abody[data-view-only=&quot;true&quot;] #panel { cursor: not-allowed; }\0A.stage.fit { display: flex; align-items: center; justify-content: center; overflow: hidden; }\0A.stage.fit #panel {\0A  max-width: calc(100vw - 32px); max-height: calc(100vh - 80px);\0A  width: auto; height: auto; image-rendering: auto;\0A}\0A&lt;/style&gt;\0A&lt;/head&gt;\0A&lt;body data-state=&quot;connecting&quot;&gt;\0A&lt;header class=&quot;bar&quot;&gt;\0A  &lt;span class=&quot;dot&quot; aria-hidden=&quot;true&quot;&gt;&lt;/span&gt;\0A  &lt;strong id=&quot;vi-name&quot;&gt;RemoteVI&lt;/strong&gt;\0A  &lt;span id=&quot;status&quot; role=&quot;status&quot;&gt;Connecting&amp;hellip;&lt;/span&gt;\0A  &lt;span class=&quot;spacer&quot;&gt;&lt;/span&gt;\0A  &lt;span id=&quot;stats&quot; class=&quot;stats&quot;&gt;&lt;/span&gt;\0A  &lt;button id=&quot;fit-btn&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; title=&quot;Scale the panel to the window&quot;&gt;Fit&lt;/button&gt;\0A&lt;/header&gt;\0A&lt;main id=&quot;stage&quot; class=&quot;stage&quot;&gt;\0A  &lt;div class=&quot;panel-wrap&quot;&gt;\0A    &lt;canvas id=&quot;panel&quot; tabindex=&quot;0&quot; width=&quot;1&quot; height=&quot;1&quot; aria-label=&quot;Remote front panel&quot;&gt;&lt;/canvas&gt;\0A  &lt;/div&gt;\0A&lt;/main&gt;\0A&lt;script&gt;\0A&apos;use strict&apos;;\0A\0A// --- protocol v2 constants (docs/protocol.md) --------------------------------\0A\0Aconst FRAME_MAGIC = 0x52;          // &apos;R&apos;\0Aconst MSG_FRAME = 1;\0Aconst FRAME_HEADER = 12;           // magic\2C type\2C seq u32\2C width u16\2C height u16\2C count u16\0Aconst RECT_HEADER = 8;             // x i16\2C y i16\2C length u32\0A\0A// Win32 message numbers. The server posts them to the panel window\2C so these\0A// values ARE the protocol.\0Aconst WM = {\0A  KEYDOWN: 0x0100\2C KEYUP: 0x0101\2C CHAR: 0x0102\2C\0A  MOUSEMOVE: 0x0200\2C\0A  LBUTTONDOWN: 0x0201\2C LBUTTONUP: 0x0202\2C LBUTTONDBLCLK: 0x0203\2C\0A  RBUTTONDOWN: 0x0204\2C RBUTTONUP: 0x0205\2C RBUTTONDBLCLK: 0x0206\2C\0A  MBUTTONDOWN: 0x0207\2C MBUTTONUP: 0x0208\2C MBUTTONDBLCLK: 0x0209\2C\0A  MOUSEWHEEL: 0x020A\2C\0A};\0Aconst MK = { LBUTTON: 0x01\2C RBUTTON: 0x02\2C SHIFT: 0x04\2C CONTROL: 0x08\2C MBUTTON: 0x10 };\0Aconst WHEEL_DELTA = 120;\0A\0A// Browser button index (0 left\2C 1 middle\2C 2 right) -&gt; [down\2C up\2C dblclk].\0Aconst BUTTON_MSGS = {\0A  0: [WM.LBUTTONDOWN\2C WM.LBUTTONUP\2C WM.LBUTTONDBLCLK]\2C\0A  1: [WM.MBUTTONDOWN\2C WM.MBUTTONUP\2C WM.MBUTTONDBLCLK]\2C\0A  2: [WM.RBUTTONDOWN\2C WM.RBUTTONUP\2C WM.RBUTTONDBLCLK]\2C\0A};\0A\0A// KeyboardEvent.code -&gt; [virtual-key code\2C extended-key flag]. Printable\0A// characters are not listed: they travel as WM_CHAR so the remote side does not\0A// depend on the host&apos;s keyboard layout.\0Aconst VK = {\0A  Backspace: [0x08\2C 0]\2C Tab: [0x09\2C 0]\2C Enter: [0x0D\2C 0]\2C NumpadEnter: [0x0D\2C 1]\2C\0A  ShiftLeft: [0x10\2C 0]\2C ShiftRight: [0x10\2C 0]\2C ControlLeft: [0x11\2C 0]\2C ControlRight: [0x11\2C 1]\2C\0A  Escape: [0x1B\2C 0]\2C PageUp: [0x21\2C 1]\2C PageDown: [0x22\2C 1]\2C End: [0x23\2C 1]\2C Home: [0x24\2C 1]\2C\0A  ArrowLeft: [0x25\2C 1]\2C ArrowUp: [0x26\2C 1]\2C ArrowRight: [0x27\2C 1]\2C ArrowDown: [0x28\2C 1]\2C\0A  Insert: [0x2D\2C 1]\2C Delete: [0x2E\2C 1]\2C\0A  F1: [0x70\2C 0]\2C F2: [0x71\2C 0]\2C F3: [0x72\2C 0]\2C F4: [0x73\2C 0]\2C F5: [0x74\2C 0]\2C F6: [0x75\2C 0]\2C\0A  F7: [0x76\2C 0]\2C F8: [0x77\2C 0]\2C F9: [0x78\2C 0]\2C F10: [0x79\2C 0]\2C F11: [0x7A\2C 0]\2C F12: [0x7B\2C 0]\2C\0A};\0A\0Afunction mouseFlags(e) {\0A  let w = 0;\0A  if (e.buttons &amp; 1) w |= MK.LBUTTON;\0A  if (e.buttons &amp; 2) w |= MK.RBUTTON;\0A  if (e.buttons &amp; 4) w |= MK.MBUTTON;\0A  if (e.shiftKey) w |= MK.SHIFT;\0A  if (e.ctrlKey) w |= MK.CONTROL;\0A  return w;\0A}\0A\0A// lParam for WM_KEYDOWN / WM_KEYUP: repeat count 1\2C extended bit 24\2C and for\0A// key-up the previous-state and transition bits. Sent as an unsigned decimal.\0Afunction keyLParam(extended\2C up) {\0A  let l = 1;\0A  if (extended) l += 0x01000000;\0A  if (up) l += 0xC0000000;\0A  return l;\0A}\0A\0Afunction decodeFrame(buf) {\0A  const v = new DataView(buf);\0A  if (buf.byteLength &lt; FRAME_HEADER || v.getUint8(0) !== FRAME_MAGIC || v.getUint8(1) !== MSG_FRAME) {\0A    throw new Error(&apos;not a RemoteVI frame&apos;);\0A  }\0A  const frame = { seq: v.getUint32(2)\2C width: v.getUint16(6)\2C height: v.getUint16(8)\2C rects: [] };\0A  const count = v.getUint16(10);\0A  let o = FRAME_HEADER;\0A  for (let i = 0; i &lt; count; i++) {\0A    if (o + RECT_HEADER &gt; buf.byteLength) throw new Error(&apos;truncated frame&apos;);\0A    const x = v.getInt16(o)\2C y = v.getInt16(o + 2)\2C len = v.getUint32(o + 4);\0A    o += RECT_HEADER;\0A    if (o + len &gt; buf.byteLength) throw new Error(&apos;truncated frame&apos;);\0A    frame.rects.push({ x\2C y\2C png: new Blob([new Uint8Array(buf\2C o\2C len)]\2C { type: &apos;image/png&apos; }) });\0A    o += len;\0A  }\0A  return frame;\0A}\0A\0A// --- client -------------------------------------------------------------------\0A\0Aclass RemoteViClient {\0A  constructor() {\0A    this.canvas = document.getElementById(&apos;panel&apos;);\0A    this.ctx = this.canvas.getContext(&apos;2d&apos;\2C { alpha: false });\0A    this.stage = document.getElementById(&apos;stage&apos;);\0A    this.statusEl = document.getElementById(&apos;status&apos;);\0A    this.statsEl = document.getElementById(&apos;stats&apos;);\0A    this.ws = null;\0A    this.backoff = 250;\0A    this.queue = Promise.resolve();   // frames are painted strictly in order\0A    this.pendingMove = null;\0A    this.stats = { frames: 0\2C bytes: 0\2C since: performance.now() };\0A\0A    document.getElementById(&apos;fit-btn&apos;).addEventListener(&apos;click&apos;\2C (e) =&gt; {\0A      const fit = this.stage.classList.toggle(&apos;fit&apos;);\0A      e.currentTarget.setAttribute(&apos;aria-pressed&apos;\2C String(fit));\0A    });\0A    this.bindInput();\0A    setInterval(() =&gt; this.showStats()\2C 1000);\0A    this.connect();\0A  }\0A\0A  connect() {\0A    const scheme = location.protocol === &apos;https:&apos; ? &apos;wss&apos; : &apos;ws&apos;;\0A    const ws = new WebSocket(`${scheme}://${location.host}/ws`);\0A    ws.binaryType = &apos;arraybuffer&apos;;\0A    this.ws = ws;\0A    this.setStatus(&apos;connecting&apos;\2C &apos;Connecting...&apos;);\0A    ws.onopen = () =&gt; { this.backoff = 250; this.setStatus(&apos;online&apos;\2C &apos;Connected&apos;); };\0A    ws.onmessage = (ev) =&gt; {\0A      if (typeof ev.data === &apos;string&apos;) this.onText(ev.data);\0A      else this.onFrame(ev.data);\0A    };\0A    ws.onclose = () =&gt; {\0A      if (this.ws !== ws) return;\0A      this.setStatus(&apos;offline&apos;\2C `Disconnected\2C retrying in ${(this.backoff / 1000).toFixed(1)} s`);\0A      setTimeout(() =&gt; this.connect()\2C this.backoff);\0A      this.backoff = Math.min(this.backoff * 2\2C 5000);\0A    };\0A  }\0A\0A  send(line) {\0A    if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(line);\0A  }\0A\0A  onText(text) {\0A    // Server text messages: &quot;title &lt;VI name&gt;&quot;\2C &quot;viewonly 0|1&quot;. Unknown ones are ignored.\0A    const sp = text.indexOf(&apos; &apos;);\0A    const cmd = sp &lt; 0 ? text : text.slice(0\2C sp);\0A    const arg = sp &lt; 0 ? &apos;&apos; : text.slice(sp + 1);\0A    if (cmd === &apos;title&apos;) {\0A      document.getElementById(&apos;vi-name&apos;).textContent = arg;\0A      document.title = `${arg} - RemoteVI`;\0A    } else if (cmd === &apos;viewonly&apos;) {\0A      document.body.dataset.viewOnly = String(arg === &apos;1&apos;);\0A    }\0A  }\0A\0A  onFrame(buf) {\0A    let frame;\0A    try {\0A      frame = decodeFrame(buf);\0A    } catch (err) {\0A      console.error(err);\0A      return;\0A    }\0A    this.stats.frames++;\0A    this.stats.bytes += buf.byteLength;\0A    this.queue = this.queue.then(() =&gt; this.paint(frame)).catch((err) =&gt; console.error(err));\0A  }\0A\0A  async paint(frame) {\0A    const bitmaps = await Promise.all(frame.rects.map((r) =&gt; createImageBitmap(r.png)));\0A    if (frame.width !== this.canvas.width || frame.height !== this.canvas.height) {\0A      this.canvas.width = frame.width;\0A      this.canvas.height = frame.height;\0A    }\0A    frame.rects.forEach((r\2C i) =&gt; {\0A      this.ctx.drawImage(bitmaps[i]\2C r.x\2C r.y);\0A      bitmaps[i].close();\0A    });\0A    // Ack after painting: the server keeps at most two frames in flight\2C so a\0A    // slow client gets fresher frames instead of a growing backlog.\0A    this.send(`a ${frame.seq}`);\0A  }\0A\0A  // --- input -------------------------------------------------------------------\0A\0A  panelPoint(e) {\0A    const r = this.canvas.getBoundingClientRect();\0A    const x = Math.floor((e.clientX - r.left) * (this.canvas.width / r.width));\0A    const y = Math.floor((e.clientY - r.top) * (this.canvas.height / r.height));\0A    return {\0A      x: Math.min(Math.max(x\2C 0)\2C this.canvas.width - 1)\2C\0A      y: Math.min(Math.max(y\2C 0)\2C this.canvas.height - 1)\2C\0A    };\0A  }\0A\0A  mouse(msg\2C e\2C wParam = mouseFlags(e)) {\0A    const { x\2C y } = this.panelPoint(e);\0A    this.send(`m ${msg} ${x} ${y} ${wParam}`);\0A  }\0A\0A  bindInput() {\0A    const c = this.canvas;\0A    c.addEventListener(&apos;contextmenu&apos;\2C (e) =&gt; e.preventDefault());\0A\0A    c.addEventListener(&apos;pointerdown&apos;\2C (e) =&gt; {\0A      const msgs = BUTTON_MSGS[e.button];\0A      if (!msgs) return;\0A      e.preventDefault();\0A      c.focus();\0A      c.setPointerCapture(e.pointerId);\0A      this.flushMove();\0A      // Windows reports the second press of a double click as *BUTTONDBLCLK.\0A      this.mouse(e.detail === 2 ? msgs[2] : msgs[0]\2C e);\0A    });\0A\0A    const up = (e) =&gt; {\0A      const msgs = BUTTON_MSGS[e.button];\0A      if (!msgs) return;\0A      this.flushMove();\0A      this.mouse(msgs[1]\2C e);\0A    };\0A    c.addEventListener(&apos;pointerup&apos;\2C up);\0A    c.addEventListener(&apos;pointercancel&apos;\2C up);\0A\0A    // Moves are coalesced to one per animation frame: only the latest position matters.\0A    c.addEventListener(&apos;pointermove&apos;\2C (e) =&gt; {\0A      const first = this.pendingMove === null;\0A      this.pendingMove = e;\0A      if (first) requestAnimationFrame(() =&gt; this.flushMove());\0A    });\0A\0A    c.addEventListener(&apos;wheel&apos;\2C (e) =&gt; {\0A      e.preventDefault();\0A      const notches = e.deltaMode === 0 ? -e.deltaY / 100 : -e.deltaY / 3;\0A      const delta = Math.round(Math.max(-3\2C Math.min(3\2C notches || -Math.sign(e.deltaY))) * WHEEL_DELTA);\0A      if (!delta) return;\0A      // The wheel delta is the signed high word of wParam.\0A      this.mouse(WM.MOUSEWHEEL\2C e\2C ((delta &amp; 0xFFFF) * 0x10000 + mouseFlags(e)) &gt;&gt;&gt; 0);\0A    }\2C { passive: false });\0A\0A    c.addEventListener(&apos;keydown&apos;\2C (e) =&gt; {\0A      const vk = VK[e.code];\0A      if (vk) {\0A        e.preventDefault();\0A        this.send(`k ${WM.KEYDOWN} ${vk[0]} ${keyLParam(vk[1]\2C false)}`);\0A      } else if (e.key.length === 1 &amp;&amp; !e.altKey &amp;&amp; !e.metaKey) {\0A        e.preventDefault();\0A        if (e.ctrlKey) {\0A          // Ctrl+letter shortcuts: control characters 1..26 are what Windows sends as WM_CHAR.\0A          const code = e.key.toUpperCase().charCodeAt(0);\0A          if (code &gt;= 65 &amp;&amp; code &lt;= 90) this.send(`k ${WM.CHAR} ${code - 64} 1`);\0A        } else {\0A          this.send(`k ${WM.CHAR} ${e.key.charCodeAt(0)} 1`);\0A        }\0A      }\0A    });\0A    c.addEventListener(&apos;keyup&apos;\2C (e) =&gt; {\0A      const vk = VK[e.code];\0A      if (vk) {\0A        e.preventDefault();\0A        this.send(`k ${WM.KEYUP} ${vk[0]} ${keyLParam(vk[1]\2C true)}`);\0A      }\0A    });\0A  }\0A\0A  flushMove() {\0A    const e = this.pendingMove;\0A    this.pendingMove = null;\0A    if (e) this.mouse(WM.MOUSEMOVE\2C e);\0A  }\0A\0A  // --- status ------------------------------------------------------------------\0A\0A  setStatus(state\2C text) {\0A    document.body.dataset.state = state;\0A    this.statusEl.textContent = text;\0A  }\0A\0A  showStats() {\0A    const secs = (performance.now() - this.stats.since) / 1000;\0A    this.statsEl.textContent =\0A      `${(this.stats.frames / secs).toFixed(0)} fps | ${(this.stats.bytes / 1024 / secs).toFixed(0)} KiB/s`;\0A    this.stats = { frames: 0\2C bytes: 0\2C since: performance.now() };\0A  }\0A}\0A\0Anew RemoteViClient();\0A&lt;/script&gt;\0A&lt;/body&gt;\0A&lt;/html&gt;\0A"/>
