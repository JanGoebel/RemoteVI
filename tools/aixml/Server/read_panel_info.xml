<VI _name="RemoteVI Read Panel Info.vi" description="The tip strips and splitter bars of the published panel (tips and splitters messages\2C docs\5Cprotocol.md 3.3) when refresh? is TRUE. A panel of this LabVIEW\3A RemoteVI Read Tips.vi and RemoteVI Read Splitters.vi. A panel of another LabVIEW reached over VI Server (RemoteVI Remote Target.vi has an entry for hWnd)\3A both run INSIDE that process through RemoteVI Remote Hooks.vi (RemoteVI Call Hooks.vi) - one round trip of a few VI Server calls instead of one per control\2C and the pane coordinate conversions stay in the process that owns the panes. Otherwise\2C or on an error\2C the inputs pass through.">
  <Control _name="VI" conIdx="0" connection="required" description="The published VI." outputs="value:vi.value" type="ref{LV.VI}" uid="vi" uid_parent="root" value=""/>
  <Control _name="hWnd" conIdx="1" connection="required" description="The published panel's window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="refresh?" conIdx="2" connection="required" description="TRUE reads now." outputs="value:rf.value" type="bool" uid="rf" uid_parent="root" value="false"/>
  <Control _name="origin" conIdx="3" connection="required" description="Where the panel area starts inside the frame." outputs="value:og.value" type="cluster{int32.x,int32.y}" uid="og" uid_parent="root" value="[0,0]"/>
  <Control _name="tips in" conIdx="5" connection="required" description="The last tips message." outputs="value:ti.value" type="string" uid="ti" uid_parent="root" value="tips []"/>
  <Control _name="splitters in" conIdx="6" connection="required" description="The last splitters message." outputs="value:si.value" type="string" uid="si" uid_parent="root" value="splitters []"/>
  <Control _name="bars in" conIdx="7" connection="recommended" description="The last bars." outputs="value:bi.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="bi" uid_parent="root" value="[]"/>
  <Constant outputs="value:kf.value" type="bool" uid="kf" uid_parent="root" value="false"/>
  <Call inputs="put?:kf.value,hWnd:hw.value,remove?:kf.value" outputs="found?:rt.found?,hooks out:rt.hooks out,VI name out:rt.VI name out" target="RemoteVI Remote Target.vi" uid="rt" uid_parent="root"/>
  <Node _name="And" inputs="x:rt.found?,y:rf.value" outputs="x .and. y?:remote.v" uid="remote" uid_parent="root"/>
  <Structure _name="Case Structure" selectin="remote.v" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:vi.value" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:rf.value" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:og.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:ti.value" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:si.value" uid="cs_i5" uid_parent="cs"/>
    <Tunnel _id="In6" inputs="value:bi.value" uid="cs_i6" uid_parent="cs"/>
    <Tunnel _id="In7" inputs="value:rt.hooks out" uid="cs_i7" uid_parent="cs"/>
    <Tunnel _id="In8" inputs="value:rt.VI name out" uid="cs_i8" uid_parent="cs"/>
    <CaseFrame label="Another LabVIEW over VI Server\3A read them there" selector="True" selectout="" uid="cst" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:" uid="t_vi" uid_parent="cst"/>
      <Tunnel _id="In2" outputs="value:" uid="t_rf" uid_parent="cst"/>
      <Tunnel _id="In3" outputs="value:t_og.value" uid="t_og" uid_parent="cst"/>
      <Tunnel _id="In4" outputs="value:t_ti.value" uid="t_ti" uid_parent="cst"/>
      <Tunnel _id="In5" outputs="value:t_si.value" uid="t_si" uid_parent="cst"/>
      <Tunnel _id="In6" outputs="value:t_bi.value" uid="t_bi" uid_parent="cst"/>
      <Tunnel _id="In7" outputs="value:t_hk.value" uid="t_hk" uid_parent="cst"/>
      <Tunnel _id="In8" outputs="value:t_vn.value" uid="t_vn" uid_parent="cst"/>
      <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="cst" value="true"/>
      <Call inputs="hooks:t_hk.value,panel?:kt.value,VI name:t_vn.value,origin:t_og.value,tips in:t_ti.value,splitters in:t_si.value,bars in:t_bi.value" outputs="tips out:ch.tips out,splitters out:ch.splitters out,bars out:ch.bars out,error out:" target="RemoteVI Call Hooks.vi" uid="ch" uid_parent="cst"/>
      <Tunnel _id="Out1" inputs="value:ch.tips out" uid="t_o1" uid_parent="cst"/>
      <Tunnel _id="Out2" inputs="value:ch.splitters out" uid="t_o2" uid_parent="cst"/>
      <Tunnel _id="Out3" inputs="value:ch.bars out" uid="t_o3" uid_parent="cst"/>
    </CaseFrame>
    <CaseFrame label="This LabVIEW" selector="False" selectout="" uid="csf" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:f_vi.value" uid="f_vi" uid_parent="csf"/>
      <Tunnel _id="In2" outputs="value:f_rf.value" uid="f_rf" uid_parent="csf"/>
      <Tunnel _id="In3" outputs="value:f_og.value" uid="f_og" uid_parent="csf"/>
      <Tunnel _id="In4" outputs="value:f_ti.value" uid="f_ti" uid_parent="csf"/>
      <Tunnel _id="In5" outputs="value:f_si.value" uid="f_si" uid_parent="csf"/>
      <Tunnel _id="In6" outputs="value:f_bi.value" uid="f_bi" uid_parent="csf"/>
      <Tunnel _id="In7" outputs="value:" uid="f_hk" uid_parent="csf"/>
      <Tunnel _id="In8" outputs="value:" uid="f_vn" uid_parent="csf"/>
      <Call inputs="VI:f_vi.value,refresh?:f_rf.value,origin:f_og.value,message in:f_ti.value" outputs="message out:rtp.message out" target="RemoteVI Read Tips.vi" uid="rtp" uid_parent="csf"/>
      <Call inputs="VI:f_vi.value,refresh?:f_rf.value,origin:f_og.value,message in:f_si.value,bars in:f_bi.value" outputs="message out:rsp.message out,bars out:rsp.bars out" target="RemoteVI Read Splitters.vi" uid="rsp" uid_parent="csf"/>
      <Tunnel _id="Out1" inputs="value:rtp.message out" uid="f_o1" uid_parent="csf"/>
      <Tunnel _id="Out2" inputs="value:rsp.message out" uid="f_o2" uid_parent="csf"/>
      <Tunnel _id="Out3" inputs="value:rsp.bars out" uid="f_o3" uid_parent="csf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:to.value" uid="to" uid_parent="cs"/>
    <Tunnel _id="Out2" outputs="value:so.value" uid="so" uid_parent="cs"/>
    <Tunnel _id="Out3" outputs="value:bo.value" uid="bo" uid_parent="cs"/>
  </Structure>
  <Indicator _name="tips out" conIdx="4" connection="recommended" description="The tips message." inputs="value:to.value" type="string" uid="o_t" uid_parent="root" value=""/>
  <Indicator _name="splitters out" conIdx="8" connection="recommended" description="The splitters message." inputs="value:so.value" type="string" uid="o_s" uid_parent="root" value=""/>
  <Indicator _name="bars out" conIdx="9" connection="recommended" description="The splitter bars." inputs="value:bo.value" type="array{cluster{int32.x,int32.y,int32.w,int32.h,bool.vertical,int32.min,int32.max}}" uid="o_b" uid_parent="root" value="[]"/>
</VI>
