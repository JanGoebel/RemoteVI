<VI _name="RemoteVI Send Window Frame.vi" description="Sends one WINDOW FRAME of one listed window to one client if flow control allows (docs\5Cprotocol.md sections 5 and 7) - RemoteVI Send Frame.vi for another window. Nothing happens when the client is closed or already has 2 unacknowledged frames (seq - acked &gt;= 2\2C the seq is shared with FRAME)\2C when the capture is empty (the window could not be drawn)\2C or when RemoteVI Dirty Rects.vi finds no change against last sent - the picture of THIS window this client was last sent\3B an empty last sent (a window the client has not seen yet) or a size change gives the whole window. Otherwise every dirty rect is encoded with RemoteVI Encode Rect PNG.vi\2C the message is built with RemoteVI Window Frame Encode.vi (id\2C seq + 1\2C width\2C height)\2C wrapped in a binary WebSocket frame and written with TCP Write (2 s timeout). On success seq is incremented\2C last sent out becomes pixmap and sent? is TRUE\3B a write error sets closed instead. error out carries PNG encoding errors.">
  <FreeLabel comment="Only what changed since this client's last" uid="lbl" uid_parent="root"/>
  <Control _name="Client" conIdx="0" connection="required" description="Per-client state (same cluster as in RemoteVI Server Loop.vi)." outputs="value:cl.value" type="cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since,string.windows sent,array{cluster{uint64.id,array.2{uint32}.pixels}}.window frames,uint64.key window}" uid="cl" uid_parent="root" value="[0,,0,0,[],false,false,0,0,0,,[],0]"/>
  <Control _name="id" conIdx="5" connection="required" description="The window (its HWND\2C the id of docs\5Cprotocol.md section 7)." outputs="value:id.value" type="uint64" uid="id" uid_parent="root" value="0"/>
  <Control _name="pixmap" conIdx="7" connection="required" description="The window's current capture (its client area)\2C [row\2C column] 0x00RRGGBB." outputs="value:pm.value" type="array.2{uint32}" uid="pm" uid_parent="root" value="[]"/>
  <Control _name="width" conIdx="9" connection="required" description="Width of the capture in pixels." outputs="value:w.value" type="int32" uid="w" uid_parent="root" value="0"/>
  <Control _name="height" conIdx="1" connection="required" description="Height of the capture in pixels." outputs="value:h.value" type="int32" uid="h" uid_parent="root" value="0"/>
  <Control _name="last sent" conIdx="2" connection="recommended" description="The capture of this window this client was last sent\3B empty when none." outputs="value:ls.value" type="array.2{uint32}" uid="ls" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>

  <Structure _name="For Loop" count="" label="Never runs\3A TCP refnum type only" maxin="tn0.value" maxout="" uid="tpl" uid_parent="root">
    <Constant outputs="value:tp0.value" type="uint16" uid="tp0" uid_parent="tpl" value="0"/>
    <Node _name="TCP Open Connection" inputs="remote port or service name:tp0.value" outputs="connection ID:toc.connection ID" uid="toc" uid_parent="tpl"/>
    <Tunnel _id="Out1" inputs="value:toc.connection ID" outputs="value:tplo.value" uid="tplo" uid_parent="tpl"/>
  </Structure>
  <Constant outputs="value:tn0.value" type="int32" uid="tn0" uid_parent="root" value="0"/>
  <Node _name="Unbundle By Name" fields="connection,seq,acked,closed" inputs="input cluster:cl.value" outputs="connection:ub.connection,seq:ub.seq,acked:ub.acked,closed:ub.closed" uid="ub" uid_parent="root"/>
  <Node _name="Type Cast" inputs="x:ub.connection,type:tplo.value" outputs="*(type *) &amp;x:conn.*(type *) &amp;x" uid="conn" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:ub.seq,y:ub.acked" outputs="x-y:inflight.x-y" uid="inflight" uid_parent="root"/>
  <Constant outputs="value:two.value" type="uint32" uid="two" uid_parent="root" value="2"/>
  <Node _name="Greater Or Equal?" inputs="x:inflight.x-y,y:two.value" outputs="x &gt;= y?:busy.x &gt;= y?" uid="busy" uid_parent="root"/>
  <Node _name="Empty Array?" inputs="array:pm.value" outputs="empty?:nopic.v" uid="nopic" uid_parent="root"/>
  <Node _name="Build Array" inputs="element:ub.closed,element:busy.x &gt;= y?,element:nopic.v" outputs="appended array:sk3.v" uid="sk3" uid_parent="root"/>
  <Node _name="Or Array Elements" inputs="Boolean array:sk3.v" outputs="logical OR:skip.v" uid="skip" uid_parent="root"/>

  <Structure _name="Case Structure" selectin="skip.v" uid="cs" uid_parent="root">
    <Tunnel _id="In1" inputs="value:cl.value" uid="cs_i1" uid_parent="cs"/>
    <Tunnel _id="In2" inputs="value:ei.value" uid="cs_i2" uid_parent="cs"/>
    <Tunnel _id="In3" inputs="value:pm.value" uid="cs_i3" uid_parent="cs"/>
    <Tunnel _id="In4" inputs="value:ls.value" uid="cs_i4" uid_parent="cs"/>
    <Tunnel _id="In5" inputs="value:ub.seq" uid="cs_i5" uid_parent="cs"/>
    <Tunnel _id="In6" inputs="value:conn.*(type *) &amp;x" uid="cs_i6" uid_parent="cs"/>
    <Tunnel _id="In7" inputs="value:w.value" uid="cs_i7" uid_parent="cs"/>
    <Tunnel _id="In8" inputs="value:h.value" uid="cs_i8" uid_parent="cs"/>
    <Tunnel _id="In9" inputs="value:id.value" uid="cs_i9" uid_parent="cs"/>
    <CaseFrame label="Closed\2C 2 frames in flight or no picture" selector="True" selectout="" uid="cst" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:t_cl.value" uid="t_cl" uid_parent="cst"/>
      <Tunnel _id="In2" outputs="value:t_ei.value" uid="t_ei" uid_parent="cst"/>
      <Tunnel _id="In3" outputs="value:" uid="t_i3" uid_parent="cst"/>
      <Tunnel _id="In4" outputs="value:t_ls.value" uid="t_ls" uid_parent="cst"/>
      <Tunnel _id="In5" outputs="value:" uid="t_i5" uid_parent="cst"/>
      <Tunnel _id="In6" outputs="value:" uid="t_i6" uid_parent="cst"/>
      <Tunnel _id="In7" outputs="value:" uid="t_i7" uid_parent="cst"/>
      <Tunnel _id="In8" outputs="value:" uid="t_i8" uid_parent="cst"/>
      <Tunnel _id="In9" outputs="value:" uid="t_i9" uid_parent="cst"/>
      <Constant outputs="value:tf.value" type="bool" uid="tf" uid_parent="cst" value="false"/>
      <Tunnel _id="Out1" inputs="value:t_cl.value" uid="t_o1" uid_parent="cst"/>
      <Tunnel _id="Out2" inputs="value:tf.value" uid="t_o2" uid_parent="cst"/>
      <Tunnel _id="Out3" inputs="value:t_ei.value" uid="t_o3" uid_parent="cst"/>
      <Tunnel _id="Out4" inputs="value:t_ls.value" uid="t_o4" uid_parent="cst"/>
    </CaseFrame>
    <CaseFrame label="May send\3A diff against last sent" selector="False" selectout="" uid="csf" uid_parent="cs">
      <Tunnel _id="In1" outputs="value:f_cl.value" uid="f_cl" uid_parent="csf"/>
      <Tunnel _id="In2" outputs="value:f_ei.value" uid="f_ei" uid_parent="csf"/>
      <Tunnel _id="In3" outputs="value:f_pm.value" uid="f_pm" uid_parent="csf"/>
      <Tunnel _id="In4" outputs="value:f_last.value" uid="f_last" uid_parent="csf"/>
      <Tunnel _id="In5" outputs="value:f_seq.value" uid="f_seq" uid_parent="csf"/>
      <Tunnel _id="In6" outputs="value:f_conn.value" uid="f_conn" uid_parent="csf"/>
      <Tunnel _id="In7" outputs="value:f_w.value" uid="f_w" uid_parent="csf"/>
      <Tunnel _id="In8" outputs="value:f_h.value" uid="f_h" uid_parent="csf"/>
      <Tunnel _id="In9" outputs="value:f_id.value" uid="f_id" uid_parent="csf"/>
      <Constant outputs="value:tile.value" type="int32" uid="tile" uid_parent="csf" value="64"/>
      <Call inputs="previous:f_last.value,current:f_pm.value,tile size:tile.value" outputs="rects:dr.rects" target="RemoteVI Dirty Rects.vi" uid="dr" uid_parent="csf"/>
      <Node _name="Empty Array?" inputs="array:dr.rects" outputs="empty?:emp.empty?" uid="emp" uid_parent="csf"/>
      <Structure _name="Case Structure" selectin="emp.empty?" uid="ce" uid_parent="csf">
        <Tunnel _id="In1" inputs="value:f_cl.value" uid="ce_i1" uid_parent="ce"/>
        <Tunnel _id="In2" inputs="value:f_ei.value" uid="ce_i2" uid_parent="ce"/>
        <Tunnel _id="In3" inputs="value:f_pm.value" uid="ce_i3" uid_parent="ce"/>
        <Tunnel _id="In4" inputs="value:f_last.value" uid="ce_i4" uid_parent="ce"/>
        <Tunnel _id="In5" inputs="value:f_seq.value" uid="ce_i5" uid_parent="ce"/>
        <Tunnel _id="In6" inputs="value:f_conn.value" uid="ce_i6" uid_parent="ce"/>
        <Tunnel _id="In7" inputs="value:f_w.value" uid="ce_i7" uid_parent="ce"/>
        <Tunnel _id="In8" inputs="value:f_h.value" uid="ce_i8" uid_parent="ce"/>
        <Tunnel _id="In9" inputs="value:dr.rects" uid="ce_i9" uid_parent="ce"/>
        <Tunnel _id="In10" inputs="value:f_id.value" uid="ce_i10" uid_parent="ce"/>
        <CaseFrame label="Nothing changed" selector="True" selectout="" uid="cet" uid_parent="ce">
          <Tunnel _id="In1" outputs="value:e_cl.value" uid="e_cl" uid_parent="cet"/>
          <Tunnel _id="In2" outputs="value:e_ei.value" uid="e_ei" uid_parent="cet"/>
          <Tunnel _id="In3" outputs="value:" uid="e_i3" uid_parent="cet"/>
          <Tunnel _id="In4" outputs="value:e_last.value" uid="e_last" uid_parent="cet"/>
          <Tunnel _id="In5" outputs="value:" uid="e_i5" uid_parent="cet"/>
          <Tunnel _id="In6" outputs="value:" uid="e_i6" uid_parent="cet"/>
          <Tunnel _id="In7" outputs="value:" uid="e_i7" uid_parent="cet"/>
          <Tunnel _id="In8" outputs="value:" uid="e_i8" uid_parent="cet"/>
          <Tunnel _id="In9" outputs="value:" uid="e_i9" uid_parent="cet"/>
          <Tunnel _id="In10" outputs="value:" uid="e_i10" uid_parent="cet"/>
          <Constant outputs="value:ef.value" type="bool" uid="ef" uid_parent="cet" value="false"/>
          <Tunnel _id="Out1" inputs="value:e_cl.value" uid="e_o1" uid_parent="cet"/>
          <Tunnel _id="Out2" inputs="value:ef.value" uid="e_o2" uid_parent="cet"/>
          <Tunnel _id="Out3" inputs="value:e_ei.value" uid="e_o3" uid_parent="cet"/>
          <Tunnel _id="Out4" inputs="value:e_last.value" uid="e_o4" uid_parent="cet"/>
        </CaseFrame>
        <CaseFrame label="Encode and send" selector="False" selectout="" uid="cef" uid_parent="ce">
          <Tunnel _id="In1" outputs="value:s_cl.value" uid="s_cl" uid_parent="cef"/>
          <Tunnel _id="In2" outputs="value:s_ei.value" uid="s_ei" uid_parent="cef"/>
          <Tunnel _id="In3" outputs="value:s_pm.value" uid="s_pm" uid_parent="cef"/>
          <Tunnel _id="In4" outputs="value:s_last.value" uid="s_last" uid_parent="cef"/>
          <Tunnel _id="In5" outputs="value:s_seq.value" uid="s_seq" uid_parent="cef"/>
          <Tunnel _id="In6" outputs="value:s_conn.value" uid="s_conn" uid_parent="cef"/>
          <Tunnel _id="In7" outputs="value:s_w.value" uid="s_w" uid_parent="cef"/>
          <Tunnel _id="In8" outputs="value:s_h.value" uid="s_h" uid_parent="cef"/>
          <Tunnel _id="In9" outputs="value:s_rects.value" uid="s_rects" uid_parent="cef"/>
          <Tunnel _id="In10" outputs="value:s_id.value" uid="s_id" uid_parent="cef"/>
          <Constant outputs="value:i16t.value" type="int16" uid="i16t" uid_parent="cef" value="0"/>
          <Constant outputs="value:rc0.value" type="cluster{int16.x,int16.y,string.png}" uid="rc0" uid_parent="cef" value="[0,0,]"/>
          <Structure _name="For Loop" count="" label="One PNG per dirty rect" maxin="" maxout="" uid="fl" uid_parent="cef">
            <Tunnel _id="In1" inputs="value:s_rects.value" mode="index" outputs="value:r.value" uid="r" uid_parent="fl"/>
            <Tunnel _id="In2" inputs="value:s_pm.value" outputs="value:l_pm.value" uid="l_pm" uid_parent="fl"/>
            <Tunnel _id="In3" inputs="value:i16t.value" outputs="value:l_t.value" uid="l_t" uid_parent="fl"/>
            <Tunnel _id="In4" inputs="value:rc0.value" outputs="value:l_rc.value" uid="l_rc" uid_parent="fl"/>
            <ShiftReg uid="sre" uid_parent="fl">
              <Left inputs="value:s_ei.value" outputs="value:le.value" uid="srel" uid_parent="sre"/>
              <Right inputs="value:enc.error out" outputs="value:enc_err.value" uid="srer" uid_parent="sre"/>
            </ShiftReg>
            <Call inputs="pixmap:l_pm.value,rect:r.value,error in:le.value" outputs="png:enc.png,error out:enc.error out" target="RemoteVI Encode Rect PNG.vi" uid="enc" uid_parent="fl"/>
            <Node _name="Unbundle By Name" fields="x,y" inputs="input cluster:r.value" outputs="x:rxy.x,y:rxy.y" uid="rxy" uid_parent="fl"/>
            <Node _name="To Unsigned Word Integer" inputs="number:rxy.x" outputs="unsigned 16bit integer:ux.unsigned 16bit integer" uid="ux" uid_parent="fl"/>
            <Node _name="To Unsigned Word Integer" inputs="number:rxy.y" outputs="unsigned 16bit integer:uy.unsigned 16bit integer" uid="uy" uid_parent="fl"/>
            <Node _name="Type Cast" inputs="x:ux.unsigned 16bit integer,type:l_t.value" outputs="*(type *) &amp;x:ix.*(type *) &amp;x" uid="ix" uid_parent="fl"/>
            <Node _name="Type Cast" inputs="x:uy.unsigned 16bit integer,type:l_t.value" outputs="*(type *) &amp;x:iy.*(type *) &amp;x" uid="iy" uid_parent="fl"/>
            <Node _name="Bundle By Name" fields="x,y,png" inputs="x:ix.*(type *) &amp;x,y:iy.*(type *) &amp;x,png:enc.png,input cluster:l_rc.value" outputs="output cluster:rb.output cluster" uid="rb" uid_parent="fl"/>
            <Tunnel _id="Out1" inputs="value:rb.output cluster" mode="index" outputs="value:frects.value" uid="frects" uid_parent="fl"/>
          </Structure>
          <Node _name="Increment" inputs="x:s_seq.value" outputs="x+1:seq1.x+1" uid="seq1" uid_parent="cef"/>
          <Node _name="To Unsigned Long Integer" inputs="number:s_id.value" outputs="unsigned 32bit integer:uid32.v" uid="uid32" uid_parent="cef"/>
          <Node _name="To Unsigned Word Integer" inputs="number:s_w.value" outputs="unsigned 16bit integer:uw.unsigned 16bit integer" uid="uw" uid_parent="cef"/>
          <Node _name="To Unsigned Word Integer" inputs="number:s_h.value" outputs="unsigned 16bit integer:uh.unsigned 16bit integer" uid="uh" uid_parent="cef"/>
          <Call inputs="id:uid32.v,seq:seq1.x+1,width:uw.unsigned 16bit integer,height:uh.unsigned 16bit integer,rects:frects.value" outputs="message:fe.message" target="RemoteVI Window Frame Encode.vi" uid="fe" uid_parent="cef"/>
          <Constant outputs="value:op2.value" type="uint8" uid="op2" uid_parent="cef" value="2"/>
          <Call inputs="opcode:op2.value,payload:fe.message" outputs="frame:wf.frame" target="RemoteVI WS Encode Server Frame.vi" uid="wf" uid_parent="cef"/>
          <Constant outputs="value:wto.value" type="int32" uid="wto" uid_parent="cef" value="2000"/>
          <Node _name="TCP Write" inputs="connection ID:s_conn.value,data in:wf.frame,?parm9:wto.value" outputs="error out:tw.error out" uid="tw" uid_parent="cef"/>
          <Node _name="Unbundle By Name" fields="status" inputs="input cluster:tw.error out" outputs="status:tws.status" uid="tws" uid_parent="cef"/>
          <Node _name="Not" inputs="x:tws.status" outputs=".not. x?:wok..not. x?" uid="wok" uid_parent="cef"/>
          <Node _name="Select" inputs="t:seq1.x+1,s:wok..not. x?,f:s_seq.value" outputs="s? t\3Af:nseq.s? t\3Af" uid="nseq" uid_parent="cef"/>
          <Node _name="Select" inputs="t:s_pm.value,s:wok..not. x?,f:s_last.value" outputs="s? t\3Af:nlast.s? t\3Af" uid="nlast" uid_parent="cef"/>
          <Node _name="Bundle By Name" fields="seq,closed" inputs="seq:nseq.s? t\3Af,closed:tws.status,input cluster:s_cl.value" outputs="output cluster:ncl.output cluster" uid="ncl" uid_parent="cef"/>
          <Tunnel _id="Out1" inputs="value:ncl.output cluster" uid="s_o1" uid_parent="cef"/>
          <Tunnel _id="Out2" inputs="value:wok..not. x?" uid="s_o2" uid_parent="cef"/>
          <Tunnel _id="Out3" inputs="value:enc_err.value" uid="s_o3" uid_parent="cef"/>
          <Tunnel _id="Out4" inputs="value:nlast.s? t\3Af" uid="s_o4" uid_parent="cef"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:ce_o1.value" uid="ce_o1" uid_parent="ce"/>
        <Tunnel _id="Out2" outputs="value:ce_o2.value" uid="ce_o2" uid_parent="ce"/>
        <Tunnel _id="Out3" outputs="value:ce_o3.value" uid="ce_o3" uid_parent="ce"/>
        <Tunnel _id="Out4" outputs="value:ce_o4.value" uid="ce_o4" uid_parent="ce"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:ce_o1.value" uid="f_o1" uid_parent="csf"/>
      <Tunnel _id="Out2" inputs="value:ce_o2.value" uid="f_o2" uid_parent="csf"/>
      <Tunnel _id="Out3" inputs="value:ce_o3.value" uid="f_o3" uid_parent="csf"/>
      <Tunnel _id="Out4" inputs="value:ce_o4.value" uid="f_o4" uid_parent="csf"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:cs_o1.value" uid="cs_o1" uid_parent="cs"/>
    <Tunnel _id="Out2" outputs="value:cs_o2.value" uid="cs_o2" uid_parent="cs"/>
    <Tunnel _id="Out3" outputs="value:cs_o3.value" uid="cs_o3" uid_parent="cs"/>
    <Tunnel _id="Out4" outputs="value:cs_o4.value" uid="cs_o4" uid_parent="cs"/>
  </Structure>

  <Indicator _name="Client out" conIdx="4" connection="recommended" description="The client after sending\3A seq and closed updated." inputs="value:cs_o1.value" type="cluster{uint32.connection,string.rx buffer,uint32.seq,uint32.acked,array.2{uint32}.last sent,bool.tracking,bool.closed,uint8.mods,uint8.mods set,uint32.popup since,string.windows sent,array{cluster{uint64.id,array.2{uint32}.pixels}}.window frames,uint64.key window}" uid="o_cl" uid_parent="root" value="[0,,0,0,[],false,false,0,0,0,,[],0]"/>
  <Indicator _name="last sent out" conIdx="6" connection="recommended" description="pixmap when a frame was written\2C else last sent." inputs="value:cs_o4.value" type="array.2{uint32}" uid="o_ls" uid_parent="root" value="[]"/>
  <Indicator _name="sent?" conIdx="8" connection="recommended" description="TRUE when a frame was written." inputs="value:cs_o2.value" type="bool" uid="o_sent" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in merged with PNG encoding errors. A TCP write error is not reported here\3B it sets closed." inputs="value:cs_o3.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
