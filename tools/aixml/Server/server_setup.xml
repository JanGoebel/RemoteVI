<VI _name="RemoteVI Server Setup.vi" description="What the server loop needs before its first iteration\3A hello (the greeting frames with the name of VI\2C RemoteVI Greeting.vi)\2C html (the web client\2C RemoteVI Index HTML.vi)\2C the panel geometry and window handle (RemoteVI Get Panel Geometry.vi) and period = 1000 / fps ms. error out carries error in and the error of reading the VI name.">
  <Control _name="VI" conIdx="0" connection="required" description="The published VI." outputs="value:vi.value" type="ref{LV.VI}" uid="vi" uid_parent="root" value=""/>
  <Control _name="fps" conIdx="5" connection="recommended" description="Most captures per second." outputs="value:fps.value" type="double" uid="fps" uid_parent="root" value="20"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Property Node" fields="read+VI Name" inputs="reference:vi.value,error in (no error):ei.value" outputs="error out:pn.error out,VI Name:pn.VI Name" type="{LV.VI}" uid="pn" uid_parent="root"/>
  <Call inputs="VI name:pn.VI Name" outputs="hello:gr.hello" target="RemoteVI Greeting.vi" uid="gr" uid_parent="root"/>
  <Call inputs="" outputs="html:ih.html" target="RemoteVI Index HTML.vi" uid="ih" uid_parent="root"/>
  <Call inputs="VI:vi.value" outputs="geo:gg0.geo,hWnd:gg0.hWnd,error out:" target="RemoteVI Get Panel Geometry.vi" uid="gg0" uid_parent="root"/>
  <Constant outputs="value:k1000.value" type="double" uid="k1000" uid_parent="root" value="1000"/>
  <Node _name="Divide" inputs="x:k1000.value,y:fps.value" outputs="x/y:period.x/y" uid="period" uid_parent="root"/>
  <Indicator _name="hello" conIdx="4" connection="recommended" description="The greeting frames for a new client." inputs="value:gr.hello" type="string" uid="o_h" uid_parent="root" value=""/>
  <Indicator _name="html" conIdx="6" connection="recommended" description="The web client page." inputs="value:ih.html" type="string" uid="o_ht" uid_parent="root" value=""/>
  <Indicator _name="geo" conIdx="8" connection="recommended" description="Panel origin and client-area origin in screen coordinates." inputs="value:gg0.geo" type="cluster{int32.panelX,int32.panelY,int32.clientX,int32.clientY}" uid="o_geo" uid_parent="root" value="[0,0,0,0]"/>
  <Indicator _name="hWnd" conIdx="10" connection="recommended" description="Native handle of the panel window." inputs="value:gg0.hWnd" type="uint64" uid="o_hw" uid_parent="root" value="0"/>
  <Indicator _name="period" conIdx="3" connection="recommended" description="1000 / fps\2C in ms." inputs="value:period.x/y" type="double" uid="o_per" uid_parent="root" value="0"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in and the error of reading the VI name." inputs="value:pn.error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
