<VI _name="RemoteVI VI Server Request.vi" description="Hands the VI Server address of a window share from RemoteVI Launch Share.vi to the share's server loop (RemoteVI Server Setup.vi\2C which connects in the loop so the loop owns the references) - a functional global with one slot (a Feedback Node outside any loop)\3B Launch Share waits until the loop has started\2C so one slot is enough. put? TRUE stores address for hWnd\3B FALSE takes the address stored for hWnd (address out\3B empty and stored? FALSE when none was stored for this hWnd). address\3A empty = find out from the application's INI file (server.tcp.enabled\2C server.tcp.port)\2C off = window only\2C host\3Aport = that VI Server.">
  <Control _name="put?" conIdx="0" connection="recommended" description="TRUE stores\2C FALSE takes." outputs="value:put.value" type="bool" uid="put" uid_parent="root" value="false"/>
  <Control _name="hWnd" conIdx="1" connection="required" description="The shared window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="address" conIdx="2" connection="recommended" description="The VI Server address to store." outputs="value:ad.value" type="string" uid="ad" uid_parent="root" value=""/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Passed through (for the order of calls)." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant _name="nothing yet" outputs="value:init.value" type="cluster{bool.valid,uint64.hWnd,string.address}" uid="init" uid_parent="root" value="[false,0,]"/>
  <Node _name="Feedback Node" inputs="initializer:init.value,next value:nx.s? t\3Af" outputs="previous value:fb.previous value" uid="fb" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="valid,hWnd,address" inputs="input cluster:fb.previous value" outputs="valid:ps.valid,hWnd:ps.hWnd,address:ps.address" uid="ps" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:ps.hWnd,y:hw.value" outputs="x = y?:same.v" uid="same" uid_parent="root"/>
  <Node _name="And" inputs="x:ps.valid,y:same.v" outputs="x .and. y?:mine.v" uid="mine" uid_parent="root"/>
  <Node _name="Not" inputs="x:put.value" outputs=".not. x?:take.v" uid="take" uid_parent="root"/>
  <Node _name="And" inputs="x:take.v,y:mine.v" outputs="x .and. y?:got.v" uid="got" uid_parent="root"/>
  <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="root" value="true"/>
  <Constant outputs="value:kf.value" type="bool" uid="kf" uid_parent="root" value="false"/>
  <Node _name="Bundle By Name" fields="valid,hWnd,address" inputs="input cluster:init.value,valid:kt.value,hWnd:hw.value,address:ad.value" outputs="output cluster:stored.v" uid="stored" uid_parent="root"/>
  <Node _name="Bundle By Name" fields="valid" inputs="input cluster:fb.previous value,valid:kf.value" outputs="output cluster:taken.v" uid="taken" uid_parent="root"/>
  <Node _name="Select" inputs="t:taken.v,s:got.v,f:fb.previous value" outputs="s? t\3Af:kp.s? t\3Af" uid="kp" uid_parent="root"/>
  <Node _name="Select" inputs="t:stored.v,s:put.value,f:kp.s? t\3Af" outputs="s? t\3Af:nx.s? t\3Af" uid="nx" uid_parent="root"/>
  <Constant outputs="value:es.value" type="string" uid="es" uid_parent="root" value=""/>
  <Node _name="Select" inputs="t:ps.address,s:got.v,f:es.value" outputs="s? t\3Af:ao.v" uid="ao" uid_parent="root"/>
  <FreeLabel comment="One address kept between calls" uid="lbl" uid_parent="root"/>
  <Indicator _name="stored?" conIdx="4" connection="recommended" description="put? FALSE\3A TRUE when an address for hWnd was stored (and is now taken)." inputs="value:got.v" type="bool" uid="o_p" uid_parent="root" value="false"/>
  <Indicator _name="address out" conIdx="5" connection="recommended" description="The taken address." inputs="value:ao.v" type="string" uid="o_a" uid_parent="root" value=""/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in." inputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="o_e" uid_parent="root" value="[false,0,]"/>
</VI>
