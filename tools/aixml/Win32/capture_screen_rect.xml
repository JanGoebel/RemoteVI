<VI _name="RemoteVI Capture Screen Rect.vi" description="Copies the screen rectangle rect (x\2C y\2C w\2C h in screen pixels) into a 2D U32 pixmap [row\2C column] of 0x00RRGGBB values through GDI only - GetDC(0)\2C CreateCompatibleDC\2C CreateCompatibleBitmap\2C SelectObject\2C BitBlt with SRCCOPY | CAPTUREBLT\2C GetDIBits as 32-bit top-down rows - with no VI Server call\2C so it works while LabVIEW's UI thread is blocked by an open popup menu (which FP.Get Image cannot see). It captures whatever is on screen there\2C including windows covering the area. Every GDI object is deselected and released again\2C also when an earlier step failed. error out carries error in\2C a Call Library Function Node error\2C or code 5001 when GetDIBits copied no line (empty or off-screen rect\2C or a GDI failure)\3B pixmap is then all zero or empty.">
  <Control _name="rect" type="cluster{int32.x,int32.y,int32.w,int32.h}" uid="rect" uid_parent="root" value="[0,0,0,0]" conIdx="0" connection="required" description="Screen rectangle to capture\3A left x\2C top y\2C width w and height h in pixels." outputs="value:rect.value" />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="errin" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" description="When this carries an error nothing is captured (the cleanup calls still run on null handles\2C harmlessly)." outputs="value:errin.value" />
  <Indicator _name="pixmap" type="array.2{uint32}" uid="opix" uid_parent="root" value="[]" conIdx="4" connection="recommended" description="h rows of w pixels\2C top row first\2C each 0x00RRGGBB (the top byte is masked off)." inputs="value:rs.output array" />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="errout" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" description="error in\2C the first DLL call error\2C or 5001 when GetDIBits copied nothing." inputs="value:merge.error out" />
  <Node _name="Unbundle By Name" uid="ur" uid_parent="root" fields="x,y,w,h" inputs="input cluster:rect.value" outputs="x:ur.x,y:ur.y,w:ur.w,h:ur.h" />
