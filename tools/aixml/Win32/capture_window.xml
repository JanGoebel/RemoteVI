<VI _name="RemoteVI Capture Window.vi" description="Captures the window hwnd into a 2D U32 pixmap [row\2C column] of 0x00RRGGBB values by asking the window to draw itself (user32 PrintWindow with PW_RENDERFULLCONTENT 2) into a memory bitmap - GetWindowRect for the size\2C GetDC(0)\2C CreateCompatibleDC\2C CreateCompatibleBitmap\2C SelectObject\2C PrintWindow\2C GetDIBits as 32-bit top-down rows. Unlike a screen copy this sees the window's own pixels whether or not it is covered\2C on another monitor or made invisible (layered with alpha 0\2C RemoteVI Hide Window.vi) - measured on LabVIEW's popup menus (LVMenuWnd). No VI Server call\2C so it works while an open popup blocks LabVIEW's UI thread. Every GDI object is deselected and released again\2C also when an earlier step failed. error out carries error in\2C a Call Library Function Node error\2C 5002 when PrintWindow failed or 5001 when GetDIBits copied no line (the window is gone or empty)\3B pixmap may then be all zero or empty.">
  <Control _name="hwnd" type="uint64" uid="hw" uid_parent="root" value="0" conIdx="0" connection="required" description="The window to capture (HWND)\2C e.g. a popup from RemoteVI Find Popups.vi." outputs="value:hw.value" />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="errin" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" description="When this carries an error nothing is captured (the cleanup calls still run on null handles\2C harmlessly)." outputs="value:errin.value" />
  <Indicator _name="pixmap" type="array.2{uint32}" uid="opix" uid_parent="root" value="[]" conIdx="4" connection="recommended" description="h rows of w pixels of the whole window\2C top row first\2C each 0x00RRGGBB (the top byte is masked off)." inputs="value:rs.output array" />
  <Indicator _name="rect" type="cluster{int32.x,int32.y,int32.w,int32.h}" uid="orect" uid_parent="root" value="[0,0,0,0]" conIdx="6" connection="recommended" description="The window's screen rectangle (GetWindowRect)\3A left x\2C top y\2C width w\2C height h." inputs="value:brc.output cluster" />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="errout" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" description="error in\2C the first DLL call error\2C 5002 when PrintWindow failed or 5001 when GetDIBits copied nothing." inputs="value:merge.error out" />
  <Call uid="wr" uid_parent="root" target="user32 GetWindowRect.vi" inputs="hWnd:hw.value,error in:errin.value" outputs="RECT:wr.RECT,return value:,error out:wr.error out" />
