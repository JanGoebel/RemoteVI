<VI _name="RemoteVI Copy Window.vi" description="Copies the CLIENT AREA of the window hwnd into a 2D U32 pixmap [row\2C column] of 0x00RRGGBB values as Windows composited it last\3A user32 GetDC of the window\2C gdi32 BitBlt (SRCCOPY) into a memory bitmap of the client size (user32 GetClientRect)\2C GetDIBits as 32-bit top-down rows. With desktop composition every top-level window draws into its own surface\2C so this sees the window's pixels whether or not it is covered by other windows (measured on Windows 11 with a LabVIEW front panel behind a maximised window\2C pixel-identical to PrintWindow) - and unlike PrintWindow it does not make the window draw itself again\3A about 2-5 ms for an 817 x 543 panel instead of 40-50 ms with PrintWindow\2C during which LabVIEW's UI thread repainted the whole window (graph included) for every frame and was busy for nothing else (measured on the demo). A minimized window has an empty client area\3B pixmap is then empty. No VI Server call\2C so it works while an open popup holds LabVIEW's UI thread. Every GDI object is deselected and released again\2C also when an earlier step failed. error out carries error in\2C a Call Library Function Node error\2C 5003 when BitBlt failed or 5001 when GetDIBits copied no line.">
  <Control _name="hwnd" type="uint64" uid="hw" uid_parent="root" value="0" conIdx="0" connection="required" description="The window whose client area is copied (HWND)\2C e.g. the published front panel." outputs="value:hw.value" />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="errin" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" description="When this carries an error nothing is copied (the cleanup calls still run on null handles\2C harmlessly)." outputs="value:errin.value" />
  <Indicator _name="pixmap" type="array.2{uint32}" uid="opix" uid_parent="root" value="[]" conIdx="4" connection="recommended" description="h rows of w pixels of the client area\2C top row first\2C each 0x00RRGGBB (the top byte is masked off)." inputs="value:rs.output array" />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="errout" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" description="error in\2C the first DLL call error\2C 5003 when BitBlt failed or 5001 when GetDIBits copied nothing." inputs="value:merge.error out" />
