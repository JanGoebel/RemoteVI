<VI _name="RemoteVI Find Popups.vi" description="Lists LabVIEW's own visible popup windows - ring and enum menus (class LVMenuWnd)\2C and other captionless WS_POPUP windows such as shortcut menus and combo box drop-downs - which FP.Get Image does not include. It walks every top-level window with FindWindowExW(0\2C previous\2C NULL\2C NULL)\2C keeps those whose process is LabVIEW's (GetWindowThreadProcessId = GetCurrentProcessId) and that are not panel hWnd\2C and asks RemoteVI Window Popup Info.vi about each. Win32 calls only\2C no VI Server\2C so it runs while an open menu holds LabVIEW's UI thread in its modal loop. Meant to run on every server loop iteration.">
  <Control _name="panel hWnd" type="uint64" uid="panel" uid_parent="root" value="0" conIdx="0" connection="required" description="The served front panel's window (Front Panel Window\3AOS Window)\2C which is never reported as a popup." outputs="value:panel.value" />
  <Control _name="error in" type="cluster{bool.status,int32.code,string.source}" uid="errin" uid_parent="root" value="[false,0,]" conIdx="11" connection="recommended" description="When this carries an error nothing is searched and popups is empty." outputs="value:errin.value" />
  <Indicator _name="popups" type="array{cluster{uint64.hwnd,int32.x,int32.y,int32.w,int32.h,string.class}}" uid="opop" uid_parent="root" value="[]" conIdx="4" connection="recommended" description="One element per popup in Z order (topmost first)\3A its window handle\2C its screen rectangle and its class name." inputs="value:lpop.value" />
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="errout" uid_parent="root" value="[false,0,]" conIdx="15" connection="recommended" description="error in or the first Call Library Function Node error." inputs="value:srER.value" />
  <Call uid="pid" uid_parent="root" target="kernel32 GetCurrentProcessId.vi" inputs="error in:errin.value" outputs="process ID:pid.process ID,error out:pid.error out" />
  <Constant _name="first" type="uint64" uid="k0" uid_parent="root" value="0" outputs="value:k0.value" />
  <Structure _name="While Loop" uid="loop" uid_parent="root" count="" label="One top-level window per iteration">
    <Tunnel _id="In1" uid="lpid" uid_parent="loop" inputs="value:pid.process ID" outputs="value:lpid.value" />
    <Tunnel _id="In2" uid="lpanel" uid_parent="loop" inputs="value:panel.value" outputs="value:lpanel.value" />
    <ShiftReg uid="srh" uid_parent="loop">
      <Left uid="srhL" uid_parent="srh" inputs="value:k0.value" outputs="value:srhL.value" />
      <Right uid="srhR" uid_parent="srh" inputs="value:next.hWnd" outputs="value:srhR.value" />
    </ShiftReg>
    <ShiftReg uid="sre" uid_parent="loop">
      <Left uid="srEL" uid_parent="sre" inputs="value:pid.error out" outputs="value:srEL.value" />
      <Right uid="srER" uid_parent="sre" inputs="value:cerr.value" outputs="value:srER.value" />
    </ShiftReg>
    <Call uid="next" uid_parent="loop" target="user32 FindWindowExW.vi" inputs="hWndChildAfter:srhL.value,error in:srEL.value" outputs="hWnd:next.hWnd,error out:next.error out" />
    <Call uid="owner" uid_parent="loop" target="user32 GetWindowThreadProcessId.vi" inputs="hWnd:next.hWnd,error in:next.error out" outputs="process ID:owner.process ID,thread ID:,error out:owner.error out" />
    <Node _name="Equal?" uid="mine" uid_parent="loop" inputs="x:owner.process ID,y:lpid.value" outputs="x = y?:mine.x = y?" />
    <Node _name="Not Equal?" uid="notpanel" uid_parent="loop" inputs="x:next.hWnd,y:lpanel.value" outputs="x != y?:notpanel.x != y?" />
    <Node _name="And" uid="cand" uid_parent="loop" inputs="x:mine.x = y?,y:notpanel.x != y?" outputs="x .and. y?:cand.x .and. y?" />
    <Structure _name="Case Structure" uid="cs" uid_parent="loop" selectin="cand.x .and. y?">
      <Tunnel _id="In1" uid="ci1" uid_parent="cs" inputs="value:next.hWnd" />
      <Tunnel _id="In2" uid="ci2" uid_parent="cs" inputs="value:owner.error out" />
      <CaseFrame selector="True" uid="ct" uid_parent="cs" selectout="" label="LabVIEW's own window - examine it">
        <Tunnel _id="In1" uid="ct1" uid_parent="ct" outputs="value:ct1.value" />
        <Tunnel _id="In2" uid="ct2" uid_parent="ct" outputs="value:ct2.value" />
        <Call uid="info" uid_parent="ct" target="RemoteVI Window Popup Info.vi" inputs="hWnd:ct1.value,error in:ct2.value" outputs="popup?:info.popup?,window:info.window,error out:info.error out" />
        <Tunnel _id="Out1" uid="cto1" uid_parent="ct" inputs="value:info.error out" />
        <Tunnel _id="Out2" uid="cto2" uid_parent="ct" inputs="value:info.popup?" />
        <Tunnel _id="Out3" uid="cto3" uid_parent="ct" inputs="value:info.window" />
      </CaseFrame>
      <CaseFrame selector="False" uid="cf" uid_parent="cs" selectout="" label="Another process or the panel">
        <Tunnel _id="In1" uid="cf1" uid_parent="cf" outputs="value:" />
        <Tunnel _id="In2" uid="cf2" uid_parent="cf" outputs="value:cf2.value" />
        <Tunnel _id="Out1" uid="cfo1" uid_parent="cf" inputs="value:cf2.value" />
        <Tunnel _id="Out2" uid="cfo2" uid_parent="cf" inputs="value:" />
        <Tunnel _id="Out3" uid="cfo3" uid_parent="cf" inputs="value:" />
      </CaseFrame>
      <Tunnel _id="Out1" uid="cerr" uid_parent="cs" outputs="value:cerr.value" />
      <Tunnel _id="Out2" uid="cpop" uid_parent="cs" cond="true" outputs="value:cpop.value" />
      <Tunnel _id="Out3" uid="cwin" uid_parent="cs" cond="true" outputs="value:cwin.value" />
    </Structure>
    <Node _name="Equal To 0?" uid="last" uid_parent="loop" inputs="x:next.hWnd" outputs="x = 0?:last.x = 0?" />
    <Node _name="Unbundle By Name" uid="est" uid_parent="loop" fields="status" inputs="input cluster:cerr.value" outputs="status:est.status" />
    <Node _name="Or" uid="stop" uid_parent="loop" inputs="x:last.x = 0?,y:est.status" outputs="x .or. y?:stop.x .or. y?" />
    <Condition uid="cond" uid_parent="loop" value="stop" inputs="value:stop.x .or. y?" />
    <Tunnel _id="Out1" uid="lpop" uid_parent="loop" mode="index" cond="cpop.value" inputs="value:cwin.value" outputs="value:lpop.value" />
  </Structure>
  <FreeLabel comment="Enumerates top-level windows - no callbacks" uid="cmt" uid_parent="root" />
</VI>
