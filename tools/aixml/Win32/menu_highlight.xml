<VI _name="RemoteVI Menu Highlight.vi" description="Finds the highlighted item of a LabVIEW menu window: captures hwnd (RemoteVI Capture Window.vi - PrintWindow\2C so it works on a menu that is invisible on the host) and looks down its middle column for pixels of the Windows highlight colour (RemoteVI System Color.vi\2C COLOR_HIGHLIGHT 13). LabVIEW paints the selected menu row in that colour across the whole row\2C with the item text in the highlight text colour on top (measured on LabVIEW 2025 ring\2C plot legend and shortcut menus)\2C so the first and the last matching row are the top and bottom of the highlighted item in window pixels. found? is FALSE when no row matches - a menu nothing is highlighted in yet\2C or a popup that is no menu (colour picker\2C line width popup) - or when the capture failed (the window closed). submenu? is TRUE when the highlighted item opens a submenu\3A inside the band (2 px in from its top and bottom)\2C the 18 columns that end 6 px before the right edge hold a pixel that is not the highlight colour - the submenu arrow\2C which LabVIEW draws there in the highlight text colour (measured on LabVIEW 2025 menu bar\2C shortcut and submenu menus\3A the band otherwise fills that strip\3B shortcut texts end further left). RemoteVI Hover Menus.vi presses VK_RIGHT for a hover dwell only then\2C because in a menu of the panels menu bar VK_RIGHT on an item without a submenu switches to the next menu bar menu (measured). menu colours? is TRUE when at least a quarter of that column has the menu background colour (COLOR_MENU 4) - every LabVIEW menu does\2C the colour picker does not (its background is 0xF7F7F7\2C measured)\3B RemoteVI Highlight Menu Row.vi posts no probe key into a window without it\2C because a key posted into the colour picker spoils its next mouse click (measured\3A the colour was not taken). Capture errors are dropped\3B error in passes through unchanged. Win32 only\2C no VI Server call.">
  <Control _name="hwnd" conIdx="0" connection="required" description="The menu window." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Passed through to error out." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant _name="no error" outputs="value:ke.value" type="cluster{bool.status,int32.code,string.source}" uid="ke" uid_parent="root" value="[false,0,]"/>
  <Call inputs="hwnd:hw.value,error in:ke.value" outputs="pixmap:cw.pixmap,rect:cw.rect,error out:" target="RemoteVI Capture Window.vi" uid="cw" uid_parent="root"/>
  <Constant _name="COLOR_HIGHLIGHT" outputs="value:k13.value" type="int32" uid="k13" uid_parent="root" value="13"/>
  <Constant _name="COLOR_MENU" outputs="value:k4.value" type="int32" uid="k4" uid_parent="root" value="4"/>
  <Call inputs="nIndex:k13.value" outputs="rgb:hc.rgb" target="RemoteVI System Color.vi" uid="hc" uid_parent="root"/>
  <Call inputs="nIndex:k4.value" outputs="rgb:mc.rgb" target="RemoteVI System Color.vi" uid="mc" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="w,h" inputs="input cluster:cw.rect" outputs="w:ru.w,h:ru.h" uid="ru" uid_parent="root"/>
  <Constant _name="2" outputs="value:k2.value" type="int32" uid="k2" uid_parent="root" value="2"/>
  <Node _name="Quotient &amp; Remainder" inputs="x:ru.w,y:k2.value" outputs="x-y*floor(x/y):,floor(x/y):mid.floor(x/y)" uid="mid" uid_parent="root"/>
  <Node _name="Index Array" dimensions="2" inputs="array:cw.pixmap,disabled index (row):,index (col):mid.floor(x/y)" outputs="element:col.element" uid="col" uid_parent="root"/>
  <Constant _name="RGB bits" outputs="value:kmask.value" type="uint32" uid="kmask" uid_parent="root" value="16777215"/>
  <Node _name="And" inputs="x:col.element,y:kmask.value" outputs="x .and. y?:msk.x .and. y?" uid="msk" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:msk.x .and. y?,y:hc.rgb" outputs="x = y?:hit.x = y?" uid="hit" uid_parent="root"/>
  <Constant outputs="value:kt.value" type="bool" uid="kt" uid_parent="root" value="true"/>
  <Node _name="Search 1D Array" inputs="1D array:hit.x = y?,element:kt.value" outputs="index of element:top.index of element" uid="top" uid_parent="root"/>
  <Node _name="Reverse 1D Array" inputs="array:hit.x = y?" outputs="reversed array:rev.reversed array" uid="rev" uid_parent="root"/>
  <Node _name="Search 1D Array" inputs="1D array:rev.reversed array,element:kt.value" outputs="index of element:rtop.index of element" uid="rtop" uid_parent="root"/>
  <Node _name="Array Size" inputs="array:hit.x = y?" outputs="size(s):n.size(s)" uid="n" uid_parent="root"/>
  <Node _name="Decrement" inputs="x:n.size(s)" outputs="x-1:nm1.x-1" uid="nm1" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:nm1.x-1,y:rtop.index of element" outputs="x-y:bot.x-y" uid="bot" uid_parent="root"/>
  <Node _name="Greater Or Equal To 0?" inputs="x:top.index of element" outputs="x &gt;= 0?:fnd.x &gt;= 0?" uid="fnd" uid_parent="root"/>
  <Node _name="Equal?" inputs="x:msk.x .and. y?,y:mc.rgb" outputs="x = y?:isbg.x = y?" uid="isbg" uid_parent="root"/>
  <Node _name="Boolean To (0\2C1)" inputs="Boolean:isbg.x = y?" outputs="0\2C 1:b01.0\2C 1" uid="b01" uid_parent="root"/>
  <Node _name="Add Array Elements" inputs="numeric array:b01.0\2C 1" outputs="sum:nbg.sum" uid="nbg" uid_parent="root"/>
  <Constant _name="4" outputs="value:k4b.value" type="int32" uid="k4b" uid_parent="root" value="4"/>
  <Node _name="Multiply" inputs="x:nbg.sum,y:k4b.value" outputs="x*y:nbg4.x*y" uid="nbg4" uid_parent="root"/>
  <Node _name="Greater Or Equal?" inputs="x:nbg4.x*y,y:n.size(s)" outputs="x &gt;= y?:quart.x &gt;= y?" uid="quart" uid_parent="root"/>
  <Node _name="Greater Than 0?" inputs="x:n.size(s)" outputs="x &gt; 0?:any.x &gt; 0?" uid="any" uid_parent="root"/>
  <Node _name="And" inputs="x:quart.x &gt;= y?,y:any.x &gt; 0?" outputs="x .and. y?:menuc.x .and. y?" uid="menuc" uid_parent="root"/>
  <Node _name="Add" inputs="x:top.index of element,y:k2.value" outputs="x+y:r0s.x+y" uid="r0s" uid_parent="root"/>
  <Node _name="Subtract" inputs="x:bot.x-y,y:top.index of element" outputs="x-y:bh.x-y" uid="bh" uid_parent="root"/>
  <Constant _name="3" outputs="value:k3.value" type="int32" uid="k3" uid_parent="root" value="3"/>
  <Node _name="Subtract" inputs="x:bh.x-y,y:k3.value" outputs="x-y:rlen.x-y" uid="rlen" uid_parent="root"/>
  <Constant _name="arrow strip from the right edge" outputs="value:k24.value" type="int32" uid="k24" uid_parent="root" value="24"/>
  <Node _name="Subtract" inputs="x:ru.w,y:k24.value" outputs="x-y:c0s.x-y" uid="c0s" uid_parent="root"/>
  <Constant _name="arrow strip width" outputs="value:k18.value" type="int32" uid="k18" uid_parent="root" value="18"/>
  <Node _name="Array Subset" dimensions="2" inputs="array:cw.pixmap,index:r0s.x+y,length:rlen.x-y,index:c0s.x-y,length:k18.value" outputs="subarray:strip.subarray" uid="strip" uid_parent="root"/>
  <Node _name="And" inputs="x:strip.subarray,y:kmask.value" outputs="x .and. y?:smsk.x .and. y?" uid="smsk" uid_parent="root"/>
  <Node _name="Not Equal?" inputs="x:smsk.x .and. y?,y:hc.rgb" outputs="x != y?:snh.x != y?" uid="snh" uid_parent="root"/>
  <Node _name="Or Array Elements" inputs="Boolean array:snh.x != y?" outputs="logical OR:sany.logical OR" uid="sany" uid_parent="root"/>
  <Node _name="And" inputs="x:fnd.x &gt;= 0?,y:sany.logical OR" outputs="x .and. y?:subm.x .and. y?" uid="subm" uid_parent="root"/>
  <FreeLabel comment="Highlight colour down the middle column" uid="lbl" uid_parent="root"/>
  <Indicator _name="found?" conIdx="4" connection="recommended" description="TRUE when a row of the menu is highlighted." inputs="value:fnd.x &gt;= 0?" type="bool" uid="o_f" uid_parent="root" value="false"/>
  <Indicator _name="top" conIdx="6" connection="recommended" description="First highlighted pixel row\2C window coordinates (-1 when none)." inputs="value:top.index of element" type="int32" uid="o_t" uid_parent="root" value="0"/>
  <Indicator _name="bottom" conIdx="8" connection="recommended" description="Last highlighted pixel row\2C window coordinates." inputs="value:bot.x-y" type="int32" uid="o_b" uid_parent="root" value="0"/>
  <Indicator _name="height" conIdx="10" connection="recommended" description="Height of the window in pixels." inputs="value:ru.h" type="int32" uid="o_h" uid_parent="root" value="0"/>
  <Indicator _name="menu colours?" conIdx="12" connection="recommended" description="TRUE when at least a quarter of the middle column has the menu background colour (COLOR_MENU) - the window looks like a LabVIEW menu." inputs="value:menuc.x .and. y?" type="bool" uid="o_m" uid_parent="root" value="false"/>
  <Indicator _name="submenu?" conIdx="14" connection="recommended" description="TRUE when the highlighted item shows a submenu arrow (FALSE when nothing is highlighted)." inputs="value:subm.x .and. y?" type="bool" uid="o_s" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in." inputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
