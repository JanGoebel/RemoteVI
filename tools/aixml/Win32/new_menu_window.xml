<VI _name="RemoteVI New Menu Window.vi" description="TRUE when a visible LabVIEW menu window (class LVMenuWnd) exists that is not in popup hWnds\3A walks the top-level LVMenuWnd windows with user32 FindWindowExW(0\2C previous\2C &quot;LVMenuWnd&quot;\2C NULL) and tests each with user32 IsWindowVisible\2C stopping at the first new one\2C the end of the list or an error. Cheap enough to poll every 5 ms. Win32 only.">
  <Control _name="popup hWnds" conIdx="0" connection="required" description="Window handles of the popups known already." outputs="value:ph.value" type="array{uint64}" uid="ph" uid_parent="root" value="[]"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="Standard error in." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Constant _name="LVMenuWnd as UTF-16 with terminating 0" outputs="value:kcls.value" type="array{uint16}" uid="kcls" uid_parent="root" value="[76,86,77,101,110,117,87,110,100,0]"/>
  <Constant _name="NULL title" outputs="value:knul.value" type="array{uint16}" uid="knul" uid_parent="root" value="[]"/>
  <Constant _name="desktop" outputs="value:kd.value" type="uint64" uid="kd" uid_parent="root" value="0"/>
  <Structure _name="While Loop" count="" label="Visible menu windows not in the list" uid="mw" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ph.value" outputs="value:m_ph.value" uid="m_ph" uid_parent="mw"/>
    <Tunnel _id="In2" inputs="value:kcls.value" outputs="value:m_cls.value" uid="m_cls" uid_parent="mw"/>
    <Tunnel _id="In3" inputs="value:knul.value" outputs="value:m_nul.value" uid="m_nul" uid_parent="mw"/>
    <Tunnel _id="In4" inputs="value:kd.value" outputs="value:m_d.value" uid="m_d" uid_parent="mw"/>
    <ShiftReg uid="srh" uid_parent="mw">
      <Left inputs="value:kd.value" outputs="value:m_prev.value" uid="srhl" uid_parent="srh"/>
      <Right inputs="value:fw.hWnd" outputs="value:" uid="srhr" uid_parent="srh"/>
    </ShiftReg>
    <ShiftReg uid="srm" uid_parent="mw">
      <Left inputs="value:ei.value" outputs="value:m_e.value" uid="srml" uid_parent="srm"/>
      <Right inputs="value:mv.error out" outputs="value:mw_err.value" uid="srmr" uid_parent="srm"/>
    </ShiftReg>
    <Call inputs="hWndParent:m_d.value,hWndChildAfter:m_prev.value,lpszClass:m_cls.value,lpszWindow:m_nul.value,error in:m_e.value" outputs="hWnd:fw.hWnd,error out:fw.error out" target="user32 FindWindowExW.vi" uid="fw" uid_parent="mw"/>
    <Call inputs="hWnd:fw.hWnd,error in:fw.error out" outputs="visible?:mv.visible?,error out:mv.error out" target="user32 IsWindowVisible.vi" uid="mv" uid_parent="mw"/>
    <Node _name="Search 1D Array" inputs="1D array:m_ph.value,element:fw.hWnd" outputs="index of element:ms.index of element" uid="ms" uid_parent="mw"/>
    <Node _name="Less Than 0?" inputs="x:ms.index of element" outputs="x &lt; 0?:mnot.x &lt; 0?" uid="mnot" uid_parent="mw"/>
    <Node _name="And" inputs="x:mv.visible?,y:mnot.x &lt; 0?" outputs="x .and. y?:mnew.x .and. y?" uid="mnew" uid_parent="mw"/>
    <Node _name="Equal To 0?" inputs="x:fw.hWnd" outputs="x = 0?:mend.x = 0?" uid="mend" uid_parent="mw"/>
    <Node _name="Unbundle By Name" fields="status" inputs="input cluster:mv.error out" outputs="status:mes.status" uid="mes" uid_parent="mw"/>
    <Node _name="Or" inputs="x:mend.x = 0?,y:mes.status" outputs="x .or. y?:m1.x .or. y?" uid="m1" uid_parent="mw"/>
    <Node _name="Or" inputs="x:m1.x .or. y?,y:mnew.x .and. y?" outputs="x .or. y?:mstop.x .or. y?" uid="mstop" uid_parent="mw"/>
    <Condition inputs="value:mstop.x .or. y?" uid="mwc" uid_parent="mw" value="stop"/>
    <Tunnel _id="Out1" inputs="value:mnew.x .and. y?" outputs="value:anynew.value" uid="anynew" uid_parent="mw"/>
  </Structure>
  <Indicator _name="new menu?" conIdx="4" connection="recommended" description="TRUE when a new visible LVMenuWnd was found." inputs="value:anynew.value" type="bool" uid="o_new" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in or a Call Library Function Node error." inputs="value:mw_err.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
