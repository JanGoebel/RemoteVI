<VI _name="RemoteVI Wait Popups Change.vi" description="Waits until the LabVIEW popups differ from popup hWnds - one of them closed (no longer visible) or a new LabVIEW menu window (class LVMenuWnd) became visible - or until timeout ms have passed. Polls every 5 ms with cheap Win32 calls only\3A IsWindowVisible on each of popup hWnds and FindWindowExW(0\2C previous\2C &quot;LVMenuWnd&quot;\2C NULL) over the menu windows (a full RemoteVI Find Popups.vi pass walks every top-level window and takes about 30 ms - too slow to give the cursor back promptly). A new popup of another class (graph palette\2C drop-down) is only noticed when an old one closes or by the timeout. Used by RemoteVI Post Input.vi after a click on a popup\2C to give the host cursor back as soon as LabVIEW has handled the click. No VI Server call\2C so it works while an open popup blocks LabVIEW's UI thread.">
  <FreeLabel comment="Poll the popups until they change" uid="lbl" uid_parent="root"/>
  <Control _name="panel hWnd" conIdx="0" connection="recommended" description="The served front panel's window (not used for the cheap poll\3B kept for the caller's convenience)." outputs="value:hw.value" type="uint64" uid="hw" uid_parent="root" value="0"/>
  <Control _name="popup hWnds" conIdx="5" connection="required" description="Window handles of the popups before the click (RemoteVI Find Popups.vi without SysShadow)." outputs="value:ph.value" type="array{uint64}" uid="ph" uid_parent="root" value="[]"/>
  <Control _name="timeout ms" conIdx="7" connection="recommended" description="Longest wait in milliseconds." outputs="value:tmo.value" type="uint32" uid="tmo" uid_parent="root" value="300"/>
  <Control _name="error in" conIdx="11" connection="recommended" description="When this carries an error the VI returns at once." outputs="value:ei.value" type="cluster{bool.status,int32.code,string.source}" uid="ei" uid_parent="root" value="[false,0,]"/>
  <Node _name="Tick Count (ms)" outputs="millisecond timer value:t0.millisecond timer value" uid="t0" uid_parent="root"/>
  <Constant _name="LVMenuWnd as UTF-16 with terminating 0" outputs="value:kcls.value" type="array{uint16}" uid="kcls" uid_parent="root" value="[76,86,77,101,110,117,87,110,100,0]"/>
  <Constant _name="NULL title" outputs="value:knul.value" type="array{uint16}" uid="knul" uid_parent="root" value="[]"/>
  <Constant _name="desktop" outputs="value:kd.value" type="uint64" uid="kd" uid_parent="root" value="0"/>
  <Constant _name="poll 5 ms" outputs="value:k5.value" type="uint32" uid="k5" uid_parent="root" value="5"/>
  <Structure _name="While Loop" count="" label="Poll every 5 ms" uid="wl" uid_parent="root">
    <Tunnel _id="In1" inputs="value:ph.value" outputs="value:l_ph.value" uid="l_ph" uid_parent="wl"/>
    <Tunnel _id="In2" inputs="value:tmo.value" outputs="value:l_max.value" uid="l_max" uid_parent="wl"/>
    <Tunnel _id="In3" inputs="value:t0.millisecond timer value" outputs="value:l_t0.value" uid="l_t0" uid_parent="wl"/>
    <Tunnel _id="In4" inputs="value:kcls.value" outputs="value:l_cls.value" uid="l_cls" uid_parent="wl"/>
    <Tunnel _id="In5" inputs="value:knul.value" outputs="value:l_nul.value" uid="l_nul" uid_parent="wl"/>
    <Tunnel _id="In6" inputs="value:kd.value" outputs="value:l_d.value" uid="l_d" uid_parent="wl"/>
    <Tunnel _id="In7" inputs="value:k5.value" outputs="value:l_k5.value" uid="l_k5" uid_parent="wl"/>
    <ShiftReg uid="sre" uid_parent="wl">
      <Left inputs="value:ei.value" outputs="value:le.value" uid="srel" uid_parent="sre"/>
      <Right inputs="value:mw_err.value" outputs="value:le_end.value" uid="srer" uid_parent="sre"/>
    </ShiftReg>
    <Node _name="Wait (ms)" inputs="milliseconds to wait:l_k5.value" outputs="millisecond timer value:wt.millisecond timer value" uid="wt" uid_parent="wl"/>
    <Structure _name="For Loop" count="" label="Is each popup still visible?" maxin="" maxout="" uid="fv" uid_parent="wl">
      <Tunnel _id="In1" inputs="value:l_ph.value" mode="index" outputs="value:v_h.value" uid="v_h" uid_parent="fv"/>
      <ShiftReg uid="srv" uid_parent="fv">
        <Left inputs="value:le.value" outputs="value:v_e.value" uid="srvl" uid_parent="srv"/>
        <Right inputs="value:vis.error out" outputs="value:v_e_end.value" uid="srvr" uid_parent="srv"/>
      </ShiftReg>
      <Call inputs="hWnd:v_h.value,error in:v_e.value" outputs="visible?:vis.visible?,error out:vis.error out" target="user32 IsWindowVisible.vi" uid="vis" uid_parent="fv"/>
      <Node _name="Not" inputs="x:vis.visible?" outputs=".not. x?:gone..not. x?" uid="gone" uid_parent="fv"/>
      <Tunnel _id="Out1" inputs="value:gone..not. x?" mode="index" outputs="value:gonea.value" uid="gonea" uid_parent="fv"/>
    </Structure>
    <Node _name="Or Array Elements" inputs="Boolean array:gonea.value" outputs="logical OR:anygone.logical OR" uid="anygone" uid_parent="wl"/>
    <Structure _name="While Loop" count="" label="Visible menu windows not in the list" uid="mw" uid_parent="wl">
      <Tunnel _id="In1" inputs="value:l_ph.value" outputs="value:m_ph.value" uid="m_ph" uid_parent="mw"/>
      <Tunnel _id="In2" inputs="value:l_cls.value" outputs="value:m_cls.value" uid="m_cls" uid_parent="mw"/>
      <Tunnel _id="In3" inputs="value:l_nul.value" outputs="value:m_nul.value" uid="m_nul" uid_parent="mw"/>
      <Tunnel _id="In4" inputs="value:l_d.value" outputs="value:m_d.value" uid="m_d" uid_parent="mw"/>
      <ShiftReg uid="srh" uid_parent="mw">
        <Left inputs="value:l_d.value" outputs="value:m_prev.value" uid="srhl" uid_parent="srh"/>
        <Right inputs="value:fw.hWnd" outputs="value:" uid="srhr" uid_parent="srh"/>
      </ShiftReg>
      <ShiftReg uid="srm" uid_parent="mw">
        <Left inputs="value:v_e_end.value" outputs="value:m_e.value" uid="srml" uid_parent="srm"/>
        <Right inputs="value:mv.error out" outputs="value:mw_err.value" uid="srmr" uid_parent="srm"/>
      </ShiftReg>
      <Call inputs="hWndParent:m_d.value,hWndChildAfter:m_prev.value,lpszClass:m_cls.value,lpszWindow:m_nul.value,error in:m_e.value" outputs="hWnd:fw.hWnd,error out:fw.error out" target="user32 FindWindowExW.vi" uid="fw" uid_parent="mw"/>
      <Call inputs="hWnd:fw.hWnd,error in:fw.error out" outputs="visible?:mv.visible?,error out:mv.error out" target="user32 IsWindowVisible.vi" uid="mv" uid_parent="mw"/>
      <Node _name="Search 1D Array" inputs="1D array:m_ph.value,element:fw.hWnd" outputs="index of element:ms.index of element" uid="ms" uid_parent="mw"/>
      <Node _name="Less Than 0?" inputs="x:ms.index of element" outputs="x &lt; 0?:mnot.x &lt; 0?" uid="mnot" uid_parent="mw"/>
      <Node _name="And" inputs="x:mv.visible?,y:mnot.x &lt; 0?" outputs="x .and. y?:mnew.x .and. y?" uid="mnew" uid_parent="mw"/>
      <Node _name="Equal To 0?" inputs="x:fw.hWnd" outputs="x = 0?:mend.x = 0?" uid="mend" uid_parent="mw"/>
      <Node _name="Unbundle By Name" fields="status" inputs="input cluster:mv.error out" outputs="status:mes.status" uid="mes" uid_parent="mw"/>
      <Node _name="Or" inputs="x:mend.x = 0?,y:mes.status" outputs="x .or. y?:m1.x .or. y?" uid="m1" uid_parent="mw"/>
      <Node _name="Or" inputs="x:m1.x .or. y?,y:mnew.x .and. y?" outputs="x .or. y?:mstop.x .or. y?" uid="mstop" uid_parent="mw"/>
      <Condition inputs="value:mstop.x .or. y?" uid="mwc" uid_parent="mw" value="stop"/>
      <Tunnel _id="Out1" inputs="value:mnew.x .and. y?" outputs="value:anynew.value" uid="anynew" uid_parent="mw"/>
    </Structure>
    <Node _name="Or" inputs="x:anygone.logical OR,y:anynew.value" outputs="x .or. y?:chg.x .or. y?" uid="chg" uid_parent="wl"/>
    <Node _name="Subtract" inputs="x:wt.millisecond timer value,y:l_t0.value" outputs="x-y:el.x-y" uid="el" uid_parent="wl"/>
    <Node _name="Greater Or Equal?" inputs="x:el.x-y,y:l_max.value" outputs="x &gt;= y?:tout.x &gt;= y?" uid="tout" uid_parent="wl"/>
    <Node _name="Unbundle By Name" fields="status" inputs="input cluster:mw_err.value" outputs="status:es.status" uid="es" uid_parent="wl"/>
    <Node _name="Or" inputs="x:chg.x .or. y?,y:tout.x &gt;= y?" outputs="x .or. y?:s1.x .or. y?" uid="s1" uid_parent="wl"/>
    <Node _name="Or" inputs="x:s1.x .or. y?,y:es.status" outputs="x .or. y?:stop.x .or. y?" uid="stop" uid_parent="wl"/>
    <Condition inputs="value:stop.x .or. y?" uid="wlc" uid_parent="wl" value="stop"/>
    <Tunnel _id="Out1" inputs="value:chg.x .or. y?" outputs="value:wchg.value" uid="wchg" uid_parent="wl"/>
  </Structure>
  <Indicator _name="changed?" conIdx="4" connection="recommended" description="TRUE when the popups changed\2C FALSE after a timeout or an error." inputs="value:wchg.value" type="bool" uid="ochg" uid_parent="root" value="false"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in or a Call Library Function Node error." inputs="value:le_end.value" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]"/>
</VI>
