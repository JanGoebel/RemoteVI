<VI _name="FP Close Path.vi" description="Dev helper: closes the front panel of the VI at path (Front Panel Window:Open = FALSE).">
  <Control _name="path" type="path" uid="p" uid_parent="root" value="" outputs="value:p.value"/>
  <Constant outputs="value:f.value" type="bool" uid="f" uid_parent="root" value="false"/>
  <Node _name="Open VI Reference" inputs="vi path:p.value" outputs="vi reference:ov.vi reference,error out:ov.error out" uid="ov" uid_parent="root"/>
  <Node _name="Property Node" fields="write+Front Panel Window\3AOpen" inputs="reference:ov.vi reference,error in (no error):ov.error out,Front Panel Window\3AOpen:f.value" outputs="reference out:pn.reference out,error out:pn.error out" type="{LV.VI}" uid="pn" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:pn.reference out,error in (no error):pn.error out" outputs="error out:cr.error out" uid="cr" uid_parent="root"/>
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="eo" uid_parent="root" value="[false,0,]" inputs="value:cr.error out"/>
</VI>
